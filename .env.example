# Wiekko environment configuration
# Copy this file to .env and adjust values as needed.
# .env is loaded automatically by the Justfile and is git-ignored.

# WIEKKO_HOST=localhost
# WIEKKO_PORT=8080
# WIEKKO_DB_DRIVER=sqlite
# WIEKKO_DB_DSN=wiekko.db

# Address users open Wiekko at; used for invitation links. Unset: taken from
# the request. Required when mail is enabled (the links in emails use it).
# WIEKKO_PUBLIC_URL=https://wiekko.example.com

# Reverse proxies whose X-Forwarded-For header is believed when determining a
# client's address (for the login limits). Comma-separated addresses and CIDR
# ranges; "none" trusts no proxy. Default: loopback and private networks.
# WIEKKO_TRUSTED_PROXIES=10.0.0.2

# Mail for invitations and password resets (optional). Unset
# WIEKKO_MAIL_TRANSPORT: no mail; invitations are links only and passwords are
# reset by an administrator. Transports: smtp, mailgun, sendgrid, mailpace,
# scaleway, lettermint. Read from the environment only (no flags).
# WIEKKO_MAIL_TRANSPORT=smtp
# WIEKKO_MAIL_FROM="Wiekko <wiekko@example.com>"
# WIEKKO_MAIL_MAX_PER_HOUR=100
#
# SMTP relay. WIEKKO_SMTP_TLS: starttls (default, port 587), tls (port 465) or
# none (local relay without credentials only).
# WIEKKO_SMTP_HOST=smtp.example.com
# WIEKKO_SMTP_PORT=587
# WIEKKO_SMTP_TLS=starttls
# WIEKKO_SMTP_USERNAME=
# WIEKKO_SMTP_PASSWORD=
#
# Mailer APIs: the key or token of the chosen service, plus, for Mailgun and
# Scaleway, where to send.
# WIEKKO_MAIL_API_KEY=
# WIEKKO_MAILGUN_DOMAIN=mg.example.com
# WIEKKO_MAILGUN_REGION=eu
# WIEKKO_SCALEWAY_PROJECT_ID=
# WIEKKO_SCALEWAY_REGION=fr-par

# Wiekko initial admin username and password - optional
# If not provided, a random password will be generated on first launch
# and written to the log.
# WIEKKO_ADMIN_USER="admin"
# WIEKKO_ADMIN_PASSWORD="REPLACE_WITH_SECURE_PASSWORD"

# Wiekko dev mode enables the component catalogue at /dev/catalogue.
#
# It also seeds two demo products ("Aviary", "Finch Tracker") and three demo
# accounts (ada/viewer, bo/tester, cy/developer, all with the password
# "devpassword") — but only into a database that was just created. Delete the
# database file and restart to reset to that state. Never set this in
# production: the demo accounts are real accounts with a published password.
# WIEKKO_DEV_MODE=1

# Attachment storage. Uploaded files are written under this directory, which
# must live on a persistent volume in production (as the sqlite DB does).
# WIEKKO_UPLOAD_DIR=./uploads
# WIEKKO_MAX_UPLOAD_BYTES=10485760
#
# Restrict which file types may be uploaded. Comma-separated list of presets
# and/or extensions. Unset (the default) accepts any file type, which suits
# private instances; public instances with untrusted testers will want a list.
#   presets: images (png/jpg/jpeg/gif/webp)
#            logs   (txt/log/json/xml/csv/md/yaml/yml)
#            documents (pdf)
# The extension is checked against the file's actual leading bytes, so a
# renamed archive, PDF or media file is rejected. Note that Go's content
# sniffer has no signature for ELF or PE executables, so a renamed binary can
# still pass as a .log file. Uploads are always served as downloads with
# nosniff, so this limits unwanted file classes rather than replacing malware
# scanning.
# WIEKKO_ALLOWED_UPLOAD_TYPES=images,logs

# Encryption key for personal data (GDPR). Required — no default.
# JSON array of key objects. First key is active for encryption; all keys are used for decryption.
# Generate a 32-byte key: openssl rand -base64 32
# Example:
WIEKKO_ENCRYPTION_KEY='[{"id":"1","key":"REPLACE_WITH_BASE64_32_BYTE_KEY"}]'
