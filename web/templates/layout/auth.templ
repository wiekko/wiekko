package templates

import "nexmap.net/web/templates"

// AuthLayout renders the unauthenticated page layout (login, register, accept-invite).
// A centered card on a neutral background.
templ AuthLayout(meta templates.PageMeta) {
	@Base(meta) {
		<div class="flex min-h-full items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
			<div class="w-full max-w-md space-y-8">
				<!-- Logo -->
				<div class="flex flex-col items-center">
					<img src="/static/img/logo.svg" alt="Nexmap" class="h-12 w-auto"/>
					if meta.Title != "" {
						<h2 class="mt-6 text-center text-2xl font-bold tracking-tight text-gray-900">
							{ meta.Title }
						</h2>
					}
				</div>
				<!-- Card -->
				<div class="rounded-lg bg-white px-6 py-8 shadow ring-1 ring-gray-200 sm:px-10">
					{ children... }
				</div>
			</div>
		</div>
	}
}
