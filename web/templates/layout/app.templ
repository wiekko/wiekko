package templates

import (
	"nexmap.net/web/templates"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// AppLayoutProps holds the data needed by the app layout.
type AppLayoutProps struct {
	Meta          templates.PageMeta
	DisplayName   string
	IsAdmin       bool
	ActiveSection string
	ProductID     string
	ProductName   string
	WorkflowMode  string
}

// AppLayout renders the authenticated app shell: header + sidebar + content + toast container.
// On mobile (<md) the sidebar is hidden behind a hamburger toggle; on desktop (md+) it is always visible.
templ AppLayout(props AppLayoutProps) {
	@Base(props.Meta) {
		<div
			id="app-shell"
			class="flex h-full flex-col"
			if props.Meta.CSRFToken != "" {
				hx-headers={ `{"X-CSRF-Token":"` + props.Meta.CSRFToken + `"}` }
			}
		>
			<!-- Full-width header -->
			@patterns.AppHeader(props.DisplayName, props.Meta.CSRFToken, props.ProductID, props.ProductName, props.ActiveSection, props.IsAdmin)
			<!-- Content area: sidebar + main -->
			<div class="flex flex-1 overflow-hidden">
				<!-- Mobile sidebar backdrop -->
				<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-gray-900/50" onclick="closeSidebar()"></div>
				<!-- Sidebar: hidden on mobile, always visible on md+ -->
				<div id="sidebar" class="fixed inset-y-0 left-0 z-40 -translate-x-full transition-transform duration-200 ease-in-out md:static md:translate-x-0">
					@patterns.SidebarNav(props.ActiveSection, props.ProductID, props.ProductName, props.WorkflowMode, props.IsAdmin)
				</div>
				<!-- Main content -->
				<main id="main-content" class="flex-1 overflow-y-auto scrollbar-thin p-6">
					{ children... }
				</main>
			</div>
		</div>
		<!-- Toast container -->
		@ui.ToastContainer()
		<!-- Modal container -->
		@ui.ModalContainer()
		@sidebarScript()
		<script src="/static/js/product-switcher.js" defer></script>
	}
}

templ sidebarScript() {
	<script>
		function openSidebar() {
			document.getElementById('sidebar').classList.remove('-translate-x-full');
			document.getElementById('sidebar-backdrop').classList.remove('hidden');
		}
		function closeSidebar() {
			document.getElementById('sidebar').classList.add('-translate-x-full');
			document.getElementById('sidebar-backdrop').classList.add('hidden');
		}
	</script>
}
