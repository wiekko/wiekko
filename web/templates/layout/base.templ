package templates

import "nexmap.net/web/templates"

// Base renders the HTML shell that loads CSS, fonts, and htmx.
// All pages wrap their content with this layout.
templ Base(meta templates.PageMeta) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-gray-50 dark:bg-gray-950">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>
				if meta.Title != "" {
					{ meta.Title } — Nexmap
				} else {
					Nexmap
				}
			</title>
			<link rel="icon" type="image/svg+xml" href="/static/img/logo-icon.svg"/>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<link rel="preload" href="/static/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/fonts/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin/>
			<script>
				(function() {
					var t = localStorage.getItem('theme');
					if (t === 'dark' || (!t || t === 'system') && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					}
				})();
			</script>
		</head>
		<body class="h-full font-sans text-gray-900 dark:text-gray-100 antialiased">
			{ children... }
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/htmx-errors.js" defer></script>
			<script src="/static/js/modal.js" defer></script>
			<script src="/static/js/sortable.min.js" defer></script>
			<script src="/static/js/board.js" defer></script>
		</body>
	</html>
}
