package patterns

import (
	"fmt"

	"nexmap.net/web/templates/ui"
)

// DeleteTrigger renders a danger button that opens a confirmation modal.
// hxDelete is the DELETE endpoint; /delete/confirm is appended for the modal.
templ DeleteTrigger(hxDelete, csrfToken string) {
	<button
		type="button"
		class="inline-flex items-center gap-2 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
		hx-get={ hxDelete + "/delete/confirm" }
		hx-target="#modal"
		hx-swap="innerHTML"
	>
		@ui.Icon("trash", "sm")
		Delete
	</button>
}

// DeleteConfirmation renders the confirmation modal content for a delete action.
// entityTitle is the user-visible name/title of the specific entity (may be empty
// to fall back to generic copy).
templ DeleteConfirmation(entityKind, entityTitle, hxDelete, csrfToken string) {
	@ui.ConfirmDialog(
		"delete-confirm",
		"Delete "+entityKind,
		deleteConfirmMessage(entityKind, entityTitle),
		"Delete",
		string(ui.ConfirmDanger),
		"delete",
		hxDelete,
		csrfToken,
	)
}

func deleteConfirmMessage(entityKind, entityTitle string) string {
	if entityTitle == "" {
		return "Are you sure you want to delete this " + entityKind + "? This action cannot be undone."
	}
	return "Are you sure you want to delete " + entityKind + " “" + entityTitle + "”? This action cannot be undone."
}

// ChildItem names one item below a requirement or task in its delete
// confirmation.
type ChildItem struct {
	Identifier string
	Title      string
}

// maxListedChildren caps how many children the confirmation lists by name.
const maxListedChildren = 5

// DeleteWithChildrenConfirmation is DeleteConfirmation for an item that may
// have items below it. With children it asks what happens to them: moved up
// to keepTarget (the default) or deleted along with the item. The choice goes
// to the DELETE request as ?children=keep|delete.
templ DeleteWithChildrenConfirmation(entityKind, entityTitle, hxDelete, csrfToken string, children []ChildItem, keepTarget string) {
	if len(children) == 0 {
		@DeleteConfirmation(entityKind, entityTitle, hxDelete, csrfToken)
	} else {
		@ui.Modal("delete-confirm", "Delete "+entityKind, "md") {
			<p class="text-sm text-gray-500 dark:text-gray-400">{ deleteConfirmMessage(entityKind, entityTitle) }</p>
			<p class="mt-3 text-sm font-medium text-gray-700 dark:text-gray-300">{ childCountText(len(children)) }</p>
			<ul class="mt-1 list-disc pl-5 text-sm text-gray-600 dark:text-gray-400">
				for i, c := range children {
					if i < maxListedChildren {
						<li><span class="font-mono text-xs">{ c.Identifier }</span> { c.Title }</li>
					}
				}
				if len(children) > maxListedChildren {
					<li>{ fmt.Sprintf("and %d more", len(children)-maxListedChildren) }</li>
				}
			</ul>
			<fieldset id="delete-children-choice" class="mt-4 space-y-2">
				<legend class="sr-only">What happens to them</legend>
				<label class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
					<input type="radio" name="children" value="keep" checked class="mt-0.5 h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"/>
					<span>Keep them and move them up to { keepTarget }</span>
				</label>
				<label class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
					<input type="radio" name="children" value="delete" class="mt-0.5 h-4 w-4 border-gray-300 text-red-600 focus:ring-red-500 dark:border-gray-600 dark:bg-gray-900"/>
					<span>Delete them too, with their comments and attachments</span>
				</label>
			</fieldset>
			<div class="mt-4 flex justify-end gap-3">
				@ui.ModalCancelButton("delete-confirm")
				<button
					type="button"
					class={ ui.ConfirmButtonClass(ui.ConfirmDanger) }
					data-confirm-action
					hx-delete={ hxDelete }
					hx-include="#delete-children-choice"
					if csrfToken != "" {
						hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` }
					}
					hx-target="#delete-confirm"
					hx-swap="delete"
				>
					Delete
				</button>
			</div>
		}
	}
}

func childCountText(n int) string {
	if n == 1 {
		return "It has 1 item below it:"
	}
	return fmt.Sprintf("It has %d items below it:", n)
}
