package patterns

import "nexmap.net/web/templates/ui"

// DeleteTrigger renders a danger button that opens a confirmation modal.
templ DeleteTrigger(hxDelete, csrfToken string) {
	<button
		type="button"
		class="inline-flex items-center gap-2 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
		hx-get={ hxDelete + "/confirm" }
		hx-target="#modal"
		hx-swap="innerHTML"
	>
		@ui.Icon("trash", "sm")
		Delete
	</button>
}

// DeleteConfirmation renders the confirmation modal content for a delete action.
// entityTitle is the user-visible name/title of the specific entity (may be empty
// to fall back to generic copy).
templ DeleteConfirmation(entityKind, entityTitle, hxDelete string) {
	@ui.ConfirmDialog(
		"delete-confirm",
		"Delete "+entityKind,
		deleteConfirmMessage(entityKind, entityTitle),
		"Delete",
		"danger",
		"delete",
		hxDelete,
	)
}

func deleteConfirmMessage(entityKind, entityTitle string) string {
	if entityTitle == "" {
		return "Are you sure you want to delete this " + entityKind + "? This action cannot be undone."
	}
	return "Are you sure you want to delete " + entityKind + " “" + entityTitle + "”? This action cannot be undone."
}
