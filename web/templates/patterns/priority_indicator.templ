package patterns

import (
	"fmt"
	"wiekko.net/web/templates/ui"
)

// PriorityBadge renders a color-coded priority indicator.
// 1=critical (red), 2=high (amber), 3=medium (yellow), 4=low (blue), 5+=info (gray).
// 0 or less means no priority is set (DF-2) and renders a muted dash, the
// way unset fields look elsewhere.
templ PriorityBadge(priority int) {
	if priority > 0 {
		@ui.Badge(fmt.Sprintf("P%d", priority), priorityColor(priority))
	} else {
		<span class="text-gray-400 dark:text-gray-500" title="No priority">—</span>
	}
}

// RoleBadge renders a badge for a user's product role.
templ RoleBadge(role string) {
	@ui.Badge(role, roleColor(role))
}

func priorityColor(p int) string {
	switch p {
	case 1:
		return "red"
	case 2:
		return "amber"
	case 3:
		return "yellow"
	case 4:
		return "blue"
	default:
		return "gray"
	}
}

func roleColor(r string) string {
	switch r {
	case "owner":
		return "indigo"
	case "developer":
		return "blue"
	case "tester":
		return "green"
	case "viewer":
		return "gray"
	default:
		return "gray"
	}
}
