package patterns

import (
	"nexmap.net/web/templates"
	"nexmap.net/web/templates/ui"
)

// CommentList renders a comment thread with an add form.
//
// The #comments wrapper is rendered unconditionally: CommentForm swaps into it
// with hx-swap="beforeend", so hiding it behind the non-empty branch would
// break the very first comment posted on an entity.
templ CommentList(comments []templates.CommentView, hxPost, csrfToken string, canComment bool) {
	<div class="space-y-4">
		<div id="comments-empty">
			if len(comments) == 0 {
				@CommentsEmptyState()
			}
		</div>
		<div id="comments" class="space-y-4">
			for _, c := range comments {
				@CommentItem(c, csrfToken)
			}
		</div>
		if canComment {
			<div class="space-y-2 border-t border-gray-200 pt-4 dark:border-gray-700">
				@ErrorRegion(CommentsErrorRegion)
				@CommentForm(hxPost, csrfToken)
			</div>
		}
	</div>
}

templ CommentsEmptyState() {
	@ui.EmptyState("message-circle", "No comments yet", "Start the conversation by adding a comment.", "", "")
}

// CommentCreated is the response to a new comment: the rendered comment plus an
// out-of-band clear of the empty state.
templ CommentCreated(c templates.CommentView, csrfToken string) {
	@CommentItem(c, csrfToken)
	<div id="comments-empty" hx-swap-oob="innerHTML"></div>
	@ClearedErrorRegion(CommentsErrorRegion)
}

// CommentsEmptied restores the empty state after the last comment is deleted.
templ CommentsEmptied() {
	<div id="comments-empty" hx-swap-oob="innerHTML">
		@CommentsEmptyState()
	</div>
}

// CommentItem renders a single comment. Exported because creating a comment
// returns exactly one of these as the htmx swap payload.
templ CommentItem(c templates.CommentView, csrfToken string) {
	<div class="flex gap-3" id={ "comment-" + c.ID }>
		@ui.UserAvatar(c.AuthorName, "md")
		<div class="flex-1">
			<div class="flex items-center gap-2">
				<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ c.AuthorName }</span>
				<span class="text-xs text-gray-500 dark:text-gray-400">{ c.CreatedAt }</span>
				if c.CanDelete {
					<button
						type="button"
						aria-label="Delete comment"
						class="ml-auto rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
						hx-delete={ c.DeleteURL }
						hx-vals={ csrfVals(csrfToken) }
						hx-target={ "#comment-" + c.ID }
						hx-swap="outerHTML"
						hx-confirm="Delete this comment?"
					>
						@ui.Icon("trash", "sm")
					</button>
				}
			</div>
			<div class="prose prose-sm dark:prose-invert mt-1 max-w-none">
				@templ.Raw(templates.RenderMarkdown(c.Body))
			</div>
		</div>
	</div>
}

// CommentForm renders a new comment form using htmx. See UploadForm for how
// rejections are reported; the header guard matters more here, since resetting
// on failure would discard whatever the user had typed.
templ CommentForm(hxPost, csrfToken string) {
	<form
		hx-post={ hxPost }
		hx-target="#comments"
		hx-swap="beforeend"
		hx-on::after-request="if (!event.detail.xhr.getResponseHeader('HX-Nexmap-Error')) this.reset()"
		class="flex gap-3"
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<div class="flex-1">
			<textarea
				name="body"
				rows="2"
				placeholder="Add a comment..."
				required
				class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
			></textarea>
		</div>
		@ui.Button(ui.ButtonProps{
			Label:   "Comment",
			Variant: "primary",
			Size:    "sm",
			Type:    "submit",
		})
	</form>
}
