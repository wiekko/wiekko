package patterns

import "nexmap.net/web/templates/ui"

// FormGroup wraps a form field with a label and optional help text.
// The actual input is provided as children.
templ FormGroup(label, helpText string) {
	<div class="space-y-1">
		if label != "" {
			<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">{ label }</label>
		}
		{ children... }
		if helpText != "" {
			<p class="text-sm text-gray-500 dark:text-gray-400">{ helpText }</p>
		}
	</div>
}

// FormActions renders submit and cancel buttons at the bottom of a form.
templ FormActions(submitLabel, cancelHref string) {
	<div class="flex items-center justify-end gap-3 pt-4">
		if cancelHref != "" {
			@ui.LinkButton(cancelHref, "Cancel", "secondary", "md")
		}
		@ui.Button(ui.ButtonProps{
			Label:   submitLabel,
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
	</div>
}

// FormError renders a top-of-form error banner.
templ FormError(message string) {
	if message != "" {
		<div class="rounded-md bg-red-50 p-4 dark:bg-red-900/30">
			<div class="flex items-center gap-3">
				<div class="shrink-0 text-red-500">
					@ui.Icon("alert-triangle", "md")
				</div>
				<p class="text-sm text-red-700 dark:text-red-400">{ message }</p>
			</div>
		</div>
	}
}

// ErrorRegion renders an always-present container that an htmx response can
// fill out of band. Render it once next to a form; the server then targets it
// with InlineError or clears it with ClearedErrorRegion.
templ ErrorRegion(regionID string) {
	<div id={ regionID }></div>
}

// InlineError fills an ErrorRegion out of band, reusing FormError's styling so
// htmx-driven failures look like every other form error in the app.
templ InlineError(regionID, message string) {
	<div id={ regionID } hx-swap-oob="innerHTML">
		@FormError(message)
	</div>
}

// ClearedErrorRegion empties an ErrorRegion out of band, so a previous failure
// disappears as soon as the next attempt succeeds.
templ ClearedErrorRegion(regionID string) {
	<div id={ regionID } hx-swap-oob="innerHTML"></div>
}

// FormSection groups related form fields with a heading.
templ FormSection(title, description string) {
	<div class="border-b border-gray-200 pb-6 dark:border-gray-700">
		<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">{ title }</h3>
		if description != "" {
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ description }</p>
		}
		<div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
			{ children... }
		</div>
	</div>
}
