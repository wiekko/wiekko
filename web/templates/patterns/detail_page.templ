package patterns

import (
	"nexmap.net/web/templates"
	"nexmap.net/web/templates/ui"
)

// DetailMarkdownSection renders a labeled Markdown block below a border separator.
// Renders nothing if the content is empty.
templ DetailMarkdownSection(label, content string) {
	if content != "" {
		<div class="mt-6 border-t border-gray-200 pt-4 dark:border-gray-700">
			<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</h3>
			<div class="prose prose-sm dark:prose-invert mt-2 max-w-none">
				@templ.Raw(templates.RenderMarkdown(content))
			</div>
		</div>
	}
}

// DetailDescription renders a Markdown description below a border separator.
// Renders nothing if the description is empty.
templ DetailDescription(description string) {
	@DetailMarkdownSection("Description", description)
}

// DetailPageHeader renders the header for an entity detail page.
templ DetailPageHeader(breadcrumbs []templates.BreadcrumbItem, title, subtitle, editHref, deleteURL, csrfToken string) {
	<div class="space-y-4">
		@ui.Breadcrumb(breadcrumbs)
		<div class="flex items-start justify-between">
			<div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{ title }</h1>
				if subtitle != "" {
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ subtitle }</p>
				}
			</div>
			<div class="flex items-center gap-2">
				{ children... }
				if editHref != "" {
					@ui.LinkButton(editHref, "Edit", "secondary", "md") {
						@ui.Icon("edit", "sm")
					}
				}
				if deleteURL != "" {
					@DeleteTrigger(deleteURL, csrfToken)
				}
			</div>
		</div>
	</div>
}

// DetailSection renders a labeled section within a detail page.
templ DetailSection(title string) {
	<div class="space-y-3">
		<h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{ title }</h2>
		{ children... }
	</div>
}

// DetailField renders a label-value pair.
templ DetailField(label, value string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if value != "" {
				{ value }
			} else {
				<span class="text-gray-400 dark:text-gray-500">—</span>
			}
		</dd>
	</div>
}

// DetailGrid renders fields in a responsive grid.
templ DetailGrid() {
	<dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
		{ children... }
	</dl>
}
