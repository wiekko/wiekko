package patterns

import "nexmap.net/web/templates/ui"

// SidebarNav renders the left navigation panel for the caller's current context:
// a product, instance administration, or the signed-in user's own account. The
// contexts are mutually exclusive, so nothing is ever shown as a peer of a group
// from another scope.
//
// Callers must gate this on HasSidebar: outside those three contexts it renders
// an empty panel.
templ SidebarNav(activeSection, productID, productName, workflowMode string) {
	<aside class="flex h-full w-64 flex-col overflow-y-auto border-r border-gray-200 bg-white scrollbar-thin dark:border-gray-700 dark:bg-gray-900">
		<!-- Mobile close button -->
		<div class="flex items-center justify-end border-b border-gray-200 px-3 py-2 md:hidden dark:border-gray-700">
			<button type="button" class="rounded-md p-1 text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:hover:text-gray-300" onclick="closeSidebar()" aria-label="Close menu">
				@ui.Icon("x", "md")
			</button>
		</div>
		<!-- Navigation -->
		<nav class="flex-1 space-y-1 px-3 py-4">
			if isAdminSection(activeSection) {
				@SidebarHeading("Administration")
				@SidebarLink("Users", "/admin/users", "users", activeSection == "admin-users", "")
				@SidebarLink("Settings", "/admin/settings", "settings", activeSection == "admin-settings", "")
				@SidebarLink("Invitations", "/admin/invitations", "link", activeSection == "admin-invitations", "")
			} else if isAccountSection(activeSection) {
				@SidebarHeading("Account")
				@SidebarLink("Profile", "/user/profile", "user", activeSection == "user-profile", "")
				@SidebarLink("API Tokens", "/user/tokens", "key-round", activeSection == "user-tokens", "")
			} else if productID != "" {
				<!-- Product switcher: shown below md, where this sidebar is the mobile drawer -->
				<div class="mb-2 border-b border-gray-200 pb-3 md:hidden dark:border-gray-700">
					@ProductSwitcher("sidebar", productID, productName, activeSection, true)
				</div>
				<!-- Product landing page: a page in its own right, not a group member -->
				@SidebarLink("Overview", "/products/"+productID, "layout-dashboard", activeSection == "overview", "")
				<!-- Groups read top to bottom as the product lifecycle: define, deliver, verify, configure -->
				@SidebarSection("Definition", activeSection == "components" || activeSection == "capabilities" || activeSection == "constraints" || activeSection == "milestones") {
					@SidebarLink("Components", "/products/"+productID+"/components", "component", activeSection == "components", "")
					@SidebarLink("Capabilities", "/products/"+productID+"/capabilities", "layers", activeSection == "capabilities", "")
					@SidebarLink("Constraints", "/products/"+productID+"/constraints", "shield-check", activeSection == "constraints", "")
					@SidebarLink("Milestones", "/products/"+productID+"/milestones", "calendar", activeSection == "milestones", "")
				}
				@SidebarSection("Backlog", activeSection == "requirements" || activeSection == "defects" || activeSection == "tasks" || activeSection == "sprints" || activeSection == "board") {
					@SidebarLink("Requirements", "/products/"+productID+"/requirements", "clipboard-list", activeSection == "requirements", "")
					@SidebarLink("Defects", "/products/"+productID+"/defects", "bug", activeSection == "defects", "")
					@SidebarLink("Tasks", "/products/"+productID+"/tasks", "list-checks", activeSection == "tasks", "")
					@SidebarWorkflowItem(productID, workflowMode, activeSection)
				}
				@SidebarSection("Testing", activeSection == "test-cases" || activeSection == "campaigns") {
					@SidebarLink("Test Cases", "/products/"+productID+"/test-cases", "beaker", activeSection == "test-cases", "")
					@SidebarLink("Campaigns", "/products/"+productID+"/campaigns", "flag", activeSection == "campaigns", "")
				}
				@SidebarSection("Setup", activeSection == "team" || activeSection == "settings") {
					@SidebarLink("Team", "/products/"+productID+"/team", "users", activeSection == "team", "")
					@SidebarLink("Settings", "/products/"+productID+"/settings", "settings", activeSection == "settings", "")
				}
			}
		</nav>
	</aside>
}

// SidebarHeading renders a group label that does not collapse. Used by the
// administration and account contexts, where the group is the only one in the
// panel: a collapsible group there could be folded away to an empty sidebar, and
// the label's job is to explain why the panel looks different, not to fold.
templ SidebarHeading(title string) {
	<p class="px-3 pt-1 pb-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
		{ title }
	</p>
}

// SidebarSection renders a collapsible group of nav links with a heading.
templ SidebarSection(title string, open bool) {
	<details
		class="pt-4 group/section"
		if open {
			open
		}
	>
		<summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-1 text-xs font-semibold uppercase tracking-wider text-gray-500 select-none hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 [&::-webkit-details-marker]:hidden">
			{ title }
			<span class="transition-transform duration-200 group-open/section:rotate-90">
				@ui.Icon("chevron-right", "sm")
			</span>
		</summary>
		<div class="mt-2 space-y-1">
			{ children... }
		</div>
	</details>
}

// SidebarLink renders a single navigation item.
templ SidebarLink(label, href, icon string, active bool, badge string) {
	<a
		href={ templ.SafeURL(href) }
		class={ "group flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors",
			sidebarLinkClass(active) }
	>
		<span class={ sidebarIconClass(active) }>
			@ui.Icon(icon, "md")
		</span>
		<span class="flex-1">{ label }</span>
		if badge != "" {
			<span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
				{ badge }
			</span>
		}
	</a>
}

// SidebarWorkflowItem renders the workflow-dependent nav item (Sprints or Board).
// It is wrapped in a div with a stable ID so it can be swapped via htmx OOB
// when the workflow mode changes in product settings.
templ SidebarWorkflowItem(productID, workflowMode, activeSection string) {
	<div id="sidebar-workflow-item">
		if workflowMode == "scrum" {
			@SidebarLink("Sprints", "/products/"+productID+"/sprints", "clock", activeSection == "sprints", "")
		} else {
			@SidebarLink("Board", "/products/"+productID+"/board", "kanban", activeSection == "board", "")
		}
	</div>
}

// SidebarWorkflowItemOOB renders the workflow nav item as an htmx out-of-band swap.
// Append this to any response to update the sidebar without a full page reload.
templ SidebarWorkflowItemOOB(productID, workflowMode string) {
	<div id="sidebar-workflow-item" hx-swap-oob="true">
		if workflowMode == "scrum" {
			@SidebarLink("Sprints", "/products/"+productID+"/sprints", "clock", false, "")
		} else {
			@SidebarLink("Board", "/products/"+productID+"/board", "kanban", false, "")
		}
	</div>
}

func sidebarLinkClass(active bool) string {
	if active {
		return "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400"
	}
	return "text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100"
}

func sidebarIconClass(active bool) string {
	if active {
		return "text-indigo-500 dark:text-indigo-400"
	}
	return "text-gray-400 group-hover:text-gray-500 dark:text-gray-500 dark:group-hover:text-gray-400"
}
