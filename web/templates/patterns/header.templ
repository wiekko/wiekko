package patterns

import "nexmap.net/web/templates/ui"

// AppHeader renders the top header bar with user menu.
templ AppHeader(displayName, csrfToken string, isAdmin bool) {
	<header class="flex h-16 items-center justify-between border-b border-gray-200 bg-white px-4 sm:px-6 dark:border-gray-700 dark:bg-gray-900">
		<div class="flex items-center gap-3">
			<!-- Mobile menu toggle -->
			<button type="button" class="rounded-md p-1.5 text-gray-500 hover:bg-gray-100 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 md:hidden dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200" onclick="openSidebar()" aria-label="Open menu">
				@ui.Icon("menu", "md")
			</button>
			<!-- Placeholder for breadcrumbs or page title injected by pages -->
		</div>
		<div class="flex items-center gap-4">
			@ui.ThemeToggle()
			@ui.DropdownMenu("user-menu") {
				@ui.DropdownTrigger() {
					<button type="button" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-gray-300 dark:hover:bg-gray-800">
						@ui.UserAvatar(displayName, "sm")
						<span>{ displayName }</span>
						@ui.Icon("chevron-down", "sm")
					</button>
				}
				@ui.DropdownContent() {
					@ui.DropdownItem("Profile", "/user/profile", "settings", false)
					@ui.DropdownItem("API Tokens", "/user/tokens", "link", false)
					if isAdmin {
						@ui.DropdownDivider()
						@ui.DropdownItem("Admin", "/admin/users", "users", false)
					}
					@ui.DropdownDivider()
					<form method="POST" action="/logout">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button
							type="submit"
							class="flex w-full cursor-pointer items-center gap-2 px-4 py-2 text-sm text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/30"
							role="menuitem"
						>
							@ui.Icon("log-out", "sm")
							Sign out
						</button>
					</form>
				}
			}
		</div>
	</header>
}
