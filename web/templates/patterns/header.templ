package patterns

import "nexmap.net/web/templates/ui"

// AppHeader renders the top header bar with user menu.
templ AppHeader(displayName, csrfToken string, isAdmin bool) {
	<header class="flex h-16 items-center justify-between border-b border-gray-200 bg-white px-6">
		<div>
			<!-- Placeholder for breadcrumbs or page title injected by pages -->
		</div>
		<div class="flex items-center gap-4">
			@ui.DropdownMenu("user-menu") {
				@ui.DropdownTrigger() {
					<button type="button" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
						@ui.UserAvatar(displayName, "sm")
						<span>{ displayName }</span>
						@ui.Icon("chevron-down", "sm")
					</button>
				}
				@ui.DropdownContent() {
					@ui.DropdownItem("Profile", "/user/profile", "settings", false)
					@ui.DropdownItem("API Tokens", "/user/tokens", "link", false)
					if isAdmin {
						@ui.DropdownDivider()
						@ui.DropdownItem("Admin", "/admin/users", "users", false)
					}
					@ui.DropdownDivider()
					@ui.DropdownItem("Sign out", "", "logout", true) {
						<span
							hx-post="/api/v1/auth/logout"
							hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` }
						></span>
					}
				}
			}
		</div>
	</header>
}
