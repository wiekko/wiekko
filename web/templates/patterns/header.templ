package patterns

import "nexmap.net/web/templates/ui"

// AppHeader renders the top header bar with logo, product switcher, and user menu.
templ AppHeader(displayName, csrfToken, productID, productName, activeSection string, isAdmin bool) {
	<header class="flex h-16 items-center justify-between border-b border-gray-200 bg-white px-4 sm:px-6 dark:border-gray-700 dark:bg-gray-900">
		<div class="flex items-center gap-3">
			<!-- Mobile menu toggle: only where there is a sidebar to open -->
			if HasSidebar(activeSection, productID) {
				<button type="button" class="rounded-md p-1.5 text-gray-500 hover:bg-gray-100 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 md:hidden dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200" onclick="openSidebar()" aria-label="Open menu">
					@ui.Icon("menu", "md")
				</button>
			}
			<!-- Logo -->
			<a href="/" class="flex items-center gap-2">
				<img src="/static/img/logo-icon.svg" alt="Nexmap" class="h-8 w-8"/>
				<span class="hidden text-lg font-bold text-gray-900 sm:inline dark:text-gray-100">Nexmap</span>
			</a>
			<!-- Product context: switcher, hidden on mobile (the sidebar carries it there) -->
			if productName != "" {
				<span class="hidden text-gray-300 sm:inline dark:text-gray-600">/</span>
				<div class="hidden sm:block">
					@ProductSwitcher("header", productID, productName, activeSection, false)
				</div>
			}
		</div>
		<div class="flex items-center gap-4">
			@ui.ThemeToggle()
			@ui.DropdownMenu("user-menu") {
				@ui.DropdownTrigger() {
					<button type="button" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-gray-300 dark:hover:bg-gray-800">
						<span id="header-user-info" class="flex items-center gap-2">
							@ui.UserAvatar(displayName, "sm")
							<span class="hidden sm:inline">{ displayName }</span>
						</span>
						@ui.Icon("chevron-down", "sm")
					</button>
				}
				@ui.DropdownContent() {
					@ui.DropdownItem("Profile", "/user/profile", "user", false)
					@ui.DropdownItem("API Tokens", "/user/tokens", "key-round", false)
					if isAdmin {
						@ui.DropdownDivider()
						@ui.DropdownItem("Admin", "/admin/users", "users", false)
					}
					@ui.DropdownDivider()
					<form method="POST" action="/logout">
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<button
							type="submit"
							class="flex w-full cursor-pointer items-center gap-2 px-4 py-2 text-sm text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/30"
							role="menuitem"
						>
							@ui.Icon("log-out", "sm")
							Sign out
						</button>
					</form>
				}
			}
		</div>
	</header>
}
