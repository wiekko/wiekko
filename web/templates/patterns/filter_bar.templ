package patterns

import "nexmap.net/web/templates/ui"

// FilterBar renders a horizontal bar with filter controls.
// Filter inputs are provided as children (e.g., Select, TextInput).
templ FilterBar(hxGet, hxTarget string) {
	<div
		class="flex flex-wrap items-end gap-4 rounded-lg bg-gray-50 p-4 dark:bg-gray-800"
		hx-get={ hxGet }
		hx-target={ hxTarget }
		hx-swap="innerHTML"
		hx-trigger="change"
		hx-include="[name]"
		hx-push-url="true"
	>
		{ children... }
	</div>
}

// FilterBarStatic renders the same shell as FilterBar without the htmx wiring,
// for surfaces that filter in the browser. The campaign scope picker needs this:
// re-rendering its list from the server would drop checkboxes that fall outside
// the current filter, silently shrinking the campaign scope.
templ FilterBarStatic() {
	<div class="grid grid-cols-1 gap-4 rounded-lg bg-gray-50 p-4 sm:grid-cols-2 lg:grid-cols-3 dark:bg-gray-800">
		{ children... }
	</div>
}

// FilterChip renders an active filter indicator with a remove button.
templ FilterChip(label, value string) {
	<span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 ring-1 ring-indigo-700/10 ring-inset dark:bg-indigo-900/30 dark:text-indigo-400 dark:ring-indigo-400/10">
		{ label }: { value }
		<button type="button" class="ml-1 text-indigo-500 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300">
			@ui.Icon("x", "sm")
		</button>
	</span>
}
