package ui

// Card renders a container with rounded corners and shadow.
templ Card() {
	<div class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-gray-200">
		{ children... }
	</div>
}

// CardHeader renders a card header with a title and optional actions (via children).
templ CardHeader(title string) {
	<div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
		<h3 class="text-base font-semibold text-gray-900">{ title }</h3>
		{ children... }
	</div>
}

// CardBody renders padded card content.
templ CardBody() {
	<div class="px-6 py-4">
		{ children... }
	</div>
}

// CardFooter renders a card footer with a gray background.
templ CardFooter() {
	<div class="flex items-center justify-end gap-3 border-t border-gray-200 bg-gray-50 px-6 py-3">
		{ children... }
	</div>
}
