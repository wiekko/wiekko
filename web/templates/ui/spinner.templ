package ui

// LoadingSpinner renders an animated spinner. Sizes: "sm", "md", "lg".
templ LoadingSpinner(size string) {
	<svg
		class={ spinnerSize(size), "animate-spin text-indigo-600" }
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		aria-hidden="true"
	>
		<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
		<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
	</svg>
}

// SkeletonRow renders placeholder rows for loading table content.
templ SkeletonRow(columns int) {
	<tr class="animate-pulse">
		for i := 0; i < columns; i++ {
			<td class="px-6 py-4">
				<div class={ "h-4 rounded bg-gray-200", skeletonWidth(i) }></div>
			</td>
		}
	</tr>
}

func spinnerSize(size string) string {
	switch size {
	case "sm":
		return "h-4 w-4"
	case "lg":
		return "h-8 w-8"
	default:
		return "h-6 w-6"
	}
}

func skeletonWidth(index int) string {
	widths := []string{"w-3/4", "w-1/2", "w-2/3", "w-1/3", "w-5/6"}
	return widths[index%len(widths)]
}

// HtmxIndicator wraps content to show during htmx requests via the htmx-indicator class.
templ HtmxIndicator() {
	<span class="htmx-indicator inline-flex items-center gap-2">
		@LoadingSpinner("sm")
		<span class="text-sm text-gray-500">Loading…</span>
	</span>
}

