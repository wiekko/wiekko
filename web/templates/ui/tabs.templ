package ui

import "nexmap.net/web/templates"

// TabGroup renders a horizontal tab bar. Each tab loads content via htmx.
templ TabGroup(tabs []templates.TabDef) {
	<div class="border-b border-gray-200">
		<nav class="-mb-px flex space-x-8" aria-label="Tabs">
			for _, tab := range tabs {
				<button
					type="button"
					hx-get={ tab.HxGet }
					hx-target={ "#tab-panel-" + tab.ID }
					hx-swap="innerHTML"
					class={ "whitespace-nowrap border-b-2 px-1 py-3 text-sm font-medium transition-colors",
						tabClass(tab.Active) }
					if tab.Active {
						aria-current="page"
					}
				>
					{ tab.Label }
				</button>
			}
		</nav>
	</div>
}

// TabPanel renders a content area for a tab. The id matches the tab definition.
templ TabPanel(id string) {
	<div id={ "tab-panel-" + id } class="py-4">
		{ children... }
	</div>
}

func tabClass(active bool) string {
	if active {
		return "border-indigo-500 text-indigo-600"
	}
	return "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
}
