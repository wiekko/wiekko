package ui

import "nexmap.net/web/templates"

// Breadcrumb renders a navigation breadcrumb trail.
templ Breadcrumb(items []templates.BreadcrumbItem) {
	<nav aria-label="Breadcrumb" class="flex">
		<ol role="list" class="flex items-center space-x-2">
			for i, item := range items {
				<li class="flex items-center">
					if i > 0 {
						<span class="mx-2 text-gray-400">
							@Icon("chevron-right", "sm")
						</span>
					}
					if item.Href != "" && i < len(items)-1 {
						<a href={ templ.SafeURL(item.Href) } class="text-sm font-medium text-gray-500 hover:text-gray-700">
							{ item.Label }
						</a>
					} else {
						<span class="text-sm font-medium text-gray-900" aria-current="page">
							{ item.Label }
						</span>
					}
				</li>
			}
		</ol>
	</nav>
}
