package ui

// Modal renders an overlay dialog. Content is provided via children.
// It is shown by swapping content into it via htmx (e.g., hx-target="#modal").
// Size: "sm", "md", "lg".
templ Modal(id, title, size string) {
	<div
		id={ id }
		class="relative z-50"
		aria-labelledby={ id + "-title" }
		role="dialog"
		aria-modal="true"
	>
		<!-- Backdrop -->
		<div class="fixed inset-0 bg-gray-500/75 transition-opacity dark:bg-gray-900/80"></div>
		<!-- Dialog -->
		<div class="fixed inset-0 z-10 overflow-y-auto">
			<div class="flex min-h-full items-center justify-center p-4">
				<div class={ "relative w-full transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all dark:bg-gray-900", modalSize(size) }>
					<!-- Header -->
					<div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-700">
						<h3 id={ id + "-title" } class="text-lg font-semibold text-gray-900 dark:text-gray-100">{ title }</h3>
						<button
							type="button"
							class="rounded-md text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400"
							onclick={ closeModal(id) }
						>
							@Icon("x", "md")
						</button>
					</div>
					<!-- Body -->
					<div class="px-6 py-4">
						{ children... }
					</div>
				</div>
			</div>
		</div>
	</div>
}

// ModalContainer is an empty target for htmx to swap modal content into.
templ ModalContainer() {
	<div id="modal"></div>
}

// ModalCancelButton renders a "Cancel" button that closes the modal with
// the given id. Used by modal-mode forms to dismiss without submission.
templ ModalCancelButton(modalID string) {
	<button
		type="button"
		class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700"
		onclick={ closeModal(modalID) }
	>
		Cancel
	</button>
}

// ConfirmDialog renders a confirmation modal with confirm/cancel buttons.
templ ConfirmDialog(id, title, message, confirmLabel, confirmVariant, hxMethod, hxAction string) {
	@Modal(id, title, "sm") {
		<p class="text-sm text-gray-500 dark:text-gray-400">{ message }</p>
		<div class="mt-4 flex justify-end gap-3">
			<button
				type="button"
				class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700"
				onclick={ closeModal(id) }
			>
				Cancel
			</button>
			<button
				type="button"
				class={ "rounded-md px-3 py-2 text-sm font-semibold text-white", confirmButtonColor(confirmVariant) }
				if hxMethod == "delete" {
					hx-delete={ hxAction }
				} else {
					hx-post={ hxAction }
				}
				hx-target={ "#" + id }
				hx-swap="delete"
			>
				{ confirmLabel }
			</button>
		</div>
	}
}

func modalSize(size string) string {
	switch size {
	case "sm":
		return "sm:max-w-md"
	case "lg":
		return "sm:max-w-2xl"
	default:
		return "sm:max-w-lg"
	}
}

func confirmButtonColor(variant string) string {
	switch variant {
	case "danger":
		return "bg-red-600 hover:bg-red-500"
	default:
		return "bg-indigo-600 hover:bg-indigo-500"
	}
}

script closeModal(id string) {
	const el = document.getElementById(id);
	if (el) el.innerHTML = '';
}
