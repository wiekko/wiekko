package ui

// Modal renders an overlay dialog. Content is provided via children.
// It is shown by swapping content into it via htmx (e.g., hx-target="#modal").
// Size: "sm", "md", "lg".
//
// modal.js gives every modal its keyboard and touch behaviour: focus moves
// into the dialog and stays there, Escape closes it, focus returns to where it
// was, and in a confirmation dialog Enter confirms (UR-154).
templ Modal(id, title, size string) {
	<div
		id={ id }
		class="relative z-50"
		aria-labelledby={ id + "-title" }
		role="dialog"
		aria-modal="true"
	>
		<!-- Backdrop -->
		<div class="fixed inset-0 bg-gray-500/75 transition-opacity dark:bg-gray-900/80"></div>
		<!-- Dialog -->
		<div class="fixed inset-0 z-10 overflow-y-auto">
			<div class="flex min-h-full items-center justify-center p-4">
				<div data-modal-panel class={ "relative w-full transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all dark:bg-gray-900", modalSize(size) }>
					<!-- Header -->
					<div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-700">
						<h3 id={ id + "-title" } class="text-lg font-semibold text-gray-900 dark:text-gray-100">{ title }</h3>
						<button
							type="button"
							aria-label="Close"
							class="rounded-md p-1 text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-gray-500 dark:hover:text-gray-400"
							data-modal-close={ id }
						>
							@Icon("x", "md")
						</button>
					</div>
					<!-- Body -->
					<div class="px-6 py-4">
						{ children... }
					</div>
				</div>
			</div>
		</div>
	</div>
}

// ModalContainer is an empty target for htmx to swap modal content into.
templ ModalContainer() {
	<div id="modal"></div>
}

// ModalCancelButton renders a "Cancel" button that closes the modal with
// the given id. Used by modal-mode forms to dismiss without submission.
templ ModalCancelButton(modalID string) {
	<button
		type="button"
		class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700"
		data-modal-close={ modalID }
	>
		Cancel
	</button>
}

// ConfirmDialog renders a confirmation modal with confirm/cancel buttons.
// confirmVariant is "danger" for actions that cannot be undone, anything
// else for neutral styling.
//
// The confirm button carries its own hx-headers: the dialog may be rendered
// outside #app-shell, where the shell's CSRF header is not inherited.
templ ConfirmDialog(id, title, message, confirmLabel, confirmVariant, hxMethod, hxAction, csrfToken string) {
	@Modal(id, title, "sm") {
		<p class="text-sm text-gray-500 dark:text-gray-400">{ message }</p>
		<div class="mt-4 flex justify-end gap-3">
			@ModalCancelButton(id)
			<button
				type="button"
				class={ ConfirmButtonClass(ConfirmVariant(confirmVariant)) }
				data-confirm-action
				if hxMethod == "delete" {
					hx-delete={ hxAction }
				} else {
					hx-post={ hxAction }
				}
				if csrfToken != "" {
					hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` }
				}
				hx-target={ "#" + id }
				hx-swap="delete"
			>
				{ confirmLabel }
			</button>
		</div>
	}
}

// ConfirmTemplate is the dialog modal.js shows for elements carrying
// hx-confirm (see Confirm), so those requests confirm in the application's
// modal rather than in the browser's confirm(). It fills in the title,
// message, label and variant from the element's attributes. The layout
// renders it once per page.
templ ConfirmTemplate() {
	<template id="confirm-dialog-template">
		@Modal(confirmTemplateID, "", "sm") {
			<p class="text-sm text-gray-500 dark:text-gray-400" data-confirm-message></p>
			<div class="mt-4 flex justify-end gap-3">
				@ModalCancelButton(confirmTemplateID)
				<button
					type="button"
					class={ ConfirmButtonClass(ConfirmNeutral) }
					data-confirm-action
					data-class-neutral={ ConfirmButtonClass(ConfirmNeutral) }
					data-class-danger={ ConfirmButtonClass(ConfirmDanger) }
				></button>
			</div>
		}
	</template>
}

const confirmTemplateID = "confirm-dialog"

func modalSize(size string) string {
	switch size {
	case "sm":
		return "sm:max-w-md"
	case "lg":
		return "sm:max-w-2xl"
	default:
		return "sm:max-w-lg"
	}
}

// ConfirmButtonClass is the class list of a confirmation dialog's confirm
// button: red for ConfirmDanger, indigo otherwise (DOC-2).
func ConfirmButtonClass(variant ConfirmVariant) string {
	const base = "rounded-md px-3 py-2 text-sm font-semibold text-white focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-gray-900 "
	if variant == ConfirmDanger {
		return base + "bg-red-600 hover:bg-red-500 focus:ring-red-500"
	}
	return base + "bg-indigo-600 hover:bg-indigo-500 focus:ring-indigo-500"
}
