package ui

import "wiekko.net/web/templates"

// ToastContainer renders a fixed-position container for toast notifications.
// Toasts are injected via htmx OOB swaps targeting this container.
//
// A notice for the page (templates.NoticeFrom, e.g. why a form redirected
// here) is rendered into it as a warning toast, and the ?notice= parameter
// that carried it is taken out of the address bar, so reloading the page or
// copying its address does not repeat it.
//
// The trailing <template> holds an empty error toast that htmx-errors.js clones
// to report failed requests, so client-side toasts stay markup-identical to the
// server-rendered ones.
templ ToastContainer() {
	<div id="toast-container" class="pointer-events-none fixed right-0 top-0 z-50 flex flex-col items-end gap-2 p-4">
		if notice := templates.NoticeFrom(ctx); notice != "" {
			@Toast(notice, "warning")
		}
	</div>
	if templates.NoticeFrom(ctx) != "" {
		<script>
			(function () {
				var url = new URL(window.location.href);
				url.searchParams.delete("notice");
				window.history.replaceState(window.history.state, "", url.pathname + url.search + url.hash);
			})();
		</script>
	}
	<template id="toast-error-template">
		@Toast("", "error")
	</template>
}

// Toast renders a single notification.
// Variant: "success", "error", "info", "warning".
// Use hx-swap-oob="afterbegin:#toast-container" in server responses to inject.
templ Toast(message, variant string) {
	<div
		class={ "pointer-events-auto w-80 animate-toast rounded-lg p-4 shadow-lg ring-1 ring-black/5 dark:ring-white/10", toastBg(variant) }
		role="alert"
	>
		<div class="flex items-center gap-3">
			<div class={ "shrink-0", toastIconColor(variant) }>
				@Icon(toastIcon(variant), "md")
			</div>
			<p class={ "text-sm font-medium", toastTextColor(variant) }>{ message }</p>
		</div>
	</div>
}

// ToastOOB renders a toast with the OOB swap attribute so it can be included
// in any htmx response to show a notification.
templ ToastOOB(message, variant string) {
	<div hx-swap-oob="afterbegin:#toast-container">
		@Toast(message, variant)
	</div>
}

func toastBg(variant string) string {
	switch variant {
	case "success":
		return "bg-green-50 dark:bg-green-900/30"
	case "error":
		return "bg-red-50 dark:bg-red-900/30"
	case "warning":
		return "bg-yellow-50 dark:bg-yellow-900/30"
	default: // info
		return "bg-blue-50 dark:bg-blue-900/30"
	}
}

func toastIconColor(variant string) string {
	switch variant {
	case "success":
		return "text-green-500 dark:text-green-400"
	case "error":
		return "text-red-500 dark:text-red-400"
	case "warning":
		return "text-yellow-500 dark:text-yellow-400"
	default:
		return "text-blue-500 dark:text-blue-400"
	}
}

func toastTextColor(variant string) string {
	switch variant {
	case "success":
		return "text-green-800 dark:text-green-300"
	case "error":
		return "text-red-800 dark:text-red-300"
	case "warning":
		return "text-yellow-800 dark:text-yellow-300"
	default:
		return "text-blue-800 dark:text-blue-300"
	}
}

func toastIcon(variant string) string {
	switch variant {
	case "success":
		return "check"
	case "error":
		return "x"
	case "warning":
		return "alert-triangle"
	default:
		return "eye"
	}
}
