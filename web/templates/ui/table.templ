package ui

// Table renders a responsive table wrapper.
//
// The wrapper is positioned so it contains absolutely positioned content
// such as the sr-only "Actions" header label: without that, the label is
// placed relative to the page, escapes the scroll box and widens the whole
// page on narrow screens (UC-60).
//
// It scrolls both ways. Where a list page bounds its height (TableCard,
// UR-164) the rows scroll inside it under the sticky column headers; anywhere
// else its height follows the rows and only the horizontal scrolling shows.
templ Table() {
	<div class="relative min-h-0 overflow-auto">
		<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
			{ children... }
		</table>
	</div>
}

// TableHead renders a table header row. It sticks to the top of the table's
// scroll box (UR-164). The line under it is a shadow on the cells: the
// table's own divider belongs to the body and scrolls away with it.
templ TableHead() {
	<thead class="sticky top-0 z-10 bg-gray-50 dark:bg-gray-800 [&_th]:shadow-[inset_0_-1px_0_var(--color-gray-200)] dark:[&_th]:shadow-[inset_0_-1px_0_var(--color-gray-700)]">
		<tr>
			{ children... }
		</tr>
	</thead>
}

// TableHeader renders a column header cell.
templ TableHeader() {
	<th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">
		{ children... }
	</th>
}

// SortHeader renders a clickable sortable column header using htmx.
//
// The link comes from state.SortURL so it carries the active search, filters
// and direction with it; the header must never build its own query string.
templ SortHeader(label, sortField string, state ListState, hxTarget string) {
	{{ active, dir := state.SortedBy(sortField) }}
	<th
		scope="col"
		class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400"
		if active {
			aria-sort={ ariaSort(dir) }
		}
	>
		<a
			href={ templ.SafeURL(state.SortURL(sortField)) }
			title={ sortActionLabel(active, dir) }
			class="group inline-flex items-center gap-1 hover:text-gray-700 dark:hover:text-gray-200"
			hx-get={ state.SortURL(sortField) }
			hx-target={ hxTarget }
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			{ label }
			<span class={ "text-gray-400 dark:text-gray-500", sortIndicatorClass(active) }>
				if active && dir == SortDesc {
					@Icon("chevron-down", "sm")
				} else {
					@Icon("chevron-up", "sm")
				}
			</span>
		</a>
	</th>
}

// TableBody renders a table body with an htmx target id.
templ TableBody(id string) {
	<tbody
		if id != "" {
			id={ id }
		}
		class="divide-y divide-gray-200 bg-white dark:divide-gray-700 dark:bg-gray-900"
	>
		{ children... }
	</tbody>
}

// TableRow renders a table row with optional htmx click navigation.
templ TableRow(hxGet string) {
	<tr
		if hxGet != "" {
			hx-get={ hxGet }
			hx-push-url="true"
			hx-target="#main-content"
			hx-swap="innerHTML"
		}
		class={ "transition-colors", rowClass(hxGet) }
	>
		{ children... }
	</tr>
}

// SelectableRow renders a row of a table with bulk operations (UC-76). It
// names its item for bulk-select.js, which selects it in selection mode; the
// selected look is styled on aria-selected in input.css.
templ SelectableRow(itemID string) {
	<tr data-bulk-id={ itemID } class="transition-colors">
		{ children... }
	</tr>
}

// TableCell renders a table data cell.
templ TableCell() {
	<td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900 dark:text-gray-100">
		{ children... }
	</td>
}

// TableCellMuted renders a table data cell with muted text.
templ TableCellMuted() {
	<td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
		{ children... }
	</td>
}

func rowClass(hxGet string) string {
	if hxGet != "" {
		return "cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800"
	}
	return ""
}

func sortIndicatorClass(active bool) string {
	if active {
		return "text-indigo-600 dark:text-indigo-400"
	}
	return "invisible group-hover:visible"
}

func ariaSort(dir string) string {
	if dir == SortDesc {
		return "descending"
	}
	return "ascending"
}

// sortActionLabel names what the next click will do. A column cycles through
// three states, and the third — dropping the sort — is not something a chevron
// can express, so it needs saying.
func sortActionLabel(active bool, dir string) string {
	switch {
	case !active:
		return "Sort ascending"
	case dir == SortAsc:
		return "Sort descending"
	default:
		return "Remove sorting"
	}
}
