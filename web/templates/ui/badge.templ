package ui

// Badge renders a colored label pill.
// Colors: "green", "emerald", "yellow", "red", "blue", "gray", "indigo", "amber".
templ Badge(text, color string) {
	<span class={ "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium", badgeColor(color) }>
		{ text }
	</span>
}

// RoleBadge renders a product role as a colored pill. Renders nothing for an
// unknown or empty role.
templ RoleBadge(role string) {
	switch role {
		case "owner":
			@Badge("Owner", "indigo")
		case "developer":
			@Badge("Developer", "blue")
		case "tester":
			@Badge("Tester", "green")
		case "viewer":
			@Badge("Viewer", "gray")
		case "admin":
			@Badge("Admin", "amber")
	}
}

func badgeColor(color string) string {
	switch color {
	case "green":
		return "bg-green-50 text-green-700 ring-1 ring-green-600/20 ring-inset dark:bg-green-900/30 dark:text-green-400 dark:ring-green-400/20"
	case "emerald":
		return "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20 ring-inset dark:bg-emerald-900/30 dark:text-emerald-400 dark:ring-emerald-400/20"
	case "yellow":
		return "bg-yellow-50 text-yellow-800 ring-1 ring-yellow-600/20 ring-inset dark:bg-yellow-900/30 dark:text-yellow-400 dark:ring-yellow-400/20"
	case "red":
		return "bg-red-50 text-red-700 ring-1 ring-red-600/20 ring-inset dark:bg-red-900/30 dark:text-red-400 dark:ring-red-400/20"
	case "blue":
		return "bg-blue-50 text-blue-700 ring-1 ring-blue-700/10 ring-inset dark:bg-blue-900/30 dark:text-blue-400 dark:ring-blue-400/10"
	case "indigo":
		return "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-700/10 ring-inset dark:bg-indigo-900/30 dark:text-indigo-400 dark:ring-indigo-400/10"
	case "amber":
		return "bg-amber-50 text-amber-800 ring-1 ring-amber-600/20 ring-inset dark:bg-amber-900/30 dark:text-amber-400 dark:ring-amber-400/20"
	default: // gray
		return "bg-gray-50 text-gray-600 ring-1 ring-gray-500/10 ring-inset dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-400/10"
	}
}
