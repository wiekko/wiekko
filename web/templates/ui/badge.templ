package ui

// Badge renders a colored label pill.
// Colors: "green", "yellow", "red", "blue", "gray", "indigo", "amber".
templ Badge(text, color string) {
	<span class={ "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium", badgeColor(color) }>
		{ text }
	</span>
}

func badgeColor(color string) string {
	switch color {
	case "green":
		return "bg-green-50 text-green-700 ring-1 ring-green-600/20 ring-inset"
	case "yellow":
		return "bg-yellow-50 text-yellow-800 ring-1 ring-yellow-600/20 ring-inset"
	case "red":
		return "bg-red-50 text-red-700 ring-1 ring-red-600/20 ring-inset"
	case "blue":
		return "bg-blue-50 text-blue-700 ring-1 ring-blue-700/10 ring-inset"
	case "indigo":
		return "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-700/10 ring-inset"
	case "amber":
		return "bg-amber-50 text-amber-800 ring-1 ring-amber-600/20 ring-inset"
	default: // gray
		return "bg-gray-50 text-gray-600 ring-1 ring-gray-500/10 ring-inset"
	}
}
