package ui

import (
	lucide "github.com/kaugesaar/lucide-go"
)

// Icon renders a Lucide icon by name. Sizes: "sm" (16px), "md" (20px), "lg" (24px).
templ Icon(name, size string) {
	@templ.Raw(string(lucide.Icon(name, map[string]any{"class": iconSize(size)})))
}

func iconSize(size string) string {
	switch size {
	case "sm":
		return "h-4 w-4"
	case "lg":
		return "h-6 w-6"
	default:
		return "h-5 w-5"
	}
}
