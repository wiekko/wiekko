package user

import (
	"fmt"
	"strings"

	"nexmap.net/internal/access"
	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/ui"
)

// TokenView is a display-ready token with computed status.
type TokenView struct {
	Token     *model.PAT
	IsExpired bool
}

// TokensProps holds the data for the API tokens page.
type TokensProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Tokens      []TokenView
	Form        CreateTokenFormProps
}

// ProductOption is a product a token can be restricted to.
type ProductOption struct {
	ID       string
	Name     string
	Selected bool
}

// CreateTokenFormProps holds the create token form, including the values
// entered so far when it is shown again with an error.
type CreateTokenFormProps struct {
	Error            string
	IsAdmin          bool
	Products         []ProductOption
	MaxLifetimeDays  int    // 0 for no limit
	MaxExpiry        string // latest allowed expiry date (YYYY-MM-DD) when limited
	Name             string
	ExpiresAt        string // YYYY-MM-DD
	Grants           access.Grants
	RoleCap          string
	RestrictProducts bool
}

// scopeRow describes one scope in the create token form.
type scopeRow struct {
	Scope access.Scope
	Label string
	Hint  string
}

var productScopeRows = []scopeRow{
	{access.Structure, "Structure", "Components, capabilities, milestones, sprints"},
	{access.Backlog, "Backlog", "Requirements, tasks, constraints"},
	{access.Documents, "Documents", "Documents and their revisions"},
	{access.Defects, "Defects", "Defects"},
	{access.Tests, "Tests", "Test cases, campaigns, test runs"},
	{access.Discussion, "Discussion", "Comments and attachments"},
	{access.Settings, "Settings", "Members, categories, statuses, levels, environments"},
}

var accountScopeRow = scopeRow{access.Account, "Account", "Your profile, password, 2FA and tokens"}

var adminScopeRow = scopeRow{access.Admin, "Administration", "Users, invitations, instance settings"}

templ TokensPage(props TokensProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "user-tokens",
	}) {
		<div class="mx-auto max-w-4xl space-y-6">
			<!-- Breadcrumb -->
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: "API Tokens"},
			})
			<!-- Header -->
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">API Tokens</h1>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Personal access tokens for CLI and API authentication.</p>
				</div>
				if len(props.Tokens) > 0 {
					<button
						type="button"
						class="inline-flex items-center gap-2 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						onclick="document.getElementById('create-token-modal').classList.remove('hidden')"
					>
						@ui.Icon("plus", "sm")
						Create Token
					</button>
				}
			</div>
			@copyTokenScript()
			<!-- Token list -->
			if len(props.Tokens) == 0 {
				<div class="flex flex-col items-center justify-center py-12 text-center">
					<div class="text-gray-400 dark:text-gray-500">
						@ui.Icon("link", "lg")
					</div>
					<h3 class="mt-2 text-sm font-semibold text-gray-900 dark:text-gray-100">No tokens</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Create a personal access token to authenticate CLI and API requests.</p>
					<div class="mt-6">
						<button
							type="button"
							class="inline-flex items-center gap-2 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
							onclick="document.getElementById('create-token-modal').classList.remove('hidden')"
						>
							@ui.Icon("plus", "sm")
							Create Token
						</button>
					</div>
				</div>
			} else {
				@ui.Card() {
					@ui.Table() {
						@ui.TableHead() {
							@ui.TableHeader() {
								Name
							}
							@ui.TableHeader() {
								Token
							}
							@ui.TableHeader() {
								Access
							}
							@ui.TableHeader() {
								Created
							}
							@ui.TableHeader() {
								Last Used
							}
							@ui.TableHeader() {
								Expires
							}
							@ui.TableHeader() {
								Status
							}
							@ui.TableHeader() {
								<!-- Actions -->
							}
						}
						@TokenTableBody(props.Tokens)
					}
				}
			}
		</div>
		<!-- Create token modal -->
		<div id="create-token-modal" class="hidden relative z-50">
			<div class="fixed inset-0 bg-gray-500/75 dark:bg-gray-900/80" onclick="document.getElementById('create-token-modal').classList.add('hidden')"></div>
			<div class="fixed inset-0 z-10 overflow-y-auto">
				<div class="flex min-h-full items-center justify-center p-4">
					<div id="create-token-content" class="relative w-full max-w-lg rounded-lg bg-white p-6 shadow-xl dark:bg-gray-900">
						@CreateTokenForm(props.Form)
					</div>
				</div>
			</div>
		</div>
	}
}

// TokenTableBody renders the token table rows. Returned as fragment after revoke.
templ TokenTableBody(tokens []TokenView) {
	<tbody id="token-table-body" class="divide-y divide-gray-200 bg-white dark:divide-gray-700 dark:bg-gray-900" hx-target="this" hx-swap="outerHTML">
		for _, tv := range tokens {
			@tokenRow(tv)
		}
	</tbody>
}

templ tokenRow(tv TokenView) {
	<tr>
		@ui.TableCell() {
			<span class="font-medium">{ tv.Token.Name }</span>
		}
		@ui.TableCell() {
			<code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs dark:bg-gray-800">{ tv.Token.TokenPrefix }...</code>
		}
		@ui.TableCellMuted() {
			<span class="whitespace-normal">{ restrictionSummary(tv.Token) }</span>
		}
		@ui.TableCellMuted() {
			{ formatDate(tv.Token.CreatedAt) }
		}
		@ui.TableCellMuted() {
			if tv.Token.LastUsedAt != "" {
				{ formatDate(tv.Token.LastUsedAt) }
			} else {
				<span class="text-gray-400 dark:text-gray-500">Never</span>
			}
		}
		@ui.TableCellMuted() {
			if tv.Token.ExpiresAt != "" {
				{ formatDate(tv.Token.ExpiresAt) }
			} else {
				<span class="text-gray-400 dark:text-gray-500">Never</span>
			}
		}
		@ui.TableCell() {
			@tokenStatusBadge(tv)
		}
		@ui.TableCell() {
			if tv.Token.RevokedAt == "" && !tv.IsExpired {
				<button
					type="button"
					class="text-sm font-medium text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300"
					hx-delete={ "/user/tokens/" + tv.Token.ID }
					hx-target="#token-table-body"
					hx-swap="outerHTML"
					{ ui.Confirm(ui.ConfirmDanger, "Revoke token", "Revoke", "Revoke token "+ui.ItemName("", tv.Token.Name)+"? Applications using it lose access. This cannot be undone; you can create a new token instead.")... }
				>
					Revoke
				</button>
			}
		}
	</tr>
}

templ tokenStatusBadge(tv TokenView) {
	if tv.Token.RevokedAt != "" {
		@ui.Badge("Revoked", "red")
	} else if tv.IsExpired {
		@ui.Badge("Expired", "yellow")
	} else {
		@ui.Badge("Active", "green")
	}
}

// CreateTokenForm renders the create token form inside the modal. Returned as fragment on error.
templ CreateTokenForm(props CreateTokenFormProps) {
	<div id="create-form-section">
		<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Create API Token</h3>
		<form class="mt-4 space-y-5" hx-post="/user/tokens" hx-target="#create-token-content" hx-swap="innerHTML">
			@ui.TextInput(ui.InputProps{
				ID:          "token-name",
				Name:        "name",
				Label:       "Token Name",
				Placeholder: "e.g. CI Pipeline",
				Value:       props.Name,
				Required:    true,
			})
			<div>
				<label for="token-expiry" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
					Expiry Date
					if props.MaxLifetimeDays > 0 {
						<span class="text-red-500">*</span>
					}
				</label>
				<input
					type="date"
					id="token-expiry"
					name="expires_at"
					value={ props.ExpiresAt }
					required?={ props.MaxLifetimeDays > 0 }
					if props.MaxExpiry != "" {
						max={ props.MaxExpiry }
					}
					class={ fieldClass }
				/>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
					if props.MaxLifetimeDays > 0 {
						{ fmt.Sprintf("Tokens on this instance must expire within %d days.", props.MaxLifetimeDays) }
					} else {
						Leave empty for no expiry.
					}
				</p>
			</div>
			<fieldset>
				<legend class="text-sm font-medium text-gray-700 dark:text-gray-300">Access</legend>
				<div class="mt-2 flex flex-wrap gap-2">
					for _, p := range access.Presets() {
						<button
							type="button"
							class="rounded-md bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700"
							data-grants={ p.Grants.String() }
							onclick="applyTokenPreset(this)"
						>
							{ p.Label }
						</button>
					}
				</div>
				<div class="mt-3 divide-y divide-gray-200 rounded-md ring-1 ring-gray-200 dark:divide-gray-700 dark:ring-gray-700">
					for _, row := range productScopeRows {
						@scopeSelect(row, props.Grants[row.Scope])
					}
					@scopeSelect(accountScopeRow, props.Grants[access.Account])
					if props.IsAdmin {
						@scopeSelect(adminScopeRow, props.Grants[access.Admin])
					}
				</div>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Write includes read. Presets never grant account or administration access.</p>
			</fieldset>
			<div>
				<label for="token-password" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Your Password</label>
				<input type="password" id="token-password" name="password" autocomplete="current-password" class={ fieldClass }/>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Only needed to grant account or administration access.</p>
			</div>
			<div>
				<label for="token-role-cap" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Role Cap</label>
				<select id="token-role-cap" name="role_cap" class={ fieldClass }>
					<option value="" selected?={ props.RoleCap == "" }>No cap: act with my role</option>
					<option value="developer" selected?={ props.RoleCap == "developer" }>At most developer</option>
					<option value="tester" selected?={ props.RoleCap == "tester" }>At most tester</option>
					<option value="viewer" selected?={ props.RoleCap == "viewer" }>At most viewer</option>
				</select>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">The token acts with the lower of your role and this cap.</p>
			</div>
			<fieldset>
				<legend class="text-sm font-medium text-gray-700 dark:text-gray-300">Products</legend>
				<div class="mt-2 space-y-2">
					<label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
						<input type="radio" name="products_mode" value="all" checked?={ !props.RestrictProducts } class={ radioClass } onchange="toggleTokenProducts()"/>
						All my products, including future ones
					</label>
					<label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
						<input type="radio" name="products_mode" value="selected" checked?={ props.RestrictProducts } class={ radioClass } onchange="toggleTokenProducts()"/>
						Only these products
					</label>
					<div id="token-products" class={ "ml-6 max-h-40 space-y-1 overflow-y-auto", templ.KV("hidden", !props.RestrictProducts) }>
						if len(props.Products) == 0 {
							<p class="text-sm text-gray-500 dark:text-gray-400">You are not a member of any product.</p>
						}
						for _, p := range props.Products {
							<label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
								<input type="checkbox" name="product_ids" value={ p.ID } checked?={ p.Selected } class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"/>
								{ p.Name }
							</label>
						}
					</div>
				</div>
			</fieldset>
			if props.Error != "" {
				<p class="text-sm text-red-600 dark:text-red-400">{ props.Error }</p>
			}
			<div class="flex justify-end gap-3">
				<button type="button" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700" onclick="document.getElementById('create-token-modal').classList.add('hidden')">
					Cancel
				</button>
				@ui.Button(ui.ButtonProps{
					Label:   "Create",
					Variant: "primary",
					Size:    "md",
					Type:    "submit",
				})
			</div>
		</form>
	</div>
}

const fieldClass = "mt-1 block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"

const radioClass = "border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"

templ scopeSelect(row scopeRow, level access.Level) {
	<div class="flex items-center justify-between gap-3 px-3 py-2">
		<div class="min-w-0">
			<label for={ "token-scope-" + string(row.Scope) } class="block text-sm font-medium text-gray-900 dark:text-gray-100">{ row.Label }</label>
			<p class="text-xs text-gray-500 dark:text-gray-400">{ row.Hint }</p>
		</div>
		<select
			id={ "token-scope-" + string(row.Scope) }
			name={ "scope_" + string(row.Scope) }
			data-scope={ string(row.Scope) }
			class="shrink-0 rounded-md border-0 px-2 py-1 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
		>
			<option value="none" selected?={ level == access.None }>None</option>
			<option value="read" selected?={ level == access.Read }>Read</option>
			<option value="write" selected?={ level == access.Write }>Write</option>
		</select>
	</div>
}

// restrictionSummary describes a token's access in a few words.
func restrictionSummary(p *model.PAT) string {
	var parts []string
	r, err := access.FromPAT(p)
	switch {
	case err != nil:
		parts = append(parts, "Invalid scopes")
	case p.Scopes == access.FullAccess().String():
		parts = append(parts, "Full access")
	case p.Scopes == "":
		parts = append(parts, "No scopes")
	default:
		var grants []string
		for _, sc := range access.AllScopes {
			if l := r.Grants[sc]; l > access.None {
				grants = append(grants, string(sc)+" "+l.String())
			}
		}
		parts = append(parts, strings.Join(grants, ", "))
	}
	if p.RoleCap != "" {
		parts = append(parts, "at most "+p.RoleCap)
	}
	if p.ProductsRestricted {
		if n := len(p.ProductIDs); n == 1 {
			parts = append(parts, "1 product")
		} else {
			parts = append(parts, fmt.Sprintf("%d products", n))
		}
	}
	return strings.Join(parts, " · ")
}

// TokenCreated renders the raw token display after creation.
templ TokenCreated(rawToken string) {
	<div id="token-created-section">
		<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Token Created</h3>
		<div class="mt-4 rounded-md bg-amber-50 p-4 dark:bg-amber-900/30">
			<div class="flex items-center gap-2">
				<div class="shrink-0 text-amber-500">
					@ui.Icon("alert-triangle", "md")
				</div>
				<p class="text-sm font-medium text-amber-800 dark:text-amber-300">Copy this token now. You won't be able to see it again.</p>
			</div>
		</div>
		<div class="mt-4">
			<div class="flex items-center gap-2">
				<code id="raw-token-value" class="block flex-1 overflow-x-auto rounded-md bg-gray-100 px-3 py-2 font-mono text-sm dark:bg-gray-800 dark:text-gray-100">{ rawToken }</code>
				<button
					type="button"
					class="shrink-0 rounded-md bg-white p-2 text-gray-500 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-600 dark:hover:bg-gray-700"
					onclick="copyToken()"
					aria-label="Copy token"
				>
					@ui.Icon("copy", "sm")
				</button>
			</div>
			<p id="copy-feedback" class="mt-1 text-sm text-gray-500 dark:text-gray-400"></p>
		</div>
		<div class="mt-4 flex justify-end">
			<button type="button" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" onclick="window.location.reload()">
				Done
			</button>
		</div>
	</div>
}

templ copyTokenScript() {
	<script>
		function applyTokenPreset(button) {
			var grants = {};
			button.dataset.grants.split(' ').forEach(function(g) {
				var parts = g.split(':');
				if (parts.length === 2) { grants[parts[0]] = parts[1]; }
			});
			button.form.querySelectorAll('select[data-scope]').forEach(function(sel) {
				sel.value = grants[sel.dataset.scope] || 'none';
			});
		}
		function toggleTokenProducts() {
			var selected = document.querySelector('input[name="products_mode"][value="selected"]');
			document.getElementById('token-products').classList.toggle('hidden', !selected.checked);
		}
		function copyToken() {
			var token = document.getElementById('raw-token-value').textContent;
			navigator.clipboard.writeText(token).then(function() {
				document.getElementById('copy-feedback').textContent = 'Copied to clipboard!';
			}, function() {
				document.getElementById('copy-feedback').textContent = 'Copy failed. Please select and copy manually.';
			});
		}
	</script>
}

func formatDate(rfc3339 string) string {
	if len(rfc3339) >= 10 {
		return rfc3339[:10]
	}
	return rfc3339
}
