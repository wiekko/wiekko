package user

import (
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/ui"
	"nexmap.net/internal/model"
)

// ProfileProps holds the data for the user profile page.
type ProfileProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	User        *model.User
	TwoFactor   TwoFactorCardProps
}

templ ProfilePage(props ProfileProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "user-profile",
	}) {
		<div class="mx-auto max-w-3xl space-y-6">
			<!-- Breadcrumb -->
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: "Profile"},
			})
			<!-- Profile header -->
			<div class="flex items-center gap-4">
				@ui.UserAvatar(props.User.DisplayName, "lg")
				<div>
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{ props.User.DisplayName }</h1>
					<p class="text-sm text-gray-500 dark:text-gray-400">{ "@" + props.User.Username }</p>
				</div>
			</div>
			<!-- Edit profile -->
			@ProfileCard(props.User, "")
			<!-- Change password -->
			@PasswordCard("", false)
			<!-- Two-factor authentication -->
			@TwoFactorCard(props.TwoFactor)
			<!-- Theme preference -->
			@ui.Card() {
				@ui.CardHeader("Theme") {
				}
				@ui.CardBody() {
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm font-medium text-gray-900 dark:text-gray-100">Appearance</p>
							<p class="text-sm text-gray-500 dark:text-gray-400">Choose between light, dark, or system theme.</p>
						</div>
						@ui.ThemeToggle()
					</div>
				}
			}
			<!-- Danger zone -->
			@ui.Card() {
				<div class="border-b border-red-200 px-6 py-4 dark:border-red-800">
					<h3 class="text-base font-semibold text-red-700 dark:text-red-400">Danger Zone</h3>
				</div>
				@ui.CardBody() {
					<form
						class="flex flex-wrap items-end justify-between gap-4"
						hx-post="/user/profile/delete"
						{ ui.Confirm(ui.ConfirmDanger, "Delete account", "Delete account", "Delete your account and all data associated with it? This cannot be undone.")... }
					>
						<div>
							<p class="text-sm font-medium text-gray-900 dark:text-gray-100">Delete Account</p>
							<p class="text-sm text-gray-500 dark:text-gray-400">Permanently delete your account and all associated data. Enter your password to confirm.</p>
						</div>
						<div class="flex items-end gap-3">
							<div>
								<label for="delete-account-password" class="sr-only">Your password</label>
								<input
									type="password"
									id="delete-account-password"
									name="password"
									required
									autocomplete="current-password"
									placeholder="Your password"
									class="block w-48 rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-red-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
								/>
							</div>
							<button
								type="submit"
								class="inline-flex items-center gap-2 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
							>
								@ui.Icon("trash", "sm")
								Request Deletion
							</button>
						</div>
					</form>
				}
			}
		</div>
	}
}

// ProfileCard renders the profile edit form. Returned as fragment on htmx update.
templ ProfileCard(user *model.User, feedback string) {
	<div id="profile-card">
		@ui.Card() {
			@ui.CardHeader("Profile") {
			}
			@ui.CardBody() {
				<form class="space-y-4" hx-post="/user/profile" hx-target="#profile-card" hx-swap="outerHTML">
					@ui.TextInput(ui.InputProps{
						ID:    "profile-display-name",
						Name:  "display_name",
						Label: "Display Name",
						Value: user.DisplayName,
					})
					@ui.TextInput(ui.InputProps{
						ID:    "profile-email",
						Name:  "email",
						Label: "Email",
						Type:  "email",
						Value: user.Email,
					})
					@Feedback(feedback, false)
					<div class="flex justify-end">
						@ui.Button(ui.ButtonProps{
							Label:   "Save Changes",
							Variant: "primary",
							Size:    "md",
							Type:    "submit",
						})
					</div>
				</form>
			}
		}
	</div>
}

// PasswordCard renders the password change form. Returned as fragment on htmx update.
templ PasswordCard(feedback string, isError bool) {
	<div id="password-card">
		@ui.Card() {
			@ui.CardHeader("Change Password") {
			}
			@ui.CardBody() {
				<form class="space-y-4" hx-post="/user/profile/password" hx-target="#password-card" hx-swap="outerHTML">
					@ui.TextInput(ui.InputProps{
						ID:       "current-password",
						Name:     "old_password",
						Label:    "Current Password",
						Type:     "password",
						Required: true,
					})
					@ui.TextInput(ui.InputProps{
						ID:       "new-password",
						Name:     "new_password",
						Label:    "New Password",
						Type:     "password",
						Required: true,
					})
					@ui.TextInput(ui.InputProps{
						ID:       "confirm-password",
						Name:     "confirm_password",
						Label:    "Confirm New Password",
						Type:     "password",
						Required: true,
					})
					@Feedback(feedback, isError)
					<div class="flex justify-end">
						@ui.Button(ui.ButtonProps{
							Label:   "Change Password",
							Variant: "primary",
							Size:    "md",
							Type:    "submit",
						})
					</div>
				</form>
			}
		}
	</div>
}

// Feedback renders an inline success or error message.
templ Feedback(message string, isError bool) {
	if message != "" {
		if isError {
			<p class="text-sm text-red-600 dark:text-red-400">{ message }</p>
		} else {
			<p class="text-sm text-emerald-700 dark:text-emerald-400">{ message }</p>
		}
	}
}

// HeaderUserInfoOOB renders an out-of-band swap to update the header display name.
templ HeaderUserInfoOOB(displayName string) {
	<span id="header-user-info" class="flex items-center gap-2" hx-swap-oob="true">
		@ui.UserAvatar(displayName, "sm")
		<span>{ displayName }</span>
	</span>
}
