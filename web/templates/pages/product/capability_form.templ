package product

import (
	"strings"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// CapabilityFormProps holds data for the capability create/edit form.
type CapabilityFormProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
	Capability  *model.Capability // nil for create
	Components  []*model.Component
	Milestones  []*model.Milestone
	IsEdit      bool
	Error       string
	ReturnTo    string // "list" to return to list after save; empty = detail
	// LinkTo, when non-empty, switches the form into modal/htmx mode and
	// makes the POST handler create-and-link rather than just create.
	// Format: "<entity>:<id>", e.g. "requirement:abc-123".
	LinkTo string
	// Form values (preserved on validation error).
	Name        string
	Description string
	ComponentID string
	MilestoneID string
}

templ CapabilityFormPage(props CapabilityFormProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "capabilities",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="mx-auto max-w-2xl space-y-6">
			@ui.Breadcrumb(capabilityFormBreadcrumbs(props))
			<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
				if props.IsEdit {
					Edit Capability
				} else {
					New Capability
				}
			</h1>
			@patterns.FormError(props.Error)
			@CapabilityFormBody(props)
		</div>
	}
}

// CapabilityFormModal wraps the form body in a modal dialog. Used by tab
// actions where we want create-and-link without leaving the parent page.
templ CapabilityFormModal(props CapabilityFormProps) {
	@ui.Modal("capability-form-modal", capabilityModalTitle(props), "lg") {
		@patterns.FormError(props.Error)
		@CapabilityFormBody(props)
	}
}

// CapabilityFormBody renders the inner form (Card + form fields) without any
// page chrome. It is shared between the standalone page and the modal.
templ CapabilityFormBody(props CapabilityFormProps) {
	@ui.Card() {
		@ui.CardBody() {
			<form
				method="post"
				action={ templ.SafeURL(capabilityFormAction(props)) }
				if props.LinkTo != "" {
					hx-post={ capabilityFormAction(props) }
					hx-target="#modal"
					hx-swap="innerHTML"
				}
				class="space-y-6"
			>
				<input type="hidden" name="_csrf" value={ props.Meta.CSRFToken }/>
				if props.Capability != nil {
					// The version being edited: a change saved meanwhile is reported
					// as a conflict instead of being overwritten.
					<input type="hidden" name="updated_at" value={ props.Capability.UpdatedAt }/>
				}
				if props.ReturnTo != "" {
					<input type="hidden" name="return" value={ props.ReturnTo }/>
				}
				if props.LinkTo != "" {
					<input type="hidden" name="link_to" value={ props.LinkTo }/>
				}
				@ui.TextInput(ui.InputProps{
					ID:          "name",
					Name:        "name",
					Label:       "Name",
					Value:       props.Name,
					Placeholder: "e.g. User Login",
					Required:    true,
				})
				@ui.TextArea(ui.TextAreaProps{
					ID:          "description",
					Name:        "description",
					Label:       "Description",
					Value:       props.Description,
					Placeholder: "Describe this capability...",
					Rows:        4,
				})
				@ui.Select(ui.SelectProps{
					ID:       "component_id",
					Name:     "component_id",
					Label:    "Component",
					Value:    props.ComponentID,
					Options:  componentSelectOptions(props.Components),
					HelpText: "Optional. Assign to a component or leave as top-level.",
				})
				@ui.Select(ui.SelectProps{
					ID:       "milestone_id",
					Name:     "milestone_id",
					Label:    "Milestone",
					Value:    props.MilestoneID,
					Options:  milestoneSelectOptions(props.Milestones),
					HelpText: "Optional. Link this capability to a milestone.",
				})
				if props.LinkTo != "" {
					@capabilityModalActions(capabilitySubmitLabel(props.IsEdit))
				} else {
					@patterns.FormActions(capabilitySubmitLabel(props.IsEdit), "/products/"+props.Product.ID+"/capabilities")
				}
			</form>
		}
	}
}

// capabilityModalActions renders submit + cancel buttons for the modal mode.
templ capabilityModalActions(submitLabel string) {
	<div class="flex items-center justify-end gap-3 pt-4">
		@ui.ModalCancelButton("modal")
		@ui.Button(ui.ButtonProps{
			Label:   submitLabel,
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
	</div>
}

func capabilityFormBreadcrumbs(props CapabilityFormProps) []templates.BreadcrumbItem {
	crumbs := []templates.BreadcrumbItem{
		{Label: "Dashboard", Href: "/"},
		{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
		{Label: "Capabilities", Href: "/products/" + props.Product.ID + "/capabilities"},
	}
	if props.IsEdit {
		crumbs = append(crumbs,
			templates.BreadcrumbItem{Label: props.Capability.Name, Href: "/products/" + props.Product.ID + "/capabilities/" + props.Capability.ID},
			templates.BreadcrumbItem{Label: "Edit"},
		)
	} else {
		crumbs = append(crumbs, templates.BreadcrumbItem{Label: "New"})
	}
	return crumbs
}

func capabilityFormAction(props CapabilityFormProps) string {
	if props.IsEdit {
		return "/products/" + props.Product.ID + "/capabilities/" + props.Capability.ID
	}
	if reqID, ok := strings.CutPrefix(props.LinkTo, "requirement:"); ok {
		return "/products/" + props.Product.ID + "/requirements/" + reqID + "/capabilities"
	}
	if compID, ok := strings.CutPrefix(props.LinkTo, "component:"); ok {
		return "/products/" + props.Product.ID + "/components/" + compID + "/capabilities"
	}
	if conID, ok := strings.CutPrefix(props.LinkTo, "constraint:"); ok {
		return "/products/" + props.Product.ID + "/constraints/" + conID + "/capabilities"
	}
	return "/products/" + props.Product.ID + "/capabilities"
}

func capabilitySubmitLabel(isEdit bool) string {
	if isEdit {
		return "Save Changes"
	}
	return "Create Capability"
}

func capabilityModalTitle(props CapabilityFormProps) string {
	if props.IsEdit {
		return "Edit Capability"
	}
	return "New Capability"
}

// componentSelectOptions builds select options from components with an empty "None" option.
func componentSelectOptions(components []*model.Component) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(components)+1)
	opts = append(opts, templates.SelectOption{Value: "", Label: "None (top-level)"})
	for _, c := range components {
		opts = append(opts, templates.SelectOption{Value: c.ID, Label: c.Name})
	}
	return opts
}
