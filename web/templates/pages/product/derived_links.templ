package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// Derived links (UR-160) follow the product structure one step:
// component → capability → requirement → task. They are read-only and name
// what they come through, so they are never mistaken for a link someone
// made; the stored link is changed on the page named in "via".

// DerivedComponent is a component reached through the named capabilities.
type DerivedComponent struct {
	Component *model.Component
	Via       []*model.Capability
}

// DerivedRequirement is a requirement linked to the named capabilities of a
// component.
type DerivedRequirement struct {
	Requirement *model.Requirement
	Identifier  string
	Via         []*model.Capability
}

// DerivedDefect is a defect linked to the named capabilities of a component,
// but not to the component itself.
type DerivedDefect struct {
	Defect *model.Defect
	Via    []*model.Capability
}

// InheritedCapabilities are the capabilities of the requirement a task
// refines, its nearest requirement ancestor.
type InheritedCapabilities struct {
	SourceIdentifier string
	SourcePath       string
	Capabilities     []*model.Capability
	ComponentNames   map[string]string // capability ID → component name
}

templ viaCapabilities(productID string, caps []*model.Capability) {
	<span class="text-gray-500 dark:text-gray-400">
		via
		for i, cap := range caps {
			if i > 0 {
				{ ", " }
			}
			<a
				href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", productID, cap.ID)) }
				class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
			>
				{ cap.Name }
			</a>
		}
	</span>
}



// ComponentRequirementsTabProps holds data for a component's Requirements
// tab: the requirements of its capabilities.
type ComponentRequirementsTabProps struct {
	ProductID    string
	Requirements []DerivedRequirement
	Statuses map[string]*model.Status // status ID → status, for the Status column (UC-90)
}

templ ComponentRequirementsTabContent(props ComponentRequirementsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Requirements)) }>
		<p class="text-sm text-gray-500 dark:text-gray-400">
			Requirements linked to this component's capabilities. Link or unlink them on the capability.
		</p>
		if len(props.Requirements) == 0 {
			@ui.Card() {
				@ui.EmptyState("list", "No requirements", "Requirements linked to this component's capabilities will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Status
						}
						@ui.TableHeader() {
							Via
						}
					}
					@ui.TableBody("") {
						for _, d := range props.Requirements {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									<span class="whitespace-nowrap">{ d.Identifier }</span>
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(backlogChildHref(props.ProductID, d.Requirement)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ d.Requirement.Title }
									</a>
									if d.Requirement.Archived() {
										<span class="ml-2 align-middle">
											@patterns.ArchivedBadge(true)
										</span>
									}
								}
								@ui.TableCellMuted() {
									@patterns.WorkflowStatusBadge(props.Statuses, d.Requirement.StatusID)
								}
								@ui.TableCellMuted() {
									@viaCapabilities(props.ProductID, d.Via)
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// derivedDefectsSection lists, below a component's own defects, those linked
// to its capabilities.
templ derivedDefectsSection(productID string, defects []DerivedDefect, statuses map[string]*model.Status) {
	if len(defects) > 0 {
		<div class="space-y-2" data-derived="defects">
			<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Via capabilities</h3>
			<p class="text-xs text-gray-500 dark:text-gray-400">Linked to this component's capabilities; unlink them there.</p>
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Criticality
						}
						@ui.TableHeader() {
							Status
						}
						@ui.TableHeader() {
							Via
						}
					}
					@ui.TableBody("") {
						for _, d := range defects {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									<span class="whitespace-nowrap">{ d.Defect.Identifier }</span>
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", productID, d.Defect.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ d.Defect.Title }
									</a>
									if d.Defect.Archived() {
										<span class="ml-2 align-middle">
											@patterns.ArchivedBadge(true)
										</span>
									}
								}
								@ui.TableCellMuted() {
									@patterns.CriticalityBadge(d.Defect.Criticality)
								}
								@ui.TableCellMuted() {
									@patterns.WorkflowStatusBadge(statuses, d.Defect.StatusID)
								}
								@ui.TableCellMuted() {
									@viaCapabilities(productID, d.Via)
								}
							}
						}
					}
				}
			}
		</div>
	}
}

// ViaRequirement names a requirement a derived item comes through.
type ViaRequirement struct {
	Identifier string
	Href       string
}

// AffectedItem is a component or capability that a milestone's requirements
// touch without it being planned for the milestone itself (UR-161).
type AffectedItem struct {
	Name string
	Href string
	Via  []ViaRequirement
}

// affectedSection lists, below what is planned for a milestone, the parts
// of the product its requirements affect. Planning happens in the section
// above; this one only reads.
templ affectedSection(items []AffectedItem, noun string) {
	if len(items) > 0 {
		<div class="space-y-2" data-derived="affected">
			<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Affected via requirements</h3>
			<p class="text-xs text-gray-500 dark:text-gray-400">
				{ "Not planned for this milestone, but linked to its requirements through their capabilities. Link a " + noun + " above to plan it." }
			</p>
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						@ui.TableHeader() {
							Via
						}
					}
					@ui.TableBody("") {
						for _, it := range items {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(it.Href) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ it.Name }
									</a>
								}
								@ui.TableCellMuted() {
									<span class="text-gray-500 dark:text-gray-400">
										via
										for i, v := range it.Via {
											if i > 0 {
												{ ", " }
											}
											<a
												href={ templ.SafeURL(v.Href) }
												class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
											>
												{ v.Identifier }
											</a>
										}
									</span>
								}
							}
						}
					}
				}
			}
		</div>
	}
}
