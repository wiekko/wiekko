package product

import (
	"nexmap.net/internal/model"
	"nexmap.net/web/templates/patterns"
)

// workflowStatusField renders the Status field of a requirement, defect or task
// detail page, so the badge matches the one in the corresponding list.
templ workflowStatusField(s *model.Status) {
	@patterns.DetailFieldSlot("Status") {
		if s != nil {
			@patterns.StatusBadge(s.Name, s.IsDefault, s.IsClosed)
		} else {
			@patterns.StatusBadge("", false, false)
		}
	}
}
