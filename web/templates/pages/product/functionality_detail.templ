package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// FunctionalityDetailProps holds data for the functionality detail page.
type FunctionalityDetailProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Functionality  *model.Functionality
	ComponentName  string
	MilestoneName  string
	IsOwnerOrAdmin bool
}

templ FunctionalityDetailPage(props FunctionalityDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "functionalities",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Functionalities", Href: "/products/" + props.Product.ID + "/functionalities"},
					{Label: props.Functionality.Name},
				},
				props.Functionality.Name,
				functionalitySubtitle(props.ComponentName),
				functionalityEditHref(props),
				functionalityDeleteURL(props),
				props.Meta.CSRFToken,
			)
			<!-- Tabs -->
			@ui.TabGroup(functionalityDetailTabs(props.Product.ID, props.Functionality.ID))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@FunctionalityOverviewTabContent(props.Product.ID, props.Functionality, props.ComponentName, props.MilestoneName)
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("defects") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ FunctionalityOverviewTabContent(productID string, f *model.Functionality, componentName, milestoneName string) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Component", functionalityComponentDisplay(componentName))
				@patterns.DetailField("Milestone", componentMilestoneDisplay(milestoneName))
				@patterns.DetailField("Created", formatDate(f.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(f.UpdatedAt))
			}
			@patterns.DetailDescription(f.Description)
		}
	}
}

templ FunctionalityTestCasesTabContent() {
	@ui.Card() {
		@ui.EmptyState("beaker", "No test cases", "Test cases linked to this functionality will appear here.", "", "")
	}
}

templ FunctionalityDefectsTabContent() {
	@ui.Card() {
		@ui.EmptyState("bug", "No defects", "Defects linked to this functionality will appear here.", "", "")
	}
}

templ FunctionalityHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this functionality will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// FunctionalityDeleteConfirmation renders the delete confirmation for a functionality.
templ FunctionalityDeleteConfirmation(name, productID, functionalityID string) {
	@patterns.DeleteConfirmation("functionality", fmt.Sprintf("/products/%s/functionalities/%s", productID, functionalityID))
}

func functionalityDetailTabs(productID, functionalityID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/functionalities/%s/tabs", productID, functionalityID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "test-cases", Label: "Test Cases", HxGet: base + "/test-cases"},
		{ID: "defects", Label: "Defects", HxGet: base + "/defects"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func functionalitySubtitle(componentName string) string {
	if componentName != "" {
		return "Part of " + componentName
	}
	return "Top-level functionality"
}

func functionalityEditHref(props FunctionalityDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/functionalities/" + props.Functionality.ID + "/edit"
	}
	return ""
}

func functionalityDeleteURL(props FunctionalityDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/functionalities/" + props.Functionality.ID
	}
	return ""
}

func functionalityComponentDisplay(name string) string {
	if name == "" {
		return "None (top-level)"
	}
	return name
}
