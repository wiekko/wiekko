package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/ui"
)

// SettingsProps holds data for the product settings page.
type SettingsProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
}

templ SettingsPage(props SettingsProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "settings",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Settings"},
			})
			<div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Settings</h1>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Changes are saved automatically.</p>
			</div>
			@ui.TabGroup([]templates.TabDef{
				{ID: "general", Label: "General", HxGet: "/products/" + props.Product.ID + "/settings/general", Active: true},
				{ID: "categories", Label: "Categories", HxGet: "/products/" + props.Product.ID + "/settings/categories"},
				{ID: "statuses", Label: "Statuses", HxGet: "/products/" + props.Product.ID + "/settings/statuses"},
				{ID: "environments", Label: "Environments", HxGet: "/products/" + props.Product.ID + "/settings/environments"},
				{ID: "pyramid", Label: "Pyramid Levels", HxGet: "/products/" + props.Product.ID + "/settings/pyramid"},
			})
			@ui.TabPanel("general") {
				@GeneralTabContent(props.Product)
			}
			@ui.TabPanelHidden("categories") {
			}
			@ui.TabPanelHidden("statuses") {
			}
			@ui.TabPanelHidden("environments") {
			}
			@ui.TabPanelHidden("pyramid") {
			}
			<!-- Danger Zone -->
			<div class="mt-8 border-t border-red-200 pt-6 dark:border-red-800">
				<h2 class="text-lg font-semibold text-red-600 dark:text-red-400">Danger Zone</h2>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Permanently delete this product and all its data.</p>
				<div class="mt-4">
					<button
						type="button"
						class="inline-flex items-center gap-2 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-get={ "/products/" + props.Product.ID + "/delete/confirm" }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						@ui.Icon("trash", "sm")
						Delete Product
					</button>
				</div>
			</div>
		</div>
	}
}

// GeneralTabContent renders the auto-save fields for the General settings tab.
templ GeneralTabContent(p *model.Product) {
	<div class="space-y-6">
		@ui.Card() {
			@ui.CardBody() {
				<div class="space-y-6">
					@settingTextField(p.ID, "name", "Name", p.Name)
					@settingTextArea(p.ID, "description", "Description", p.Description)
					@settingSelect(p.ID, "estimation_mode", "Estimation Mode", estimationModeOptions(p.EstimationMode))
					@settingSelect(p.ID, "workflow_mode", "Workflow Mode", workflowModeOptions(p.WorkflowMode))
					@settingTextFieldHint(p.ID, "defect_prefix", "Defect Identifier Prefix", p.DefectPrefix, defectPrefixHint)
					@settingTextFieldHint(p.ID, "document_prefix", "Document Identifier Prefix", p.DocumentPrefix, documentPrefixHint)
					@settingTwoFactorToggle(p)
				</div>
			}
		}
	</div>
}

const twoFactorRequiredHint = "Members without two-factor authentication cannot open this product until they set it up. Access tokens are not affected."

// settingTwoFactorToggle renders the "2FA required" switch (SC-107).
templ settingTwoFactorToggle(p *model.Product) {
	<div
		id="setting-two_factor_required"
		class="flex items-center justify-between gap-4"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div>
			<p id="two_factor_required-label" class="text-sm font-medium text-gray-700 dark:text-gray-300">Require two-factor authentication</p>
			<p class="text-sm text-gray-500 dark:text-gray-400">{ twoFactorRequiredHint }</p>
		</div>
		<button
			type="button"
			role="switch"
			aria-labelledby="two_factor_required-label"
			aria-checked={ boolString(p.TwoFactorRequired) }
			class={ "relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900", templ.KV("bg-indigo-600", p.TwoFactorRequired), templ.KV("bg-gray-200 dark:bg-gray-700", !p.TwoFactorRequired) }
			hx-patch={ "/products/" + p.ID + "/settings" }
			hx-vals={ `{"field":"two_factor_required","value":"` + boolString(!p.TwoFactorRequired) + `"}` }
		>
			<span class={ "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition-transform dark:bg-gray-200", templ.KV("translate-x-5", p.TwoFactorRequired), templ.KV("translate-x-0", !p.TwoFactorRequired) }></span>
		</button>
	</div>
}

func boolString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

const defectPrefixHint = "Defects are numbered like DF-17. Changing the prefix renames every defect identifier; it must differ from all category prefixes and the document prefix."

const documentPrefixHint = "Documents are numbered like DOC-3. Changing the prefix renames every document identifier; it must differ from all category prefixes and the defect prefix."

// StubTabContent renders a placeholder for unimplemented settings tabs.
templ StubTabContent(name string) {
	<div class="py-12 text-center">
		<div class="text-gray-400 dark:text-gray-500">
			@ui.Icon("construction", "lg")
		</div>
		<p class="mt-2 text-sm font-medium text-gray-500 dark:text-gray-400">{ name } configuration coming soon.</p>
	</div>
}

// --- Categories Tab ---

// CategoriesTabContent renders the Categories settings tab. Requirements, tasks
// and constraints each keep their own set.
templ CategoriesTabContent(productID string, reqCats, taskCats, conCats []*model.Category, usage map[string]int) {
	<div class="space-y-8">
		<div>
			<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Requirement Categories</h3>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">The prefix forms the identifier of every requirement in the category (e.g. FR-12). Prefixes must be unique across the whole product.</p>
			<div class="mt-4">
				@CategoryListFragment(productID, model.RequirementKindRequirement, reqCats, usage)
			</div>
		</div>
		<div>
			<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Task Categories</h3>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Tasks carry no product statement, so they use their own prefixes (e.g. MT-18).</p>
			<div class="mt-4">
				@CategoryListFragment(productID, model.RequirementKindTask, taskCats, usage)
			</div>
		</div>
		<div>
			<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Constraint Categories</h3>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Constraints are ongoing rules rather than work items, and number independently (e.g. AC-42).</p>
			<div class="mt-4">
				@CategoryListFragment(productID, "constraint", conCats, usage)
			</div>
		</div>
	</div>
}

// CategoryListFragment renders the category list for a single entity type.
templ CategoryListFragment(productID, entityType string, cats []*model.Category, usage map[string]int) {
	<div id={ "category-list-" + entityType } hx-target="this" hx-swap="outerHTML">
		@ui.Card() {
			if len(cats) > 0 {
				<ul class="divide-y divide-gray-200 dark:divide-gray-700">
					for i, c := range cats {
						@categoryRow(productID, c, "category-list-"+entityType, usage[c.ID], i == 0, i == len(cats)-1, len(cats) == 1)
					}
				</ul>
			} else {
				<div class="px-6 py-8 text-center">
					<div class="text-gray-400 dark:text-gray-500">
						@ui.Icon("tags", "lg")
					</div>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">No { entityType } categories defined yet.</p>
				</div>
			}
			<div class="border-t border-gray-200 px-6 py-4 dark:border-gray-700">
				<form class="flex items-center gap-3" hx-post={ "/products/" + productID + "/settings/categories" } hx-target={ "#category-list-" + entityType } hx-swap="outerHTML">
					<input type="hidden" name="entity_type" value={ entityType }/>
					<input
						type="text"
						name="name"
						placeholder="New category name"
						required
						class="block flex-1 rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					/>
					<input
						type="text"
						name="prefix"
						placeholder="Prefix"
						required
						maxlength="6"
						pattern="[A-Za-z][A-Za-z0-9]{0,5}"
						title="1-6 letters or digits, starting with a letter"
						class="block w-24 rounded-md border-0 px-3 py-2 text-sm uppercase text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 placeholder:normal-case focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					/>
					<button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
						@ui.Icon("plus", "sm")
						Add
					</button>
				</form>
			</div>
		}
	</div>
}

templ categoryRow(productID string, c *model.Category, targetID string, count int, isFirst, isLast, isOnly bool) {
	<li class="flex items-center gap-3 px-6 py-3">
		<input
			type="text"
			name="name"
			value={ c.Name }
			class="block flex-1 rounded-md border-0 px-3 py-1.5 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings/categories/" + c.ID }
			hx-target={ "#" + targetID }
			hx-swap="outerHTML"
			hx-trigger="change"
		/>
		<input
			type="text"
			name="prefix"
			value={ c.Prefix }
			maxlength="6"
			pattern="[A-Za-z][A-Za-z0-9]{0,5}"
			title="1-6 letters or digits, starting with a letter"
			class="block w-24 rounded-md border-0 px-3 py-1.5 text-sm uppercase text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings/categories/" + c.ID }
			hx-target={ "#" + targetID }
			hx-swap="outerHTML"
			hx-trigger="change"
			if count > 0 {
				hx-confirm={ prefixRenameWarning(c, count) }
			}
		/>
		<span class="w-20 shrink-0 text-right text-xs text-gray-500 dark:text-gray-400">{ categoryUsageLabel(count) }</span>
		<div class="flex items-center gap-0.5">
			<button
				type="button"
				class="rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
				disabled?={ isFirst }
				aria-label="Move up"
				title="Move up"
				hx-post={ "/products/" + productID + "/settings/categories/" + c.ID + "/move" }
				hx-vals='{"direction":"up"}'
				hx-target={ "#" + targetID }
				hx-swap="outerHTML"
			>
				@ui.Icon("chevron-up", "sm")
			</button>
			<button
				type="button"
				class="rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
				disabled?={ isLast }
				aria-label="Move down"
				title="Move down"
				hx-post={ "/products/" + productID + "/settings/categories/" + c.ID + "/move" }
				hx-vals='{"direction":"down"}'
				hx-target={ "#" + targetID }
				hx-swap="outerHTML"
			>
				@ui.Icon("chevron-down", "sm")
			</button>
		</div>
		<button
			type="button"
			class="rounded p-1 text-gray-400 hover:bg-red-50 hover:text-red-600 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-gray-400 dark:hover:bg-red-900/30 dark:hover:text-red-400"
			disabled?={ count > 0 || isOnly }
			title={ categoryDeleteHint(c, count, isOnly) }
			hx-delete={ "/products/" + productID + "/settings/categories/" + c.ID }
			hx-target={ "#" + targetID }
			hx-swap="outerHTML"
			hx-confirm={ "Delete category \"" + c.Name + "\"?" }
		>
			@ui.Icon("trash", "sm")
		</button>
	</li>
}

// prefixRenameWarning explains what a prefix change does to items that already
// exist. Identifiers are rendered from the category's current prefix, so a rename
// relabels every item retroactively.
func prefixRenameWarning(c *model.Category, count int) string {
	return fmt.Sprintf(
		"Renaming this prefix relabels %s: every identifier currently starting with %s- changes to the new prefix. "+
			"References to the old identifiers in commit messages, specifications and exports will no longer match. Continue?",
		pluralItems(count), c.Prefix)
}

func categoryUsageLabel(count int) string {
	if count == 0 {
		return "unused"
	}
	return pluralItems(count)
}

func categoryDeleteHint(c *model.Category, count int, isOnly bool) string {
	switch {
	case count > 0:
		return fmt.Sprintf("Cannot delete: %s still assigned to this category", pluralItems(count))
	case isOnly:
		return fmt.Sprintf("Cannot delete the last %s category", c.EntityType)
	default:
		return "Delete category"
	}
}

func pluralItems(count int) string {
	if count == 1 {
		return "1 item"
	}
	return fmt.Sprintf("%d items", count)
}

// --- Statuses Tab ---

// StatusesTabContent renders the Statuses settings tab.
templ StatusesTabContent(productID string, statusSync bool, reqStatuses, defStatuses []*model.Status) {
	if statusSync {
		<div class="space-y-6">
			<div>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Statuses</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Define workflow columns for requirements and defects. Changes apply to both.</p>
				@activeColumnsHint()
				<div class="mt-4">
					@SyncedStatusListFragment(productID, reqStatuses)
				</div>
			</div>
			<div class="border-t border-amber-200 pt-6 dark:border-amber-800">
				<h3 class="text-base font-semibold text-amber-600 dark:text-amber-400">Separate Statuses</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Split requirement and defect statuses into independent sets. This action is permanent and cannot be undone.</p>
				<div class="mt-3">
					<button
						type="button"
						class="inline-flex items-center gap-2 rounded-md bg-amber-600 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ "/products/" + productID + "/settings/statuses/split" }
						hx-confirm="This will permanently separate requirement and defect statuses into independent sets. This action cannot be undone. Continue?"
						hx-target="#tab-panel-statuses"
						hx-swap="innerHTML"
					>
						@ui.Icon("split", "sm")
						Split Statuses
					</button>
				</div>
			</div>
		</div>
	} else {
		<div class="space-y-8">
			<div>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Requirement Statuses</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Define workflow columns for requirements.</p>
				@activeColumnsHint()
				<div class="mt-4">
					@StatusListFragment(productID, "requirement", reqStatuses)
				</div>
			</div>
			<div>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Defect Statuses</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Define workflow columns for defects.</p>
				<div class="mt-4">
					@StatusListFragment(productID, "defect", defStatuses)
				</div>
			</div>
		</div>
	}
}

// SyncedStatusListFragment renders the unified status list when statuses are synced.
templ SyncedStatusListFragment(productID string, statuses []*model.Status) {
	<div id="status-list-synced" hx-target="this" hx-swap="outerHTML">
		@ui.Card() {
			if len(statuses) > 0 {
				<ul class="divide-y divide-gray-200 dark:divide-gray-700">
					for i, s := range statuses {
						@statusRow(productID, s, "status-list-synced", i == 0, i == len(statuses)-1)
					}
				</ul>
			} else {
				<div class="px-6 py-8 text-center">
					<div class="text-gray-400 dark:text-gray-500">
						@ui.Icon("columns-3", "lg")
					</div>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">No statuses defined yet.</p>
				</div>
			}
			<div class="border-t border-gray-200 px-6 py-4 dark:border-gray-700">
				<form class="flex items-center gap-3" hx-post={ "/products/" + productID + "/settings/statuses" } hx-target="#status-list-synced" hx-swap="outerHTML">
					<input type="hidden" name="entity_type" value="requirement"/>
					<input
						type="text"
						name="name"
						placeholder="New status name"
						required
						class="block flex-1 rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					/>
					<label class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-400">
						<input type="checkbox" name="is_closed" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"/>
						Closed
					</label>
					<label class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-400" title={ activeColumnTitle }>
						<input type="checkbox" name="is_active" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"/>
						Active
					</label>
					<button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
						@ui.Icon("plus", "sm")
						Add
					</button>
				</form>
			</div>
		}
	</div>
}

// StatusListFragment renders the status list for a single entity type (requirement or defect).
templ StatusListFragment(productID, entityType string, statuses []*model.Status) {
	<div id={ "status-list-" + entityType } hx-target="this" hx-swap="outerHTML">
		@ui.Card() {
			if len(statuses) > 0 {
				<ul class="divide-y divide-gray-200 dark:divide-gray-700">
					for i, s := range statuses {
						@statusRow(productID, s, "status-list-" + entityType, i == 0, i == len(statuses)-1)
					}
				</ul>
			} else {
				<div class="px-6 py-8 text-center">
					<div class="text-gray-400 dark:text-gray-500">
						@ui.Icon("columns-3", "lg")
					</div>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">No { entityType } statuses defined yet.</p>
				</div>
			}
			<div class="border-t border-gray-200 px-6 py-4 dark:border-gray-700">
				<form class="flex items-center gap-3" hx-post={ "/products/" + productID + "/settings/statuses" } hx-target={ "#status-list-" + entityType } hx-swap="outerHTML">
					<input type="hidden" name="entity_type" value={ entityType }/>
					<input
						type="text"
						name="name"
						placeholder="New status name"
						required
						class="block flex-1 rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					/>
					<label class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-400">
						<input type="checkbox" name="is_closed" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"/>
						Closed
					</label>
					<label class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-400" title={ activeColumnTitle }>
						<input type="checkbox" name="is_active" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"/>
						Active
					</label>
					<button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
						@ui.Icon("plus", "sm")
						Add
					</button>
				</form>
			</div>
		}
	</div>
}

templ statusRow(productID string, s *model.Status, targetID string, isFirst, isLast bool) {
	<li class="flex items-center gap-3 px-6 py-3">
		<input
			type="text"
			name="name"
			value={ s.Name }
			class="block flex-1 rounded-md border-0 px-3 py-1.5 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings/statuses/" + s.ID }
			hx-target={ "#" + targetID }
			hx-swap="outerHTML"
			hx-trigger="change"
		/>
		@statusFlagToggle(productID, s, targetID, "is_default", "Default", s.IsDefault, "New items start in this column")
		@statusFlagToggle(productID, s, targetID, "is_closed", "Closed", s.IsClosed, "Items in this column count as finished")
		@statusFlagToggle(productID, s, targetID, "is_active", "Active", s.IsActive, activeColumnTitle)
		<div class="flex items-center gap-0.5">
			<button
				type="button"
				class="rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
				disabled?={ isFirst }
				aria-label="Move up"
				title="Move up"
				hx-post={ "/products/" + productID + "/settings/statuses/" + s.ID + "/move" }
				hx-vals='{"direction":"up"}'
				hx-target={ "#" + targetID }
				hx-swap="outerHTML"
			>
				@ui.Icon("chevron-up", "sm")
			</button>
			<button
				type="button"
				class="rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200"
				disabled?={ isLast }
				aria-label="Move down"
				title="Move down"
				hx-post={ "/products/" + productID + "/settings/statuses/" + s.ID + "/move" }
				hx-vals='{"direction":"down"}'
				hx-target={ "#" + targetID }
				hx-swap="outerHTML"
			>
				@ui.Icon("chevron-down", "sm")
			</button>
		</div>
		<button
			type="button"
			class="rounded p-1 text-gray-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-900/30 dark:hover:text-red-400"
			hx-delete={ "/products/" + productID + "/settings/statuses/" + s.ID }
			hx-target={ "#" + targetID }
			hx-swap="outerHTML"
			hx-confirm={ "Delete status \"" + s.Name + "\"?" }
		>
			@ui.Icon("trash", "sm")
		</button>
	</li>
}

// --- Environments Tab ---

// EnvironmentsTabContent renders the Environments settings tab.
templ EnvironmentsTabContent(productID string, envs []*model.RuntimeEnvironment) {
	<div>
		<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Runtime Environments</h3>
		<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Labels for the test execution matrix (e.g. OS, browser, platform).</p>
		<div class="mt-4">
			@EnvironmentListFragment(productID, envs)
		</div>
	</div>
}

// EnvironmentListFragment renders the environment list.
templ EnvironmentListFragment(productID string, envs []*model.RuntimeEnvironment) {
	<div id="environment-list" hx-target="this" hx-swap="outerHTML">
		@ui.Card() {
			if len(envs) > 0 {
				<ul class="divide-y divide-gray-200 dark:divide-gray-700">
					for _, e := range envs {
						<li class="flex items-center justify-between px-6 py-3">
							<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ e.Name }</span>
							<button
								type="button"
								class="rounded p-1 text-gray-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-900/30 dark:hover:text-red-400"
								hx-delete={ "/products/" + productID + "/settings/environments/" + e.ID }
								hx-target="#environment-list"
								hx-swap="outerHTML"
								hx-confirm={ "Delete environment \"" + e.Name + "\"?" }
							>
								@ui.Icon("trash", "sm")
							</button>
						</li>
					}
				</ul>
			} else {
				<div class="px-6 py-8 text-center">
					<div class="text-gray-400 dark:text-gray-500">
						@ui.Icon("monitor", "lg")
					</div>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">No runtime environments defined yet.</p>
				</div>
			}
			<div class="border-t border-gray-200 px-6 py-4 dark:border-gray-700">
				<form class="flex items-center gap-3" hx-post={ "/products/" + productID + "/settings/environments" } hx-target="#environment-list" hx-swap="outerHTML">
					<input
						type="text"
						name="name"
						placeholder="e.g. Chrome, Linux, iOS 17"
						required
						class="block flex-1 rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					/>
					<button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
						@ui.Icon("plus", "sm")
						Add
					</button>
				</form>
			</div>
		}
	</div>
}

// --- Pyramid Levels Tab ---

// PyramidTabContent renders the Pyramid Levels settings tab.
templ PyramidTabContent(productID string, levels []*model.PyramidLevel) {
	<div>
		<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Pyramid Levels</h3>
		<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Test pyramid categorization (e.g. unit, integration, system, acceptance). Max depth: 2.</p>
		<div class="mt-4">
			@PyramidListFragment(productID, levels)
		</div>
	</div>
}

// PyramidListFragment renders the pyramid level tree.
templ PyramidListFragment(productID string, levels []*model.PyramidLevel) {
	<div id="pyramid-list" hx-target="this" hx-swap="outerHTML">
		@ui.Card() {
			if len(levels) > 0 {
				<ul class="divide-y divide-gray-200 dark:divide-gray-700">
					for _, l := range levels {
						if l.ParentID == "" {
							@pyramidRow(productID, l, false)
							for _, child := range levels {
								if child.ParentID == l.ID {
									@pyramidRow(productID, child, true)
								}
							}
						}
					}
				</ul>
			} else {
				<div class="px-6 py-8 text-center">
					<div class="text-gray-400 dark:text-gray-500">
						@ui.Icon("triangle", "lg")
					</div>
					<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">No pyramid levels defined yet.</p>
				</div>
			}
			<div class="border-t border-gray-200 px-6 py-4 dark:border-gray-700">
				<form class="flex items-center gap-3" hx-post={ "/products/" + productID + "/settings/pyramid" } hx-target="#pyramid-list" hx-swap="outerHTML">
					<input
						type="text"
						name="name"
						placeholder="New top-level (e.g. Unit, Integration)"
						required
						class="block flex-1 rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					/>
					<button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
						@ui.Icon("plus", "sm")
						Add
					</button>
				</form>
			</div>
		}
	</div>
}

templ pyramidRow(productID string, l *model.PyramidLevel, isChild bool) {
	<li class={ "flex items-center gap-3 px-6 py-3", templ.KV("pl-12", isChild) }>
		if isChild {
			<span class="text-gray-300 dark:text-gray-600">
				@ui.Icon("corner-down-right", "sm")
			</span>
		}
		<input
			type="text"
			name="name"
			value={ l.Name }
			class="block flex-1 rounded-md border-0 px-3 py-1.5 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings/pyramid/" + l.ID }
			hx-target="#pyramid-list"
			hx-swap="outerHTML"
			hx-trigger="change"
		/>
		if l.ParentID == "" {
			<form class="flex items-center gap-1.5" hx-post={ "/products/" + productID + "/settings/pyramid" } hx-target="#pyramid-list" hx-swap="outerHTML">
				<input type="hidden" name="parent_id" value={ l.ID }/>
				<input
					type="text"
					name="name"
					placeholder="Add sub-level"
					required
					class="w-36 rounded-md border-0 px-2 py-1.5 text-xs text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
				/>
				<button type="submit" class="rounded p-1 text-gray-400 hover:bg-indigo-50 hover:text-indigo-600 dark:hover:bg-indigo-900/30 dark:hover:text-indigo-400" title="Add sub-level">
					@ui.Icon("plus", "sm")
				</button>
			</form>
		}
		<button
			type="button"
			class="rounded p-1 text-gray-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-900/30 dark:hover:text-red-400"
			hx-delete={ "/products/" + productID + "/settings/pyramid/" + l.ID }
			hx-target="#pyramid-list"
			hx-swap="outerHTML"
			hx-confirm={ "Delete level \"" + l.Name + "\"?" }
		>
			@ui.Icon("trash", "sm")
		</button>
	</li>
}

// SettingField renders a single auto-save field fragment (used after PATCH update).
templ SettingField(p *model.Product, field string) {
	switch field {
		case "name":
			@settingTextField(p.ID, "name", "Name", p.Name)
		case "description":
			@settingTextArea(p.ID, "description", "Description", p.Description)
		case "estimation_mode":
			@settingSelect(p.ID, "estimation_mode", "Estimation Mode", estimationModeOptions(p.EstimationMode))
		case "workflow_mode":
			@settingSelect(p.ID, "workflow_mode", "Workflow Mode", workflowModeOptions(p.WorkflowMode))
		case "defect_prefix":
			@settingTextFieldHint(p.ID, "defect_prefix", "Defect Identifier Prefix", p.DefectPrefix, defectPrefixHint)
		case "document_prefix":
			@settingTextFieldHint(p.ID, "document_prefix", "Document Identifier Prefix", p.DocumentPrefix, documentPrefixHint)
		case "two_factor_required":
			@settingTwoFactorToggle(p)
	}
}

templ settingTextField(productID, field, label, value string) {
	@settingTextFieldHint(productID, field, label, value, "")
}

// settingTextFieldHint is settingTextField with a help text below the input.
templ settingTextFieldHint(productID, field, label, value, hint string) {
	<div
		id={ "setting-" + field }
		class="space-y-1"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<label for={ field } class="block text-sm font-medium text-gray-700 dark:text-gray-300">{ label }</label>
		<input
			type="text"
			id={ field }
			name="value"
			value={ value }
			class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings" }
			hx-include="this"
			hx-vals={ `{"field":"` + field + `"}` }
			hx-trigger="change"
			if hint != "" {
				aria-describedby={ field + "-hint" }
			}
		/>
		if hint != "" {
			<p id={ field + "-hint" } class="text-sm text-gray-500 dark:text-gray-400">{ hint }</p>
		}
	</div>
}

templ settingTextArea(productID, field, label, value string) {
	<div
		id={ "setting-" + field }
		class="space-y-1"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<label for={ field } class="block text-sm font-medium text-gray-700 dark:text-gray-300">{ label }</label>
		<textarea
			id={ field }
			name="value"
			rows="3"
			class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings" }
			hx-include="this"
			hx-vals={ `{"field":"` + field + `"}` }
			hx-trigger="change"
		>{ value }</textarea>
	</div>
}

templ settingSelect(productID, field, label string, options []templates.SelectOption) {
	<div
		id={ "setting-" + field }
		class="space-y-1"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<label for={ field } class="block text-sm font-medium text-gray-700 dark:text-gray-300">{ label }</label>
		<select
			id={ field }
			name="value"
			class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch={ "/products/" + productID + "/settings" }
			hx-include="this"
			hx-vals={ `{"field":"` + field + `"}` }
			hx-trigger="change"
		>
			for _, opt := range options {
				<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
			}
		</select>
	</div>
}

// activeColumnTitle explains the Active flag where it is set.
const activeColumnTitle = "Kanban: items here are activated for work, so developers can move them on. Only owners move items into an active column."

// activeColumnsHint explains active columns on the statuses tab.
templ activeColumnsHint() {
	<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
		In kanban mode, items in an <span class="font-medium text-gray-700 dark:text-gray-300">active</span> column are
		activated for work: developers can move them to any column. Items in other columns can only be moved by product
		owners, so moving an item into an active column is how an owner activates it. In scrum mode, planning an item into a
		sprint activates it instead.
	</p>
}

// statusFlagToggle renders one flag checkbox of a status row. It sends the
// new value explicitly: an unchecked checkbox submits nothing, which the
// handler would read as "unchanged".
templ statusFlagToggle(productID string, s *model.Status, targetID, field, label string, checked bool, title string) {
	<label class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400" title={ title }>
		<input
			type="checkbox"
			checked?={ checked }
			class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-900"
			hx-patch={ "/products/" + productID + "/settings/statuses/" + s.ID }
			hx-vals={ statusFlagVals(field, !checked) }
			hx-target={ "#" + targetID }
			hx-swap="outerHTML"
			hx-trigger="change"
		/>
		{ label }
	</label>
}

func statusFlagVals(field string, on bool) string {
	value := "off"
	if on {
		value = "on"
	}
	return `{"` + field + `":"` + value + `"}`
}
