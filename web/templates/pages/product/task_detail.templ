package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// TaskDetailProps holds data for the task detail page.
//
// There are no capability, test case or defect tabs: tasks are not traced to
// the product specification and are not acceptance-tested.
type TaskDetailProps struct {
	Meta             templates.PageMeta
	DisplayName      string
	IsAdmin          bool
	Product          *model.Product
	Task             *model.Requirement
	CategoryPrefixes map[string]string // task category ID → prefix
	CategoryNames    map[string]string // task category ID → name
	Status           *model.Status
	MilestoneName    string
	SprintName       string
	ParentName       string // display name of the parent backlog item
	ParentIdentifier string // e.g. "FR-1" or "MT-3"
	ParentPath       string // detail URL of the parent, whichever kind it is
	Children         []*model.Requirement
	CanEdit          bool
	TabCounts map[string]int // tab ID → number of linked items (UC-88)
	// Assignees are shown in the header and the Overview (UR-171).
	Assignees patterns.AssigneesProps
}

templ TaskDetailPage(props TaskDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "tasks",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Tasks", Href: "/products/" + props.Product.ID + "/tasks"},
					{Label: taskIdentifier(props)},
				},
				props.Task.Title,
				taskIdentifier(props),
				taskEditHref(props),
				taskDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@patterns.CategoryBadge(requirementPrefix(props.CategoryPrefixes, props.Task.CategoryID), model.RequirementKindTask)
				@patterns.AssigneeMenu(props.Assignees)
				@patterns.ArchiveControls(taskArchiveProps(props))
			}
			<!-- Tabs -->
			@ui.TabGroup(templates.WithCounts(taskDetailTabs(props.Product.ID, props.Task.ID), props.TabCounts))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@TaskOverviewTabContent(props)
			}
			@ui.TabPanelHidden("children") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ TaskOverviewTabContent(props TaskDetailProps) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Identifier", taskIdentifier(props))
				@patterns.DetailFieldSlot("Category") {
					@patterns.CategoryField(requirementPrefix(props.CategoryPrefixes, props.Task.CategoryID), requirementCategoryName(props.CategoryNames, props.Task.CategoryID), model.RequirementKindTask)
				}
				if props.Task.ParentID != "" && props.ParentName != "" {
					@requirementLinkedField("Parent", props.ParentIdentifier+" — "+props.ParentName, props.ParentPath)
				} else {
					@patterns.DetailField("Parent", "")
				}
				@workflowStatusField(props.Status)
				@patterns.AssigneeField(props.Assignees.Assigned)
				if props.Task.MilestoneID != "" && props.MilestoneName != "" {
					@requirementLinkedField("Milestone", props.MilestoneName, fmt.Sprintf("/products/%s/milestones/%s", props.Product.ID, props.Task.MilestoneID))
				} else {
					@patterns.DetailField("Milestone", "")
				}
				if props.Product.WorkflowMode == model.WorkflowModeScrum {
					@patterns.DetailField("Sprint", props.SprintName)
				}
				if props.Product.EstimationMode != model.EstimationModeDisabled {
					@patterns.DetailField("Estimation", formatEstimation(props.Product.EstimationMode, props.Task.Estimation))
				}
				@patterns.DetailFieldSlot("Priority") {
					@patterns.PriorityBadge(props.Task.Priority)
				}
				@patterns.DetailField("Coarse", boolDisplay(props.Task.IsCoarse))
				@patterns.DetailField("Active", boolDisplay(props.Task.IsActive))
				@patterns.DetailField("Created", formatDate(props.Task.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(props.Task.UpdatedAt))
			}
			@patterns.DetailDescription(props.Task.Description)
		}
	}
}

templ TaskHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this task will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// TaskDeleteConfirmation renders the delete confirmation for a task.
templ TaskDeleteConfirmation(name, productID, taskID, csrfToken string, children []patterns.ChildItem, keepTarget string) {
	@patterns.DeleteWithChildrenConfirmation("task", name, fmt.Sprintf("/products/%s/tasks/%s", productID, taskID), csrfToken, children, keepTarget)
}

func taskDetailTabs(productID, taskID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/tasks/%s/tabs", productID, taskID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "children", Label: "Children", HxGet: base + "/children"},
		{ID: "capabilities", Label: "Capabilities", HxGet: base + "/capabilities"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

// backlogChildHref links a child backlog item to the page for its own kind: a
// requirement can be refined into child tasks, which live under /tasks.
func backlogChildHref(productID string, child *model.Requirement) string {
	if child.Kind == model.RequirementKindTask {
		return fmt.Sprintf("/products/%s/tasks/%s", productID, child.ID)
	}
	return fmt.Sprintf("/products/%s/requirements/%s", productID, child.ID)
}

func taskIdentifier(props TaskDetailProps) string {
	return model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Task.CategoryID), props.Task.SequenceNumber)
}

func taskEditHref(props TaskDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/tasks/" + props.Task.ID + "/edit"
	}
	return ""
}

func taskDeleteURL(props TaskDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/tasks/" + props.Task.ID
	}
	return ""
}

// taskArchiveProps describes the task's archived state for its page header
// (FR-155).
func taskArchiveProps(props TaskDetailProps) patterns.ArchiveProps {
	return patterns.ArchiveProps{
		ItemURL:     fmt.Sprintf("/products/%s/tasks/%s", props.Product.ID, props.Task.ID),
		Kind:        "task",
		Name:        ui.ItemName(taskIdentifier(props), props.Task.Title),
		Archived:    props.Task.Archived(),
		Closed:      props.Status != nil && props.Status.IsClosed,
		HasChildren: len(props.Children) > 0,
		CanArchive:  props.CanEdit,
	}
}
