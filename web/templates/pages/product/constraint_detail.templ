package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// ConstraintDetailProps holds data for the constraint detail page.
type ConstraintDetailProps struct {
	Meta             templates.PageMeta
	DisplayName      string
	IsAdmin          bool
	Product          *model.Product
	Constraint       *model.Constraint
	CategoryPrefixes map[string]string // category ID → prefix
	CategoryNames    map[string]string // category ID → name
	MilestoneName    string
	CanEdit          bool
	TabCounts map[string]int // tab ID → number of linked items (UC-88)
}

templ ConstraintDetailPage(props ConstraintDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "constraints",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Constraints", Href: "/products/" + props.Product.ID + "/constraints"},
					{Label: model.EntityIdentifier(constraintPrefix(props.CategoryPrefixes, props.Constraint.CategoryID), props.Constraint.SequenceNumber)},
				},
				props.Constraint.Title,
				model.EntityIdentifier(constraintPrefix(props.CategoryPrefixes, props.Constraint.CategoryID), props.Constraint.SequenceNumber),
				constraintEditHref(props),
				constraintDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@patterns.CategoryBadge(constraintPrefix(props.CategoryPrefixes, props.Constraint.CategoryID), "constraint")
				@patterns.ComplianceMenu(ConstraintComplianceURL(props.Product.ID, props.Constraint.ID), props.Constraint.ComplianceState, props.CanEdit)
			}
			<!-- Tabs -->
			@ui.TabGroup(templates.WithCounts(constraintDetailTabs(props.Product.ID, props.Constraint.ID), props.TabCounts))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@ConstraintOverviewTabContent(props)
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("documents") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ ConstraintOverviewTabContent(props ConstraintDetailProps) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Identifier", model.EntityIdentifier(constraintPrefix(props.CategoryPrefixes, props.Constraint.CategoryID), props.Constraint.SequenceNumber))
				@patterns.DetailFieldSlot("Category") {
					@patterns.CategoryField(constraintPrefix(props.CategoryPrefixes, props.Constraint.CategoryID), constraintCategoryName(props.CategoryNames, props.Constraint.CategoryID), "constraint")
				}
				<div>
					<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Compliance</dt>
					<dd id={ patterns.ComplianceFieldID } class="mt-1 text-sm text-gray-900 dark:text-gray-100">
						@patterns.ComplianceBadge(props.Constraint.ComplianceState)
					</dd>
				</div>
				if props.Constraint.MilestoneID != "" && props.MilestoneName != "" {
					@constraintLinkedField("Milestone", props.MilestoneName, fmt.Sprintf("/products/%s/milestones/%s", props.Product.ID, props.Constraint.MilestoneID))
				} else {
					@patterns.DetailField("Milestone", "")
				}
				@patterns.DetailFieldSlot("Priority") {
					@patterns.PriorityBadge(props.Constraint.Priority)
				}
				@patterns.DetailField("Created", formatDate(props.Constraint.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(props.Constraint.UpdatedAt))
			}
			@patterns.DetailDescription(props.Constraint.Description)
		}
	}
}

templ constraintLinkedField(label, name, href string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if name != "" {
				<a
					href={ templ.SafeURL(href) }
					class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
				>
					{ name }
				</a>
			} else {
				<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
			}
		</dd>
	</div>
}

// ConstraintCapabilitiesTabProps holds data for the constraint capabilities tab.
type ConstraintCapabilitiesTabProps struct {
	ProductID    string
	ConstraintID string
	CSRFToken    string
	CanWrite     bool
	Capabilities []*model.Capability
}

templ ConstraintCapabilitiesTabContent(props ConstraintCapabilitiesTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Capabilities)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/constraints/%s/capabilities/link-modal", props.ProductID, props.ConstraintID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/constraints/%s/capabilities/create-modal", props.ProductID, props.ConstraintID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Capabilities) == 0 {
			@ui.Card() {
				@ui.EmptyState("layers", "No linked capabilities", "Capabilities linked to this constraint will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, cap := range props.Capabilities {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", props.ProductID, cap.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ cap.Name }
									</a>
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink capability"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/constraints/%s/capabilities/%s", props.ProductID, props.ConstraintID, cap.ID) }
											hx-target="#tab-panel-capabilities"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink capability", "Unlink", "Unlink capability "+ui.ItemName("", cap.Name)+" from this constraint?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ ConstraintCapabilityLinkModal(productID, constraintID string) {
	@ui.Modal("capability-link-modal", "Link existing capability", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search capabilities..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/constraints/%s/capabilities/link-search", productID, constraintID) }
					hx-target="#capability-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="capability-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ ConstraintCapabilityLinkResults(productID, constraintID string, candidates []*model.Capability) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching capabilities.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, cap := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ cap.Name }</p>
						if cap.Description != "" {
							<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ cap.Description }</p>
						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/constraints/%s/capabilities/link", productID, constraintID) }
						hx-vals={ fmt.Sprintf(`{"capability_id":"%s"}`, cap.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

templ ConstraintHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this constraint will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// ConstraintDeleteConfirmation renders the delete confirmation for a constraint.
templ ConstraintDeleteConfirmation(name, productID, constraintID, csrfToken string) {
	@patterns.DeleteConfirmation("constraint", name, fmt.Sprintf("/products/%s/constraints/%s", productID, constraintID), csrfToken)
}

func constraintDetailTabs(productID, constraintID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/constraints/%s/tabs", productID, constraintID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "capabilities", Label: "Capabilities", HxGet: base + "/capabilities"},
		{ID: "test-cases", Label: "Test Cases", HxGet: base + "/test-cases"},
		{ID: "documents", Label: "Documents", HxGet: base + "/documents"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func constraintEditHref(props ConstraintDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/constraints/" + props.Constraint.ID + "/edit"
	}
	return ""
}

func constraintDeleteURL(props ConstraintDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/constraints/" + props.Constraint.ID
	}
	return ""
}

func constraintCategoryName(names map[string]string, categoryID string) string {
	if names != nil {
		if n, ok := names[categoryID]; ok {
			return n
		}
	}
	return "Unknown"
}

// ConstraintComplianceURL is where the page header's compliance menu sets a
// constraint's compliance (UR-168).
func ConstraintComplianceURL(productID, constraintID string) string {
	return "/products/" + productID + "/constraints/" + constraintID + "/compliance"
}
