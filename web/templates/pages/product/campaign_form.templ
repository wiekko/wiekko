package product

import (
	"fmt"
	"strings"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// CampaignTestCaseOption is one selectable row in the scope picker. The names
// are resolved server-side so the picker can filter without another round trip.
type CampaignTestCaseOption struct {
	TestCase       *model.TestCase
	ComponentName  string
	CapabilityName string
	PyramidName    string
	Selected       bool
}

// CampaignFormProps holds data for the campaign create/edit form.
type CampaignFormProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
	Campaign    *model.TestingCampaign // nil for create
	IsEdit      bool
	Error       string
	ReturnTo    string // "list" to return to the list after save; empty = detail
	// TestCases is the pool the scope is chosen from. Empty on edit, where
	// scope is managed on the campaign itself.
	TestCases []CampaignTestCaseOption
	// The filter dropdowns are built from these; all three are empty on edit.
	Components    []*model.Component
	Capabilities  []*model.Capability
	PyramidLevels []*model.PyramidLevel
	// Form values (preserved on validation error).
	Name        string
	Description string
	StartsAt    string
	EndsAt      string
}

templ CampaignFormPage(props CampaignFormProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "campaigns",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="mx-auto max-w-3xl space-y-6">
			@ui.Breadcrumb(campaignFormBreadcrumbs(props))
			<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
				if props.IsEdit {
					Edit Campaign
				} else {
					New Campaign
				}
			</h1>
			@patterns.FormError(props.Error)
			@CampaignFormBody(props)
		</div>
	}
}

// CampaignFormBody renders the inner form without page chrome.
templ CampaignFormBody(props CampaignFormProps) {
	@ui.Card() {
		@ui.CardBody() {
			<form
				method="post"
				action={ templ.SafeURL(campaignFormAction(props)) }
				class="space-y-6"
			>
				<input type="hidden" name="_csrf" value={ props.Meta.CSRFToken }/>
				if props.Campaign != nil {
					// The version being edited: a change saved meanwhile is reported
					// as a conflict instead of being overwritten.
					<input type="hidden" name="updated_at" value={ props.Campaign.UpdatedAt }/>
				}
				if props.ReturnTo != "" {
					<input type="hidden" name="return" value={ props.ReturnTo }/>
				}
				@ui.TextInput(ui.InputProps{
					ID:          "name",
					Name:        "name",
					Label:       "Name",
					Value:       props.Name,
					Placeholder: "e.g. Release 1.0 regression",
					Required:    true,
				})
				@ui.TextArea(ui.TextAreaProps{
					ID:          "description",
					Name:        "description",
					Label:       "Description",
					Value:       props.Description,
					Placeholder: "What is this campaign for?",
					Rows:        3,
				})
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					@ui.DateInput(ui.InputProps{
						ID:       "starts_at",
						Name:     "starts_at",
						Label:    "Planned Start",
						Value:    formatDate(props.StartsAt),
						HelpText: "Optional.",
					})
					@ui.DateInput(ui.InputProps{
						ID:       "ends_at",
						Name:     "ends_at",
						Label:    "Planned End",
						Value:    formatDate(props.EndsAt),
						HelpText: "Optional.",
					})
				</div>
				if !props.IsEdit {
					@campaignScopePicker(props)
				}
				@patterns.FormActions(campaignSubmitLabel(props.IsEdit), campaignFormCancelHref(props))
			</form>
		}
	}
}

// campaignScopePicker renders the test case selection (FR-94, UC-84).
// Filtering and select-all run in the browser so a filter change never discards
// selections made under a previous filter.
templ campaignScopePicker(props CampaignFormProps) {
	<div class="border-t border-gray-200 pt-6 dark:border-gray-700">
		<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Test Cases</h3>
		<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
			Pick the test cases this campaign covers. Shift-click a second row to select
			everything in between. The selection is fixed once the campaign is created.
		</p>
		if len(props.TestCases) == 0 {
			<div class="mt-4">
				@ui.EmptyState("beaker", "No test cases", "Create test cases before scheduling a campaign.", "New Test Case", "/products/"+props.Product.ID+"/test-cases/new")
			</div>
		} else {
			<div id="campaign-picker" class="mt-4 space-y-3" data-campaign-picker>
				@patterns.FilterBarStatic() {
					@ui.TextInput(ui.InputProps{
						ID:          "picker-search",
						Label:       "Search",
						Placeholder: "Filter by title…",
					})
					@ui.Select(ui.SelectProps{
						ID:      "picker-component",
						Label:   "Component",
						Options: campaignPickerComponentOptions(props.Components),
					})
					@ui.Select(ui.SelectProps{
						ID:      "picker-capability",
						Label:   "Capability",
						Options: campaignPickerCapabilityOptions(props.Capabilities),
					})
					@ui.Select(ui.SelectProps{
						ID:      "picker-pyramid",
						Label:   "Pyramid Level",
						Options: campaignPickerPyramidOptions(props.PyramidLevels),
					})
					@ui.Select(ui.SelectProps{
						ID:      "picker-mode",
						Label:   "Execution Mode",
						Options: campaignPickerModeOptions(),
					})
				}
				<div class="flex flex-wrap items-center justify-between gap-3">
					<p class="text-sm text-gray-500 dark:text-gray-400">
						// Rendered with real values so a re-render after a failed
						// submission doesn't flash "0 selected" over checked rows.
						<span data-picker-count>{ fmt.Sprintf("%d", campaignSelectedCount(props.TestCases)) }</span>
						of { fmt.Sprintf("%d", len(props.TestCases)) } selected
						· <span data-picker-shown>{ fmt.Sprintf("%d", len(props.TestCases)) }</span> shown
					</p>
					<div class="flex items-center gap-2">
						@ui.Button(ui.ButtonProps{
							Label:   "Select shown",
							Variant: "secondary",
							Size:    "sm",
							Attrs:   templ.Attributes{"data-picker-select-all": true},
						})
						@ui.Button(ui.ButtonProps{
							Label:   "Clear shown",
							Variant: "secondary",
							Size:    "sm",
							Attrs:   templ.Attributes{"data-picker-clear": true},
						})
					</div>
				</div>
				<div class="max-h-96 overflow-y-auto rounded-md border border-gray-200 dark:border-gray-700">
					<ul class="divide-y divide-gray-200 dark:divide-gray-700">
						for _, opt := range props.TestCases {
							<li
								data-picker-row
								data-component={ opt.TestCase.ComponentID }
								data-capability={ opt.TestCase.CapabilityID }
								data-pyramid={ opt.TestCase.PyramidLevelID }
								data-mode={ opt.TestCase.ExecutionMode }
								data-title={ strings.ToLower(opt.TestCase.Title) }
							>
								<label class="flex cursor-pointer items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800">
									<input
										type="checkbox"
										name="test_case_ids"
										value={ opt.TestCase.ID }
										checked?={ opt.Selected }
										class="mt-1 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600 dark:border-gray-600 dark:bg-gray-800"
									/>
									<div class="min-w-0">
										<p class="text-sm font-medium text-gray-900 dark:text-gray-100">{ opt.TestCase.Title }</p>
										@campaignScopeMeta(opt)
									</div>
								</label>
							</li>
						}
						// Component and Capability are independent optional fields on a
						// test case, so ANDing two named values legitimately matches
						// nothing. Say so rather than showing an empty box.
						<li data-picker-empty hidden class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">
							No test cases match these filters.
						</li>
					</ul>
				</div>
			</div>
			<script src="/static/js/campaign-picker.js" defer></script>
		}
	</div>
}

// campaignScopeMeta renders a row's second line as two tiers: where the test
// case sits in the product (plain text) and what kind of test it is (badges).
// The picker can filter on all four, so all four have to be visible.
templ campaignScopeMeta(opt CampaignTestCaseOption) {
	<div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1">
		<span class="text-xs text-gray-500 dark:text-gray-400">{ campaignScopeLocation(opt) }</span>
		if opt.PyramidName != "" {
			@ui.Badge(opt.PyramidName, "indigo")
		}
		@patterns.ExecutionModeBadge(opt.TestCase.ExecutionMode)
	</div>
}

// campaignScopeLocation names where the test case sits. Component and capability
// are independent optional fields, so both are shown when both are set —
// "Product level" describes the pair being empty and never accompanies a name.
func campaignScopeLocation(opt CampaignTestCaseOption) string {
	parts := make([]string, 0, 2)
	if opt.ComponentName != "" {
		parts = append(parts, opt.ComponentName)
	}
	if opt.CapabilityName != "" {
		parts = append(parts, opt.CapabilityName)
	}
	if len(parts) == 0 {
		return "Product level"
	}
	return strings.Join(parts, " · ")
}

func campaignPickerComponentOptions(components []*model.Component) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(components)+2)
	opts = append(opts, templates.SelectOption{Value: "", Label: "All components"})
	// "No component" rather than "Product level": a test case with no component
	// may still have a capability, and the row subtitle reserves "Product level"
	// for having neither.
	opts = append(opts, templates.SelectOption{Value: "__none__", Label: "No component"})
	for _, c := range components {
		opts = append(opts, templates.SelectOption{Value: c.ID, Label: c.Name})
	}
	return opts
}

// campaignSelectedCount seeds the "N of M selected" line so it is already
// correct in the HTML, before the picker script runs.
func campaignSelectedCount(opts []CampaignTestCaseOption) int {
	n := 0
	for _, opt := range opts {
		if opt.Selected {
			n++
		}
	}
	return n
}

func campaignPickerCapabilityOptions(capabilities []*model.Capability) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(capabilities)+2)
	opts = append(opts, templates.SelectOption{Value: "", Label: "All capabilities"})
	opts = append(opts, templates.SelectOption{Value: "__none__", Label: "No capability"})
	for _, c := range capabilities {
		opts = append(opts, templates.SelectOption{Value: c.ID, Label: c.Name})
	}
	return opts
}

func campaignPickerPyramidOptions(levels []*model.PyramidLevel) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(levels)+2)
	opts = append(opts, templates.SelectOption{Value: "", Label: "All levels"})
	opts = append(opts, templates.SelectOption{Value: "__none__", Label: "Unassigned"})
	for _, l := range levels {
		opts = append(opts, templates.SelectOption{Value: l.ID, Label: l.Name})
	}
	return opts
}

func campaignPickerModeOptions() []templates.SelectOption {
	return []templates.SelectOption{
		{Value: "", Label: "All modes"},
		{Value: model.ExecutionModeManual, Label: "Manual"},
		{Value: model.ExecutionModeAutomatic, Label: "Automatic"},
	}
}

func campaignFormBreadcrumbs(props CampaignFormProps) []templates.BreadcrumbItem {
	crumbs := []templates.BreadcrumbItem{
		{Label: "Dashboard", Href: "/"},
		{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
		{Label: "Campaigns", Href: "/products/" + props.Product.ID + "/campaigns"},
	}
	if props.IsEdit {
		crumbs = append(crumbs,
			templates.BreadcrumbItem{Label: props.Campaign.Name, Href: fmt.Sprintf("/products/%s/campaigns/%s", props.Product.ID, props.Campaign.ID)},
			templates.BreadcrumbItem{Label: "Edit"},
		)
	} else {
		crumbs = append(crumbs, templates.BreadcrumbItem{Label: "New"})
	}
	return crumbs
}

func campaignFormAction(props CampaignFormProps) string {
	if props.IsEdit {
		return fmt.Sprintf("/products/%s/campaigns/%s", props.Product.ID, props.Campaign.ID)
	}
	return "/products/" + props.Product.ID + "/campaigns"
}

func campaignFormCancelHref(props CampaignFormProps) string {
	if props.IsEdit {
		return fmt.Sprintf("/products/%s/campaigns/%s", props.Product.ID, props.Campaign.ID)
	}
	return "/products/" + props.Product.ID + "/campaigns"
}

func campaignSubmitLabel(isEdit bool) string {
	if isEdit {
		return "Save Changes"
	}
	return "Create Campaign"
}
