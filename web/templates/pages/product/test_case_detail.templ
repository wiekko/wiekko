package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// TestCaseDetailProps holds data for the test case detail page.
type TestCaseDetailProps struct {
	Meta              templates.PageMeta
	DisplayName       string
	IsAdmin           bool
	Product           *model.Product
	TestCase          *model.TestCase
	ComponentName     string
	CapabilityName    string
	PyramidLevelName  string
	EnvironmentNames  []string
	CanEdit           bool // developer, owner, or admin
	TabCounts map[string]int // tab ID → number of linked items (UC-88)
}

templ TestCaseDetailPage(props TestCaseDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "test-cases",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Test Cases", Href: "/products/" + props.Product.ID + "/test-cases"},
					{Label: props.TestCase.Title},
				},
				props.TestCase.Title,
				"",
				testCaseEditHref(props),
				testCaseDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@executionModeBadge(props.TestCase.ExecutionMode)
			}
			<!-- Tabs -->
			@ui.TabGroup(templates.WithCounts(testCaseDetailTabs(props.Product.ID, props.TestCase.ID), props.TabCounts))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@TestCaseOverviewTabContent(props.Product.ID, props.TestCase, props.ComponentName, props.CapabilityName, props.PyramidLevelName, props.EnvironmentNames)
			}
			@ui.TabPanelHidden("requirements") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("documents") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("campaigns") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ TestCaseOverviewTabContent(productID string, tc *model.TestCase, componentName, capabilityName, pyramidLevelName string, environmentNames []string) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Execution Mode", testCaseModeDisplay(tc.ExecutionMode))
				@patterns.DetailField("Test Identifier", testCaseIdentifierDisplay(tc.TestIdentifier))
				if tc.ComponentID != "" {
					@testCaseLinkedField("Component", componentName, fmt.Sprintf("/products/%s/components/%s", productID, tc.ComponentID))
				} else {
					@patterns.DetailField("Component", "")
				}
				if tc.CapabilityID != "" {
					@testCaseLinkedField("Capability", capabilityName, fmt.Sprintf("/products/%s/capabilities/%s", productID, tc.CapabilityID))
				} else {
					@patterns.DetailField("Capability", "")
				}
				@patterns.DetailField("Pyramid Level", pyramidLevelName)
				@testCaseEnvironmentsField(environmentNames)
				@patterns.DetailField("Created", formatDate(tc.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(tc.UpdatedAt))
			}
			@patterns.DetailDescription(tc.Description)
		}
	}
}

// testCaseEnvironmentsField lists the runtime environments the test case runs
// in. Each one becomes a column of the campaign matrix (FR-25).
templ testCaseEnvironmentsField(names []string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Environments</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if len(names) == 0 {
				<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
			} else {
				<div class="flex flex-wrap gap-1">
					for _, name := range names {
						@ui.Badge(name, "gray")
					}
				</div>
			}
		</dd>
	</div>
}

templ testCaseLinkedField(label, name, href string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if name != "" {
				<a
					href={ templ.SafeURL(href) }
					class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
				>
					{ name }
				</a>
			} else {
				<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
			}
		</dd>
	</div>
}

// TestCaseRequirementsTabProps holds data for the test-case requirements tab.
type TestCaseRequirementsTabProps struct {
	ProductID        string
	TestCaseID       string
	CSRFToken        string
	CanWrite         bool
	Requirements     []*model.Requirement
	CategoryPrefixes map[string]string // category ID → prefix
}

templ TestCaseRequirementsTabContent(props TestCaseRequirementsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Requirements)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/test-cases/%s/requirements/link-modal", props.ProductID, props.TestCaseID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/test-cases/%s/requirements/create-modal", props.ProductID, props.TestCaseID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Requirements) == 0 {
			@ui.Card() {
				@ui.EmptyState("clipboard-list", "No linked requirements", "Requirements linked to this test case will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, req := range props.Requirements {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									{ model.EntityIdentifier(testCasePrefix(props.CategoryPrefixes, req.CategoryID), req.SequenceNumber) }
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/requirements/%s", props.ProductID, req.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ req.Title }
									</a>
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink requirement"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/test-cases/%s/requirements/%s", props.ProductID, props.TestCaseID, req.ID) }
											hx-target="#tab-panel-requirements"
											hx-swap="innerHTML"
											hx-confirm="Unlink this requirement from the test case?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ TestCaseRequirementLinkModal(productID, testCaseID string) {
	@ui.Modal("requirement-link-modal", "Link existing requirement", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search requirements..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/test-cases/%s/requirements/link-search", productID, testCaseID) }
					hx-target="#requirement-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="requirement-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ TestCaseRequirementLinkResults(productID, testCaseID string, candidates []*model.Requirement, prefixes map[string]string) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching requirements.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, req := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">
							{ model.EntityIdentifier(testCasePrefix(prefixes, req.CategoryID), req.SequenceNumber) } &mdash; { req.Title }
						</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/test-cases/%s/requirements/link", productID, testCaseID) }
						hx-vals={ fmt.Sprintf(`{"requirement_id":"%s"}`, req.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

func testCasePrefix(prefixes map[string]string, categoryID string) string {
	if prefixes != nil {
		if p, ok := prefixes[categoryID]; ok {
			return p
		}
	}
	return "??"
}

// TestCaseCampaignResultView is one row of a test case's campaign history.
type TestCaseCampaignResultView struct {
	Result       *model.CampaignResult
	CampaignName string
	Environment  string
	ExecutedBy   string
	DefectTitle  string
}

// TestCaseCampaignsTabProps holds a test case's results across campaigns.
type TestCaseCampaignsTabProps struct {
	ProductID string
	Results   []TestCaseCampaignResultView
}

templ TestCaseCampaignsTabContent(props TestCaseCampaignsTabProps) {
	if len(props.Results) == 0 {
		@ui.Card() {
			@ui.EmptyState("flag", "No campaigns", "Campaign results for this test case will appear here.", "", "")
		}
	} else {
		@ui.Card() {
			@ui.Table() {
				@ui.TableHead() {
					@ui.TableHeader() {
						Campaign
					}
					@ui.TableHeader() {
						Environment
					}
					@ui.TableHeader() {
						Status
					}
					@ui.TableHeader() {
						Defect
					}
					@ui.TableHeader() {
						Tested By
					}
					@ui.TableHeader() {
						Tested
					}
				}
				@ui.TableBody("") {
					for _, view := range props.Results {
						@ui.TableRow("") {
							@ui.TableCell() {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/products/%s/campaigns/%s", props.ProductID, view.Result.CampaignID)) }
									class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
								>
									{ view.CampaignName }
								</a>
							}
							@ui.TableCellMuted() {
								if view.Environment != "" {
									{ view.Environment }
								} else {
									<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
								}
							}
							@ui.TableCellMuted() {
								<span class="inline-flex items-center gap-1">
									@campaignResultIcon(view.Result.Status)
									{ campaignResultLabel(view.Result.Status) }
								</span>
							}
							@ui.TableCellMuted() {
								if view.Result.DefectID != "" {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", props.ProductID, view.Result.DefectID)) }
										class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ view.DefectTitle }
									</a>
								} else {
									<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
								}
							}
							@ui.TableCellMuted() {
								if view.ExecutedBy != "" {
									{ view.ExecutedBy }
								} else {
									<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
								}
							}
							@ui.TableCellMuted() {
								if view.Result.ExecutedAt != "" {
									{ formatDate(view.Result.ExecutedAt) }
								} else {
									<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
								}
							}
						}
					}
				}
			}
		}
	}
}

templ TestCaseHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this test case will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// TestCaseDeleteConfirmation renders the delete confirmation for a test case.
templ TestCaseDeleteConfirmation(name, productID, testCaseID, csrfToken string) {
	@patterns.DeleteConfirmation("test case", name, fmt.Sprintf("/products/%s/test-cases/%s", productID, testCaseID), csrfToken)
}

func testCaseDetailTabs(productID, testCaseID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/test-cases/%s/tabs", productID, testCaseID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "requirements", Label: "Requirements", HxGet: base + "/requirements"},
		{ID: "documents", Label: "Documents", HxGet: base + "/documents"},
		{ID: "campaigns", Label: "Campaigns", HxGet: base + "/campaigns"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func testCaseEditHref(props TestCaseDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/test-cases/" + props.TestCase.ID + "/edit"
	}
	return ""
}

func testCaseDeleteURL(props TestCaseDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/test-cases/" + props.TestCase.ID
	}
	return ""
}

func testCaseModeDisplay(mode string) string {
	if mode == "automatic" {
		return "Automatic"
	}
	return "Manual"
}

func testCaseIdentifierDisplay(identifier string) string {
	if identifier == "" {
		return ""
	}
	return identifier
}
