// InviteSuccessOOB renders a success message after sending an invitation.
templ InviteSuccessOOB(productID string, inviteURL string) {
	<div id="invite-form" hx-swap-oob="true">
		@ui.Card() {
			@ui.CardHeader("Invite New User") {
			}
			@ui.CardBody() {
				<div class="space-y-4">
					<div class="rounded-md bg-emerald-50 p-4 dark:bg-emerald-900/30">
						<div class="flex items-start gap-3">
							<span class="text-emerald-500">
								@ui.Icon("check-circle", "md")
							</span>
							<div>
								<p class="text-sm font-medium text-emerald-700 dark:text-emerald-400">Invitation created!</p>
								<p class="mt-1 text-sm text-emerald-600 dark:text-emerald-400">Share this link with the user:</p>
								<code class="mt-2 block break-all rounded bg-emerald-100 px-2 py-1 text-xs font-mono text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">{ inviteURL }</code>
							</div>
						</div>
					</div>
					@ui.Button(ui.ButtonProps{
						Label:   "Invite Another",
						Variant: "secondary",
						Size:    "md",
						HxGet:   "/products/" + productID + "/team/invite-form",
						HxTarget: "#invite-form",
						HxSwap:   "outerHTML",
					})
				</div>
			}
		}
	</div>
}

// MemberTableBody renders all member rows.
templ MemberTableBody(members []TeamMemberView, productID string, isOwnerOrAdmin bool) {
	for _, m := range members {
		@MemberRow(m, productID, isOwnerOrAdmin)
	}
}

// MemberRow renders a single member table row.
templ MemberRow(m TeamMemberView, productID string, isOwnerOrAdmin bool) {
	<tr id={ "member-" + m.UserID }>
		<td class="whitespace-nowrap px-4 py-3">
			<div>
				<p class="text-sm font-medium text-gray-900 dark:text-gray-100">{ m.DisplayName }</p>
				if m.Username != "" {
					<p class="text-xs text-gray-500 dark:text-gray-400">{ "@" + m.Username }</p>
				}
			</div>
		</td>
		<td class="whitespace-nowrap px-4 py-3">
			if isOwnerOrAdmin && !m.IsOwner {
				<select
					name="role"
					class="rounded-md border-0 px-2 py-1 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
					hx-patch={ "/products/" + productID + "/team/members/" + m.UserID }
					hx-target={ "#member-" + m.UserID }
					hx-swap="outerHTML"
					hx-trigger="change"
				>
					<option value="developer" selected?={ m.Role == "developer" }>Developer</option>
					<option value="tester" selected?={ m.Role == "tester" }>Tester</option>
					<option value="viewer" selected?={ m.Role == "viewer" }>Viewer</option>
				</select>
			} else {
				@roleBadge(m.Role)
			}
		</td>
		if isOwnerOrAdmin {
			<td class="whitespace-nowrap px-4 py-3 text-right">
				if m.IsOwner {
					<span class="text-xs text-gray-400 dark:text-gray-500">Product Owner</span>
				} else {
					<div class="flex items-center justify-end gap-2">
						<button
							type="button"
							class="text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
							hx-post={ "/products/" + productID + "/team/transfer" }
							hx-vals={ `{"new_owner_id":"` + m.UserID + `"}` }
							hx-confirm={ "Transfer ownership to " + m.DisplayName + "? You will be demoted to Developer." }
						>
							Transfer Ownership
						</button>
						<button
							type="button"
							class="text-sm font-medium text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300"
							hx-delete={ "/products/" + productID + "/team/members/" + m.UserID }
							hx-target={ "#member-" + m.UserID }
							hx-swap="delete"
							hx-confirm={ "Remove " + m.DisplayName + " from this product?" }
						>
							Remove
						</button>
					</div>
				}
			</td>
		}
	</tr>
}

// DeleteProductConfirmation renders the delete product confirmation modal content.
templ DeleteProductConfirmation(productName, productID string) {
	@ui.ConfirmDialog(
		"delete-confirm",
		"Delete Product",
		"Are you sure you want to delete \""+productName+"\"? This will permanently remove all associated data. This action cannot be undone.",
		"Delete Product",
		"danger",
		"delete",
		"/products/"+productID,
	)
}

func roleOptions() []templates.SelectOption {
	return []templates.SelectOption{
		{Value: "developer", Label: "Developer"},
		{Value: "tester", Label: "Tester"},
		{Value: "viewer", Label: "Viewer"},
	}
}

// userSearchScript provides the selection logic for the typeahead search.
templ userSearchScript() {
	<script>
		function selectUserResult(userId, displayName, username) {
			document.getElementById('selected-user-id').value = userId;
			document.getElementById('selected-user-name').textContent = displayName + ' (@' + username + ')';
			document.getElementById('selected-user-display').classList.remove('hidden');
			document.getElementById('selected-user-display').classList.add('flex');
			document.getElementById('user-search').value = '';
			document.getElementById('user-search-results').innerHTML = '';
		}
		function clearUserSelection() {
			document.getElementById('selected-user-id').value = '';
			document.getElementById('selected-user-name').textContent = '';
			document.getElementById('selected-user-display').classList.add('hidden');
			document.getElementById('selected-user-display').classList.remove('flex');
		}
	</script>
}

script selectUser(userId, displayName, username string) {
	selectUserResult(userId, displayName, username)
}
