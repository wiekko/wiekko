package product

import (
	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// BoardPageProps holds data for the kanban board page.
type BoardPageProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
	Surface     templates.BoardSurfaceProps
}

templ BoardPage(props BoardPageProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "board",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Board"},
			})
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Board</h1>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						if props.Surface.CanMove {
							Drag cards between columns to update status.
						} else {
							Read-only view. Only developers and owners can move cards.
						}
					</p>
				</div>
				@patterns.BoardLegend()
			</div>
			@patterns.BoardSurface(props.Surface)
		</div>
	}
}

// DefectsBoardPageProps holds data for the defects-only board.
type DefectsBoardPageProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
	Surface     templates.BoardSurfaceProps
}

templ DefectsBoardPage(props DefectsBoardPageProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "defects",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Defects", Href: "/products/" + props.Product.ID + "/defects"},
				{Label: "Board"},
			})
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Defects Board</h1>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						if props.Surface.CanMove {
							Drag cards between columns to update status.
						} else {
							Read-only view. Only developers and owners can move cards.
						}
					</p>
				</div>
				@defectsViewToggle(props.Product.ID, true)
			</div>
			@patterns.BoardSurface(props.Surface)
		</div>
	}
}

// defectsViewToggle switches between the defects table and the defects board.
// Both views are routes rather than tabs, so each is bookmarkable.
templ defectsViewToggle(productID string, boardActive bool) {
	<div class="flex items-center gap-1 rounded-md border border-gray-200 p-1 dark:border-gray-700">
		<a href={ templ.SafeURL("/products/" + productID + "/defects") } class={ "rounded px-3 py-1.5 text-sm font-medium transition-colors", viewToggleClass(!boardActive) }>
			Table
		</a>
		<a href={ templ.SafeURL("/products/" + productID + "/defects/board") } class={ "rounded px-3 py-1.5 text-sm font-medium transition-colors", viewToggleClass(boardActive) }>
			Board
		</a>
	</div>
}
