package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates/ui"
)

// HostDefectsTabProps holds data for the Defects tab of a capability or a
// component: the defects linked to that item itself (UR-159).
type HostDefectsTabProps struct {
	BaseURL   string // the item's page, e.g. /products/p/components/c
	ProductID string
	Noun      string // "capability" or "component"
	CanLink   bool
	CanUnlink bool
	Defects   []*model.Defect
	LinkIDs   map[string]string // defect ID → DefectLink ID
	// Derived holds, for a component, the defects linked to its capabilities
	// but not to the component itself (UR-160).
	Derived []DerivedDefect
}

templ HostDefectsTabContent(props HostDefectsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Defects) + len(props.Derived)) }>
		if props.CanLink {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    props.BaseURL + "/defects/link-modal",
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    props.BaseURL + "/defects/create-modal",
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Defects) == 0 {
			@ui.Card() {
				@ui.EmptyState("bug", "No defects", "Defects linked to this "+props.Noun+" will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Criticality
						}
						if props.CanUnlink {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, d := range props.Defects {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									<span class="whitespace-nowrap">{ d.Identifier }</span>
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", props.ProductID, d.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ d.Title }
									</a>
								}
								@ui.TableCellMuted() {
									{ d.Criticality }
								}
								if props.CanUnlink {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink defect"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ props.BaseURL + "/defects/" + props.LinkIDs[d.ID] }
											hx-target="#tab-panel-defects"
											hx-swap="innerHTML"
											hx-confirm={ "Unlink this defect from the " + props.Noun + "?" }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
		@derivedDefectsSection(props.ProductID, props.Derived)
	</div>
}

templ HostDefectLinkModal(baseURL string) {
	@ui.Modal("defect-link-modal", "Link existing defect", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search defects..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ baseURL + "/defects/link-search" }
					hx-target="#defect-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="defect-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ HostDefectLinkResults(baseURL string, candidates []*model.Defect) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching defects.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, d := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ d.Title }</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">{ d.Identifier } · { d.Criticality }</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ baseURL + "/defects/link" }
						hx-vals={ fmt.Sprintf(`{"defect_id":"%s"}`, d.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}
