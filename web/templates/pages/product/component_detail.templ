package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// ComponentDetailProps holds data for the component detail page.
type ComponentDetailProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Component      *model.Component
	MilestoneName  string
	IsOwnerOrAdmin bool
	TabCounts map[string]int // tab ID → number of linked items (UC-88)
}

templ ComponentDetailPage(props ComponentDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "components",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Components", Href: "/products/" + props.Product.ID + "/components"},
					{Label: props.Component.Name},
				},
				props.Component.Name,
				"",
				componentEditHref(props),
				componentDeleteURL(props),
				props.Meta.CSRFToken,
			)
			<!-- Tabs -->
			@ui.TabGroup(templates.WithCounts(componentDetailTabs(props.Product.ID, props.Component.ID), props.TabCounts))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@ComponentOverviewTabContent(props.Product.ID, props.Component, props.MilestoneName)
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("requirements") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("defects") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("documents") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ ComponentOverviewTabContent(productID string, c *model.Component, milestoneName string) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Milestone", componentMilestoneDisplay(milestoneName))
				@patterns.DetailField("Created", formatDate(c.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(c.UpdatedAt))
			}
			@patterns.DetailDescription(c.Description)
		}
	}
}

// ComponentCapabilitiesTabProps holds data for the component capabilities tab (FK 1:N).
type ComponentCapabilitiesTabProps struct {
	ProductID    string
	ComponentID  string
	CSRFToken    string
	CanWrite     bool
	Capabilities []*model.Capability
}

templ ComponentCapabilitiesTabContent(props ComponentCapabilitiesTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Capabilities)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/components/%s/capabilities/link-modal", props.ProductID, props.ComponentID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/components/%s/capabilities/create-modal", props.ProductID, props.ComponentID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Capabilities) == 0 {
			@ui.Card() {
				@ui.EmptyState("layers", "No capabilities", "Capabilities under this component will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						@ui.TableHeader() {
							Created
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, f := range props.Capabilities {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", props.ProductID, f.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ f.Name }
									</a>
								}
								@ui.TableCellMuted() {
									{ formatDate(f.CreatedAt) }
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink capability"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/components/%s/capabilities/%s", props.ProductID, props.ComponentID, f.ID) }
											hx-target="#tab-panel-capabilities"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink capability", "Unlink", "Unlink capability "+ui.ItemName("", f.Name)+" from this component?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ ComponentCapabilityLinkModal(productID, componentID string) {
	@ui.Modal("capability-link-modal", "Link existing capability", "md") {
		<div class="space-y-4">
			<p class="text-xs text-gray-500 dark:text-gray-400">Linking a capability sets its component to this one.</p>
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search capabilities..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/components/%s/capabilities/link-search", productID, componentID) }
					hx-target="#capability-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="capability-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ ComponentCapabilityLinkResults(productID, componentID string, candidates []*model.Capability) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching capabilities.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, cap := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ cap.Name }</p>
						if cap.Description != "" {
							<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ cap.Description }</p>
						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/components/%s/capabilities/link", productID, componentID) }
						hx-vals={ fmt.Sprintf(`{"capability_id":"%s"}`, cap.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// ComponentTestCasesTabProps holds data for the component test-cases tab (FK 1:N).
type ComponentTestCasesTabProps struct {
	ProductID   string
	ComponentID string
	CSRFToken   string
	CanWrite    bool
	TestCases   []*model.TestCase
}

templ ComponentTestCasesTabContent(props ComponentTestCasesTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.TestCases)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/components/%s/test-cases/link-modal", props.ProductID, props.ComponentID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/components/%s/test-cases/create-modal", props.ProductID, props.ComponentID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.TestCases) == 0 {
			@ui.Card() {
				@ui.EmptyState("beaker", "No test cases", "Test cases under this component will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Mode
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, tc := range props.TestCases {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/test-cases/%s", props.ProductID, tc.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ tc.Title }
									</a>
								}
								@ui.TableCellMuted() {
									@patterns.ExecutionModeBadge(tc.ExecutionMode)
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink test case"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/components/%s/test-cases/%s", props.ProductID, props.ComponentID, tc.ID) }
											hx-target="#tab-panel-test-cases"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink test case", "Unlink", "Unlink test case "+ui.ItemName("", tc.Title)+" from this component?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ ComponentTestCaseLinkModal(productID, componentID string) {
	@ui.Modal("test-case-link-modal", "Link existing test case", "md") {
		<div class="space-y-4">
			<p class="text-xs text-gray-500 dark:text-gray-400">Linking a test case sets its component to this one.</p>
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search test cases..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/components/%s/test-cases/link-search", productID, componentID) }
					hx-target="#test-case-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="test-case-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ ComponentTestCaseLinkResults(productID, componentID string, candidates []*model.TestCase) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching test cases.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, tc := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ tc.Title }</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">{ tc.ExecutionMode }</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/components/%s/test-cases/link", productID, componentID) }
						hx-vals={ fmt.Sprintf(`{"test_case_id":"%s"}`, tc.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

templ ComponentHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this component will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// ComponentDeleteConfirmation renders the delete confirmation for a component.
templ ComponentDeleteConfirmation(name, productID, componentID, csrfToken string) {
	@patterns.DeleteConfirmation("component", name, fmt.Sprintf("/products/%s/components/%s", productID, componentID), csrfToken)
}

func componentDetailTabs(productID, componentID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/components/%s/tabs", productID, componentID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "capabilities", Label: "Capabilities", HxGet: base + "/capabilities"},
		{ID: "requirements", Label: "Requirements", HxGet: base + "/requirements"},
		{ID: "test-cases", Label: "Test Cases", HxGet: base + "/test-cases"},
		{ID: "defects", Label: "Defects", HxGet: base + "/defects"},
		{ID: "documents", Label: "Documents", HxGet: base + "/documents"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func componentEditHref(props ComponentDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/components/" + props.Component.ID + "/edit"
	}
	return ""
}

func componentDeleteURL(props ComponentDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/components/" + props.Component.ID
	}
	return ""
}

// componentLink links a component by name wherever another page names it
// (UR-159); an empty name, e.g. a product-level capability, shows a dash.
templ componentLink(productID, componentID, name string) {
	if componentID != "" && name != "" {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", productID, componentID)) }
			class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
		>
			{ name }
		</a>
	} else {
		<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
	}
}

func componentMilestoneDisplay(name string) string {
	if name == "" {
		return "Not set"
	}
	return name
}
