											hx-delete={ fmt.Sprintf("/products/%s/milestones/%s/requirements/%s", props.ProductID, props.MilestoneID, req.ID) }
											hx-target="#tab-panel-requirements"
											hx-swap="innerHTML"
											hx-confirm="Remove this requirement from the milestone?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

