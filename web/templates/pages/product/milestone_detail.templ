templ MilestoneConstraintLinkResults(productID, milestoneID string, candidates []*model.Constraint, milestoneNames map[string]string, prefixes map[string]string) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching constraints.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, con := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ con.Title }</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">{ model.EntityIdentifier(milestoneCategoryPrefix(prefixes, con.CategoryID), con.SequenceNumber) }</p>
						if con.MilestoneID != "" {
							<p class="text-xs text-amber-600 dark:text-amber-400">
								{ "currently: " + milestoneNameOf(milestoneNames, con.MilestoneID) }
							</p>
						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/milestones/%s/constraints/link", productID, milestoneID) }
						hx-vals={ fmt.Sprintf(`{"constraint_id":"%s"}`, con.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// MilestoneDefectsTabProps holds data for the milestone defects tab.
type MilestoneDefectsTabProps struct {
	ProductID   string
	MilestoneID string
	CSRFToken   string
	CanWrite    bool
	Defects []*model.Defect
}

templ MilestoneDefectsTabContent(props MilestoneDefectsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Defects)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/milestones/%s/defects/link-modal", props.ProductID, props.MilestoneID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
			</div>
		}
		if len(props.Defects) == 0 {
			@ui.Card() {
				@ui.EmptyState("bug", "No linked defects", "Defects assigned to this milestone will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Criticality
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, d := range props.Defects {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									<span class="whitespace-nowrap">{ d.Identifier }</span>
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", props.ProductID, d.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ d.Title }
									</a>
								}
								@ui.TableCellMuted() {
									{ d.Criticality }
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink defect"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/milestones/%s/defects/%s", props.ProductID, props.MilestoneID, d.ID) }
											hx-target="#tab-panel-defects"
											hx-swap="innerHTML"
											hx-confirm="Remove this defect from the milestone?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

