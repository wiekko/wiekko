// MilestoneRequirementsTabProps holds data for the milestone requirements tab.
type MilestoneRequirementsTabProps struct {
	ProductID   string
	MilestoneID string
	CSRFToken   string
	CanWrite    bool
	Requirements []*model.Requirement
	CategoryPrefixes map[string]string
}

templ MilestoneRequirementsTabContent(props MilestoneRequirementsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Requirements)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/milestones/%s/requirements/link-modal", props.ProductID, props.MilestoneID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
			</div>
		}
		if len(props.Requirements) == 0 {
			@ui.Card() {
				@ui.EmptyState("clipboard-list", "No linked requirements", "Requirements assigned to this milestone will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, req := range props.Requirements {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									{ model.EntityIdentifier(milestoneCategoryPrefix(props.CategoryPrefixes, req.CategoryID), req.SequenceNumber) }
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/requirements/%s", props.ProductID, req.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ req.Title }
									</a>
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
