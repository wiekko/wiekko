											hx-delete={ fmt.Sprintf("/products/%s/milestones/%s/constraints/%s", props.ProductID, props.MilestoneID, con.ID) }
											hx-target="#tab-panel-constraints"
											hx-swap="innerHTML"
											hx-confirm="Remove this constraint from the milestone?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

