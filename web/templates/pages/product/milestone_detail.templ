package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// MilestoneDetailProps holds data for the milestone detail page.
type MilestoneDetailProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Milestone      *model.Milestone
	IsOwnerOrAdmin bool
	TabCounts      map[string]int // tab ID → number of linked items (UC-88)
}

templ MilestoneDetailPage(props MilestoneDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "milestones",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Milestones", Href: "/products/" + props.Product.ID + "/milestones"},
					{Label: props.Milestone.Name},
				},
				props.Milestone.Name,
				milestoneDetailSubtitle(props.Milestone),
				milestoneEditHref(props),
				milestoneDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@milestoneTypeBadge(props.Milestone.Type)
			}
			<!-- Tabs -->
			@ui.TabGroup(templates.WithCounts(milestoneDetailTabs(props.Product.ID, props.Milestone.ID, props.Product.WorkflowMode), props.TabCounts))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@MilestoneOverviewTabContent(props.Milestone)
			}
			@ui.TabPanelHidden("components") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("requirements") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("constraints") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("defects") {
				@ui.LoadingSpinner("md")
			}
			if props.Product.WorkflowMode == model.WorkflowModeScrum {
				@ui.TabPanelHidden("sprints") {
					@ui.LoadingSpinner("md")
				}
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ MilestoneOverviewTabContent(m *model.Milestone) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Type", milestoneTypeLabel(m.Type))
				@patterns.DetailField("Due Date", milestoneDate(m.DueDate))
				@patterns.DetailField("Created", formatDate(m.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(m.UpdatedAt))
			}
			@patterns.DetailDescription(m.Description)
		}
	}
}

// MilestoneComponentsTabProps holds data for the milestone components tab.
type MilestoneComponentsTabProps struct {
	ProductID   string
	MilestoneID string
	CSRFToken   string
	CanWrite    bool
	Components []*model.Component
	Affected   []AffectedItem // via the milestone's requirements (UR-161)
}

templ MilestoneComponentsTabContent(props MilestoneComponentsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Components) + len(props.Affected)) }>
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/milestones/%s/components/link-modal", props.ProductID, props.MilestoneID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
			</div>
		}
		if len(props.Components) == 0 {
			@ui.Card() {
				@ui.EmptyState("component", "No linked components", "Components assigned to this milestone will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						@ui.TableHeader() {
							Description
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, comp := range props.Components {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", props.ProductID, comp.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ comp.Name }
									</a>
								}
								@ui.TableCellMuted() {
									{ truncate(comp.Description, 80) }
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink component"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/milestones/%s/components/%s", props.ProductID, props.MilestoneID, comp.ID) }
											hx-target="#tab-panel-components"
											hx-swap="innerHTML"
											hx-confirm="Remove this component from the milestone?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
		@affectedSection(props.Affected, "component")
	</div>
}

// MilestoneComponentLinkModal renders the "link existing component" modal.
templ MilestoneComponentLinkModal(productID, milestoneID string) {
	@ui.Modal("components-link-modal", "Link existing component", "md") {
		<div class="space-y-4">
			<p class="text-xs text-gray-500 dark:text-gray-400">Linking an item sets its milestone to this one.</p>
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search components..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/milestones/%s/components/link-search", productID, milestoneID) }
					hx-target="#components-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="components-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ MilestoneComponentLinkResults(productID, milestoneID string, candidates []*model.Component, milestoneNames map[string]string) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching components.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, comp := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ comp.Name }</p>
						if comp.Description != "" {
							<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ truncate(comp.Description, 80) }</p>
						}
						if comp.MilestoneID != "" {
							<p class="text-xs text-amber-600 dark:text-amber-400">
								{ "currently: " + milestoneNameOf(milestoneNames, comp.MilestoneID) }
							</p>
						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/milestones/%s/components/link", productID, milestoneID) }
						hx-vals={ fmt.Sprintf(`{"component_id":"%s"}`, comp.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

