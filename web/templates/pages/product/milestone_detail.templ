						<p class="text-xs text-gray-500 dark:text-gray-400">{ model.EntityIdentifier(milestoneCategoryPrefix(prefixes, req.CategoryID), req.SequenceNumber) }</p>
						if req.MilestoneID != "" {
							<p class="text-xs text-amber-600 dark:text-amber-400">
								{ "currently: " + milestoneNameOf(milestoneNames, req.MilestoneID) }
