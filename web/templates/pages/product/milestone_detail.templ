// MilestoneDeleteConfirmation renders the delete confirmation for a milestone.
templ MilestoneDeleteConfirmation(name, productID, milestoneID, csrfToken string) {
	@patterns.DeleteConfirmation("milestone", name, fmt.Sprintf("/products/%s/milestones/%s", productID, milestoneID), csrfToken)
}

// milestoneDetailTabs lists the milestone tabs. Sprints exist only in Scrum,
// so the Sprints tab is left out for Kanban products (UR-157).
func milestoneDetailTabs(productID, milestoneID, workflowMode string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/milestones/%s/tabs", productID, milestoneID)
	tabs := []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "components", Label: "Components", HxGet: base + "/components"},
		{ID: "capabilities", Label: "Capabilities", HxGet: base + "/capabilities"},
		{ID: "requirements", Label: "Requirements", HxGet: base + "/requirements"},
		{ID: "constraints", Label: "Constraints", HxGet: base + "/constraints"},
		{ID: "defects", Label: "Defects", HxGet: base + "/defects"},
		{ID: "sprints", Label: "Sprints", HxGet: base + "/sprints"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
	if workflowMode == model.WorkflowModeScrum {
		return tabs
	}
	out := tabs[:0]
	for _, t := range tabs {
		if t.ID != "sprints" {
			out = append(out, t)
		}
	}
	return out
}

func milestoneDetailSubtitle(m *model.Milestone) string {
	if m.DueDate != "" {
		return "Due " + formatDate(m.DueDate)
	}
	return ""
}

func milestoneEditHref(props MilestoneDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/milestones/" + props.Milestone.ID + "/edit"
	}
	return ""
}

func milestoneDeleteURL(props MilestoneDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/milestones/" + props.Milestone.ID
	}
	return ""
}

func milestoneTypeLabel(t string) string {
	switch t {
	case "release":
		return "Release"
	case "internal":
		return "Internal"
	default:
		return "Planning"
	}
}

func milestoneDate(d string) string {
	if d == "" {
		return "Not set"
	}
	return formatDate(d)
}

func milestoneNameOf(names map[string]string, milestoneID string) string {
	if name, ok := names[milestoneID]; ok {
		return name
	}
	return "another milestone"
}

func milestoneCategoryPrefix(prefixes map[string]string, categoryID string) string {
	if prefix, ok := prefixes[categoryID]; ok {
		return prefix
	}
	return "?"
}

// milestoneSprintDates renders a sprint's date range for the milestone tabs.
func milestoneSprintDates(sp *model.Sprint) string {
	switch {
	case sp.StartDate == "" && sp.EndDate == "":
		return "Not scheduled"
	case sp.EndDate == "":
		return formatDate(sp.StartDate)
	case sp.StartDate == "":
		return "until " + formatDate(sp.EndDate)
	default:
		return formatDate(sp.StartDate) + " – " + formatDate(sp.EndDate)
	}
}
