package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// CapabilitiesTableID is the element the capabilities table controls swap.
const CapabilitiesTableID = "capabilities-table"

// CapabilitiesProps holds data for the capabilities list page.
type CapabilitiesProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Capabilities   []*model.Capability
	Components     map[string]string // component ID -> name
	Milestones     map[string]string // milestone ID -> name
	IsOwnerOrAdmin bool
	patterns.TableView
	ComponentOptions []*model.Component
	MilestoneOptions []*model.Milestone
}

templ CapabilitiesPage(props CapabilitiesProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "capabilities",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class={ patterns.TableViewPageClass }>
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Capabilities"},
			})
			if props.ProductTotal == 0 {
				@patterns.ListPageHeader("Capabilities", "", "", -1)
				@ui.Card() {
					@capabilitiesEmpty(props)
				}
			} else {
				@patterns.TableHeader("Capabilities", "capabilities-count", props.CountLabel()) {
					if props.IsOwnerOrAdmin {
						@ui.LinkButton("/products/"+props.Product.ID+"/capabilities/new", "New Capability", "primary", "md") {
							@ui.Icon("plus", "sm")
						}
					}
				}
				<div id={ CapabilitiesTableID } class={ patterns.TableViewRegionClass }>
					@CapabilitiesTableContent(props)
				</div>
			}
		</div>
	}
}

// CapabilitiesTableContent renders the capabilities table with its controls
// (UR-145).
templ CapabilitiesTableContent(props CapabilitiesProps) {
	{{ target := "#" + CapabilitiesTableID }}
	@patterns.TableFrame(props.Frame(capabilitiesControls(props), "capabilities-count", len(props.Capabilities), capabilitiesEmpty(props))) {
		@ui.Table() {
			@ui.TableHead() {
				@ui.SortHeader("Name", "name", props.State, target)
				@ui.SortHeader("Component", "component", props.State, target)
				@ui.SortHeader("Milestone", "milestone", props.State, target)
				@ui.SortHeader("Created", "created", props.State, target)
				if props.IsOwnerOrAdmin {
					@ui.TableHeader() {
						<span class="sr-only">Actions</span>
					}
				}
			}
			@ui.TableBody("") {
				for _, f := range props.Capabilities {
					@ui.TableRow("") {
						@ui.TableCell() {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", props.Product.ID, f.ID)) }
								class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
							>
								{ f.Name }
							</a>
						}
						@ui.TableCellMuted() {
							if f.ComponentID != "" {
								if name, ok := props.Components[f.ComponentID]; ok {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", props.Product.ID, f.ComponentID)) }
										class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ name }
									</a>
								} else {
									{ f.ComponentID }
								}
							} else {
								<span class="text-gray-400 dark:text-gray-500">Top-level</span>
							}
						}
						@ui.TableCellMuted() {
							if f.MilestoneID != "" {
								if name, ok := props.Milestones[f.MilestoneID]; ok {
									{ name }
								} else {
									{ f.MilestoneID }
								}
							} else {
								<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
							}
						}
						@ui.TableCellMuted() {
							{ formatDate(f.CreatedAt) }
						}
						if props.IsOwnerOrAdmin {
							@ui.TableCell() {
								@patterns.RowActions(
									fmt.Sprintf("/products/%s/capabilities/%s/edit?return=list", props.Product.ID, f.ID),
									fmt.Sprintf("/products/%s/capabilities/%s", props.Product.ID, f.ID),
									props.Meta.CSRFToken,
								)
							}
						}
					}
				}
			}
		}
	}
}

templ capabilitiesEmpty(props CapabilitiesProps) {
	if props.IsOwnerOrAdmin {
		@ui.EmptyState("layers", "No capabilities yet", "Create your first capability to describe your product capabilities.", "New Capability", "/products/"+props.Product.ID+"/capabilities/new")
	} else {
		@ui.EmptyState("layers", "No capabilities yet", "No capabilities have been created for this product.", "", "")
	}
}

func capabilitiesControls(props CapabilitiesProps) patterns.TableControlsProps {
	var facets []patterns.TableFacet
	if len(props.ComponentOptions) > 0 {
		values := make([]templates.SelectOption, 0, len(props.ComponentOptions))
		for _, c := range props.ComponentOptions {
			values = append(values, templates.SelectOption{Value: c.ID, Label: c.Name})
		}
		facets = append(facets, patterns.TableFacet{Name: "component_id", Label: "Component",
			Options: patterns.FacetOptions("All components", "Top-level", values...)})
	}
	if len(props.MilestoneOptions) > 0 {
		facets = append(facets, milestoneFacet(props.MilestoneOptions))
	}
	return patterns.TableControlsProps{
		Key:    "capability",
		Target: "#" + CapabilitiesTableID,
		Noun:   "capabilities",
		Facets: facets,
	}
}
