package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// CapabilitiesProps holds data for the capabilities list page.
type CapabilitiesProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Capabilities   []*model.Capability
	Components     map[string]string // component ID -> name
	Milestones     map[string]string // milestone ID -> name
	IsOwnerOrAdmin bool
}

templ CapabilitiesPage(props CapabilitiesProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "capabilities",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Capabilities"},
			})
			if len(props.Capabilities) == 0 {
				@patterns.ListPageHeader("Capabilities", "", "", -1)
				@ui.Card() {
					if props.IsOwnerOrAdmin {
						@ui.EmptyState("layers", "No capabilities yet", "Create your first capability to describe your product capabilities.", "New Capability", "/products/"+props.Product.ID+"/capabilities/new")
					} else {
						@ui.EmptyState("layers", "No capabilities yet", "No capabilities have been created for this product.", "", "")
					}
				}
			} else {
				<div class="flex items-center justify-between">
					<div>
						<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Capabilities</h1>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ fmt.Sprintf("%d items", len(props.Capabilities)) }</p>
					</div>
					if props.IsOwnerOrAdmin {
						@ui.LinkButton("/products/"+props.Product.ID+"/capabilities/new", "New Capability", "primary", "md") {
							@ui.Icon("plus", "sm")
						}
					}
				</div>
				@ui.Card() {
					@ui.Table() {
						@ui.TableHead() {
							@ui.TableHeader() {
								Name
							}
							@ui.TableHeader() {
								Component
							}
							@ui.TableHeader() {
								Milestone
							}
							@ui.TableHeader() {
								Created
							}
						}
						@ui.TableBody("") {
							for _, f := range props.Capabilities {
								@ui.TableRow("") {
									@ui.TableCell() {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", props.Product.ID, f.ID)) }
											class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
										>
											{ f.Name }
										</a>
									}
									@ui.TableCellMuted() {
										if f.ComponentID != "" {
											if name, ok := props.Components[f.ComponentID]; ok {
												<a
													href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", props.Product.ID, f.ComponentID)) }
													class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
												>
													{ name }
												</a>
											} else {
												{ f.ComponentID }
											}
										} else {
											<span class="text-gray-400 dark:text-gray-500">Top-level</span>
										}
									}
									@ui.TableCellMuted() {
										if f.MilestoneID != "" {
											if name, ok := props.Milestones[f.MilestoneID]; ok {
												{ name }
											} else {
												{ f.MilestoneID }
											}
										} else {
											<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
										}
									}
									@ui.TableCellMuted() {
										{ formatDate(f.CreatedAt) }
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
