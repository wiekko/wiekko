package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// DefectDetailProps holds data for the defect detail page.
type DefectDetailProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
	Defect      *model.Defect
	Overview    DefectOverviewProps
	CanEdit     bool
	TabCounts map[string]int // tab ID → number of linked items (UC-88)
	// Assignees are shown in the header and the Overview (UR-171).
	Assignees patterns.AssigneesProps
}

templ DefectDetailPage(props DefectDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "defects",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Defects", Href: "/products/" + props.Product.ID + "/defects"},
					{Label: props.Defect.Identifier},
				},
				props.Defect.Title,
				props.Defect.Identifier,
				defectEditHref(props),
				defectDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@patterns.CriticalityBadge(props.Defect.Criticality)
				@patterns.AssigneeMenu(props.Assignees)
				@patterns.ArchiveControls(defectArchiveProps(props))
			}
			<!-- Tabs -->
			@ui.TabGroup(templates.WithCounts(defectDetailTabs(props.Product.ID, props.Defect.ID), props.TabCounts))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@DefectOverviewTabContent(props.Overview)
			}
			@ui.TabPanelHidden("components") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("requirements") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

// DefectOverviewProps holds the defect overview tab.
type DefectOverviewProps struct {
	ProductID       string
	EstimationMode  string
	WorkflowMode    string
	Defect          *model.Defect
	Status          *model.Status
	MilestoneName   string
	SprintName      string
	EnvironmentName string
	// Assigned are the defect's assignees (UR-171).
	Assigned []patterns.Assignee
	// Verification is the campaign result trail behind this defect, one entry
	// per result it ever failed (FR-48, FR-123).
	Verification []DefectVerificationGroup
}

// DefectVerificationGroup is one campaign result's journey through this defect:
// the failure that raised it, the re-test after it was closed, and the verdict
// that followed.
type DefectVerificationGroup struct {
	TestCase     string
	Environment  string
	CampaignName string
	Events       []ResultEventView
	// Verified is true when the latest recorded verdict is a pass.
	Verified bool
}

templ DefectOverviewTabContent(props DefectOverviewProps) {
	<div class="space-y-6">
		@ui.Card() {
			@ui.CardBody() {
				@patterns.DetailGrid() {
					@patterns.DetailField("Identifier", props.Defect.Identifier)
					@patterns.DetailFieldSlot("Criticality") {
						@patterns.CriticalityBadge(props.Defect.Criticality)
					}
					@workflowStatusField(props.Status)
					@patterns.AssigneeField(props.Assigned)
					if props.Defect.MilestoneID != "" && props.MilestoneName != "" {
						@defectLinkedField("Milestone", props.MilestoneName, fmt.Sprintf("/products/%s/milestones/%s", props.ProductID, props.Defect.MilestoneID))
					} else {
						@patterns.DetailField("Milestone", "")
					}
					if props.WorkflowMode == model.WorkflowModeScrum {
						@patterns.DetailField("Sprint", props.SprintName)
					}
					@patterns.DetailField("Environment", props.EnvironmentName)
					if props.EstimationMode != model.EstimationModeDisabled {
						@patterns.DetailField("Estimation", formatEstimation(props.EstimationMode, props.Defect.Estimation))
					}
					@patterns.DetailFieldSlot("Priority") {
						@patterns.PriorityBadge(props.Defect.Priority)
					}
					@patterns.DetailField("Active", boolDisplay(props.Defect.IsActive))
					@patterns.DetailField("Created", formatDate(props.Defect.CreatedAt))
					@patterns.DetailField("Last Updated", formatDate(props.Defect.UpdatedAt))
				}
				@patterns.DetailDescription(props.Defect.Description)
			}
		}
		@defectVerification(props)
	</div>
}

// defectVerification shows whether the fix was actually re-tested and by whom.
// Kept on the overview rather than behind a tab: it is the evidence a product
// owner needs before treating a defect as done.
templ defectVerification(props DefectOverviewProps) {
	@ui.Card() {
		@ui.CardHeader("Verification")
		@ui.CardBody() {
			if len(props.Verification) == 0 {
				@ui.EmptyState("beaker", "No verification",
					"No campaign result has been linked to this defect.", "", "")
			} else {
				<div class="space-y-6">
					for _, group := range props.Verification {
						<div>
							<div class="flex flex-wrap items-center gap-2">
								<span class="text-sm font-medium text-gray-900 dark:text-gray-100">
									{ group.TestCase }
								</span>
								if group.Environment != "" {
									<span class="text-sm text-gray-400 dark:text-gray-500">·&nbsp;{ group.Environment }</span>
								}
								if group.CampaignName != "" {
									<span class="text-xs text-gray-500 dark:text-gray-400">{ group.CampaignName }</span>
								}
								if group.Verified {
									@ui.Badge("Verified", "green")
								}
							</div>
							<ol class="mt-2 space-y-2">
								for _, ev := range group.Events {
									<li class="flex items-start gap-3 text-sm">
										<span class="w-36 shrink-0 pt-0.5 text-xs text-gray-500 dark:text-gray-400">
											{ ev.At }
										</span>
										<span class="flex flex-wrap items-center gap-1.5">
											@campaignResultIcon(ev.ToStatus)
											<span class="font-medium text-gray-900 dark:text-gray-100">
												{ campaignResultLabel(ev.ToStatus) }
											</span>
											<span class="text-xs text-gray-500 dark:text-gray-400">
												{ campaignEventActor(ev) }
											</span>
										</span>
									</li>
								}
							</ol>
						</div>
					}
				</div>
			}
		}
	}
}

templ defectLinkedField(label, name, href string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if name != "" {
				<a
					href={ templ.SafeURL(href) }
					class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
				>
					{ name }
				</a>
			} else {
				<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
			}
		</dd>
	</div>
}

// --- Components tab (FR-29) ---

// DefectComponentsTabProps holds data for the defect components tab.
type DefectComponentsTabProps struct {
	ProductID  string
	DefectID   string
	CSRFToken  string
	CanLink    bool
	CanUnlink  bool
	Components []*model.Component
	LinkIDs    map[string]string // componentID → DefectLink ID
}

templ DefectComponentsTabContent(props DefectComponentsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Components)) }>
		if props.CanLink {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/defects/%s/components/link-modal", props.ProductID, props.DefectID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
			</div>
		}
		if len(props.Components) == 0 {
			@ui.Card() {
				@ui.EmptyState("component", "No linked components", "Components linked to this defect will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						@ui.TableHeader() {
							Description
						}
						if props.CanUnlink {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, comp := range props.Components {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", props.ProductID, comp.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ comp.Name }
									</a>
								}
								@ui.TableCellMuted() {
									{ truncate(comp.Description, 80) }
								}
								if props.CanUnlink {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink component"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/defects/%s/components/%s", props.ProductID, props.DefectID, props.LinkIDs[comp.ID]) }
											hx-target="#tab-panel-components"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink component", "Unlink", "Unlink component "+ui.ItemName("", comp.Name)+" from this defect?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// DefectComponentLinkModal renders the "link existing component" modal.
templ DefectComponentLinkModal(productID, defectID string) {
	@ui.Modal("component-link-modal", "Link existing component", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search components..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/defects/%s/components/link-search", productID, defectID) }
					hx-target="#component-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="component-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ DefectComponentLinkResults(productID, defectID string, candidates []*model.Component) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching components.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, comp := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ comp.Name }</p>
						if comp.Description != "" {
							<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ truncate(comp.Description, 80) }</p>
						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/defects/%s/components/link", productID, defectID) }
						hx-vals={ fmt.Sprintf(`{"component_id":"%s"}`, comp.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// --- Capabilities tab (FR-29) ---

// DefectCapabilitiesTabProps holds data for the defect capabilities tab.
type DefectCapabilitiesTabProps struct {
	ProductID     string
	DefectID      string
	CSRFToken     string
	CanLink       bool
	CanUnlink     bool
	Capabilities  []*model.Capability
	ComponentName map[string]string // capabilityID → component name
	LinkIDs       map[string]string // capabilityID → DefectLink ID
}

templ DefectCapabilitiesTabContent(props DefectCapabilitiesTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Capabilities)) }>
		if props.CanLink {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/defects/%s/capabilities/link-modal", props.ProductID, props.DefectID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
			</div>
		}
		if len(props.Capabilities) == 0 {
			@ui.Card() {
				@ui.EmptyState("layers", "No linked capabilities", "Capabilities linked to this defect will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						@ui.TableHeader() {
							Component
						}
						if props.CanUnlink {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, cap := range props.Capabilities {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", props.ProductID, cap.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ cap.Name }
									</a>
								}
								@ui.TableCellMuted() {
									@componentLink(props.ProductID, cap.ComponentID, props.ComponentName[cap.ID])
								}
								if props.CanUnlink {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink capability"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/defects/%s/capabilities/%s", props.ProductID, props.DefectID, props.LinkIDs[cap.ID]) }
											hx-target="#tab-panel-capabilities"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink capability", "Unlink", "Unlink capability "+ui.ItemName("", cap.Name)+" from this defect?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

