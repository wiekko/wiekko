}

templ DefectCapabilityLinkResults(productID, defectID string, candidates []*model.Capability) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching capabilities.</p>
	} else {
