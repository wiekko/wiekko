						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/defects/%s/capabilities/link", productID, defectID) }
						hx-vals={ fmt.Sprintf(`{"capability_id":"%s"}`, cap.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// --- Test cases tab (FR-29) ---

// DefectTestCasesTabProps holds data for the defect test cases tab.
// CanLink and CanCreate are gated separately: testers may link an existing test
// case to a defect, but only developers and owners may create one (FR-114).
type DefectTestCasesTabProps struct {
	ProductID string
	DefectID  string
	CSRFToken string
	CanLink   bool
	CanCreate bool
	CanUnlink bool
	TestCases []*model.TestCase
	LinkIDs   map[string]string // testCaseID → DefectLink ID
}

templ DefectTestCasesTabContent(props DefectTestCasesTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.TestCases)) }>
		if props.CanLink || props.CanCreate {
			<div class="flex items-center justify-end gap-2">
				if props.CanLink {
					@ui.Button(ui.ButtonProps{
						Label:    "Link existing",
						Variant:  "secondary",
						Size:     "sm",
						HxGet:    fmt.Sprintf("/products/%s/defects/%s/test-cases/link-modal", props.ProductID, props.DefectID),
						HxTarget: "#modal",
						HxSwap:   "innerHTML",
					}) {
						@ui.Icon("link", "sm")
					}
				}
				if props.CanCreate {
					@ui.Button(ui.ButtonProps{
						Label:    "Create new",
						Variant:  "primary",
						Size:     "sm",
						HxGet:    fmt.Sprintf("/products/%s/defects/%s/test-cases/create-modal", props.ProductID, props.DefectID),
						HxTarget: "#modal",
						HxSwap:   "innerHTML",
					}) {
						@ui.Icon("plus", "sm")
					}
				}
			</div>
		}
		if len(props.TestCases) == 0 {
			@ui.Card() {
				@ui.EmptyState("beaker", "No linked test cases", "Test cases linked to this defect will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Execution
						}
						if props.CanUnlink {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, tc := range props.TestCases {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/test-cases/%s", props.ProductID, tc.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ tc.Title }
									</a>
								}
								@ui.TableCellMuted() {
									@patterns.ExecutionModeBadge(tc.ExecutionMode)
								}
								if props.CanUnlink {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink test case"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/defects/%s/test-cases/%s", props.ProductID, props.DefectID, props.LinkIDs[tc.ID]) }
											hx-target="#tab-panel-test-cases"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink test case", "Unlink", "Unlink test case "+ui.ItemName("", tc.Title)+" from this defect?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// DefectTestCaseLinkModal renders the "link existing test case" modal.
templ DefectTestCaseLinkModal(productID, defectID string) {
	@ui.Modal("test-case-link-modal", "Link existing test case", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search test cases..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/defects/%s/test-cases/link-search", productID, defectID) }
					hx-target="#test-case-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="test-case-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ DefectTestCaseLinkResults(productID, defectID string, candidates []*model.TestCase) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching test cases.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, tc := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ tc.Title }</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">{ tc.ExecutionMode }</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/defects/%s/test-cases/link", productID, defectID) }
						hx-vals={ fmt.Sprintf(`{"test_case_id":"%s"}`, tc.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// --- Requirements tab (FR-120) ---

// DefectRequirementsTabProps holds data for the defect requirements tab.
type DefectRequirementsTabProps struct {
	ProductID        string
	DefectID         string
	CSRFToken        string
	CanLink          bool
	CanUnlink        bool
	Requirements     []*model.Requirement
	CategoryPrefixes map[string]string // categoryID → prefix
	LinkIDs          map[string]string // requirementID → DefectLink ID
	Statuses map[string]*model.Status // status ID → status, for the Status column (UC-90)
}

templ DefectRequirementsTabContent(props DefectRequirementsTabProps) {
	<div class="space-y-4" data-tab-count={ fmt.Sprint(len(props.Requirements)) }>
		if props.CanLink {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/defects/%s/requirements/link-modal", props.ProductID, props.DefectID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
			</div>
		}
		if len(props.Requirements) == 0 {
			@ui.Card() {
				@ui.EmptyState("clipboard-list", "No linked requirements", "Requirements linked to this defect will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Status
						}
						if props.CanUnlink {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, req := range props.Requirements {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									{ model.EntityIdentifier(defectCategoryPrefix(props.CategoryPrefixes, req.CategoryID), req.SequenceNumber) }
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/requirements/%s", props.ProductID, req.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ req.Title }
									</a>
									if req.Archived() {
										<span class="ml-2 align-middle">
											@patterns.ArchivedBadge(true)
										</span>
									}
								}
								@ui.TableCellMuted() {
									@patterns.WorkflowStatusBadge(props.Statuses, req.StatusID)
								}
								if props.CanUnlink {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink requirement"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/defects/%s/requirements/%s", props.ProductID, props.DefectID, props.LinkIDs[req.ID]) }
											hx-target="#tab-panel-requirements"
											hx-swap="innerHTML"
											{ ui.Confirm(ui.ConfirmNeutral, "Unlink requirement", "Unlink", "Unlink requirement "+ui.ItemName(model.EntityIdentifier(defectCategoryPrefix(props.CategoryPrefixes, req.CategoryID), req.SequenceNumber), req.Title)+" from this defect?")... }
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// DefectRequirementLinkModal renders the "link existing requirement" modal.
templ DefectRequirementLinkModal(productID, defectID string) {
	@ui.Modal("requirement-link-modal", "Link existing requirement", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search requirements..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/defects/%s/requirements/link-search", productID, defectID) }
					hx-target="#requirement-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="requirement-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ DefectRequirementLinkResults(productID, defectID string, candidates []*model.Requirement, prefixes map[string]string) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching requirements.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, req := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ req.Title }</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">
							{ model.EntityIdentifier(defectCategoryPrefix(prefixes, req.CategoryID), req.SequenceNumber) }
						</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/defects/%s/requirements/link", productID, defectID) }
						hx-vals={ fmt.Sprintf(`{"requirement_id":"%s"}`, req.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

func defectCategoryPrefix(prefixes map[string]string, categoryID string) string {
	if prefix, ok := prefixes[categoryID]; ok {
		return prefix
	}
	return "?"
}

templ DefectHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this defect will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// DefectDeleteConfirmation renders the delete confirmation for a defect.
templ DefectDeleteConfirmation(name, productID, defectID, csrfToken string) {
	@patterns.DeleteConfirmation("defect", name, fmt.Sprintf("/products/%s/defects/%s", productID, defectID), csrfToken)
}

func defectDetailTabs(productID, defectID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/defects/%s/tabs", productID, defectID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "components", Label: "Components", HxGet: base + "/components"},
		{ID: "capabilities", Label: "Capabilities", HxGet: base + "/capabilities"},
		{ID: "test-cases", Label: "Test Cases", HxGet: base + "/test-cases"},
		{ID: "requirements", Label: "Requirements", HxGet: base + "/requirements"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func defectEditHref(props DefectDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/defects/" + props.Defect.ID + "/edit"
	}
	return ""
}

func defectDeleteURL(props DefectDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/defects/" + props.Defect.ID
	}
	return ""
}


// defectArchiveProps describes the defect's archived state for its page
// header (FR-155).
func defectArchiveProps(props DefectDetailProps) patterns.ArchiveProps {
	return patterns.ArchiveProps{
		ItemURL:    fmt.Sprintf("/products/%s/defects/%s", props.Product.ID, props.Defect.ID),
		Kind:       "defect",
		Name:       ui.ItemName(props.Defect.Identifier, props.Defect.Title),
		Archived:   props.Defect.Archived(),
		Closed:     props.Overview.Status != nil && props.Overview.Status.IsClosed,
		CanArchive: props.CanEdit,
	}
}
