package product

import (
	"strings"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// RequirementFormProps holds data for the requirement create/edit form.
type RequirementFormProps struct {
	Meta             templates.PageMeta
	DisplayName      string
	IsAdmin          bool
	Product          *model.Product
	Requirement      *model.Requirement   // nil for create
	Requirements     []*model.Requirement // all requirements in product (for parent select)
	Categories       []*model.Category    // requirement categories for dropdown
	CategoryPrefixes map[string]string    // category ID → prefix (for parent options)
	Statuses         []*model.Status
	Milestones       []*model.Milestone
	Sprints          []*model.Sprint
	IsEdit           bool
	Error            string
	ReturnTo         string // "list" to return to list after save; empty = detail
	// LinkTo, when non-empty, switches the form into modal/htmx mode.
	// Format: "<entity>:<id>", e.g. "test_case:abc-123" or "capability:xyz-789".
	LinkTo string
	// Form values (preserved on validation error).
	Title            string
	Description      string
	DefinitionOfDone string
	CategoryID       string
	ParentID         string
	StatusID         string
	MilestoneID      string
	SprintID         string
	Estimation       string
	Priority         string
	IsCoarse         bool
}

templ RequirementFormPage(props RequirementFormProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "requirements",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="mx-auto max-w-2xl space-y-6">
			@ui.Breadcrumb(requirementFormBreadcrumbs(props))
			<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
				if props.IsEdit {
					Edit Requirement
				} else {
					New Requirement
				}
			</h1>
			@patterns.FormError(props.Error)
			@RequirementFormBody(props)
		</div>
	}
}

// RequirementFormModal wraps the form body in a modal dialog.
templ RequirementFormModal(props RequirementFormProps) {
	@ui.Modal("requirement-form-modal", requirementModalTitle(props), "lg") {
		@patterns.FormError(props.Error)
		@RequirementFormBody(props)
	}
}

// RequirementFormBody renders the inner form (Card + form fields) without page chrome.
templ RequirementFormBody(props RequirementFormProps) {
	@ui.Card() {
		@ui.CardBody() {
			<form
				method="post"
				action={ templ.SafeURL(requirementFormAction(props)) }
				if props.LinkTo != "" {
					hx-post={ requirementFormAction(props) }
					hx-target="#modal"
					hx-swap="innerHTML"
				}
				class="space-y-6"
			>
				<input type="hidden" name="csrf_token" value={ props.Meta.CSRFToken }/>
				<input type="hidden" name="_csrf" value={ props.Meta.CSRFToken }/>
				if props.ReturnTo != "" {
					<input type="hidden" name="return" value={ props.ReturnTo }/>
				}
				if props.LinkTo != "" {
					<input type="hidden" name="link_to" value={ props.LinkTo }/>
				}
				if props.IsEdit {
					@ui.TextInput(ui.InputProps{
						ID:       "identifier",
						Name:     "identifier",
						Label:    "Identifier",
						Value:    model.EntityIdentifier(formCategoryPrefix(props.Categories, props.Requirement.CategoryID), props.Requirement.SequenceNumber),
						Disabled: true,
					})
				}
				@ui.TextInput(ui.InputProps{
					ID:          "title",
					Name:        "title",
					Label:       "Title",
					Value:       props.Title,
					Placeholder: "e.g. Product owner can invite collaborators",
					Required:    true,
				})
				@ui.Select(ui.SelectProps{
					ID:      "category_id",
					Name:    "category_id",
					Label:   "Category",
					Value:   props.CategoryID,
					Options: dynamicCategorySelectOptions(props.Categories, props.CategoryID),
				})
				@ui.Select(ui.SelectProps{
					ID:       "parent_id",
					Name:     "parent_id",
					Label:    "Parent Requirement",
					Value:    props.ParentID,
					Options:  parentSelectOptions(props.Requirements, props.CategoryPrefixes, requirementSelfID(props)),
					HelpText: "Optional. Make this a child of another requirement.",
				})
				@ui.TextArea(ui.TextAreaProps{
					ID:          "description",
					Name:        "description",
					Label:       "Description",
					Value:       props.Description,
					Placeholder: "Describe this requirement... (Markdown supported)",
					Rows:        6,
				})
				@ui.TextArea(ui.TextAreaProps{
					ID:          "definition_of_done",
					Name:        "definition_of_done",
					Label:       "Definition of Done",
					Value:       props.DefinitionOfDone,
					Placeholder: "Acceptance criteria... (Markdown supported)",
					Rows:        4,
				})
				@ui.Select(ui.SelectProps{
					ID:       "status_id",
					Name:     "status_id",
					Label:    "Status",
					Value:    props.StatusID,
					Options:  statusSelectOptions(props.Statuses),
					HelpText: "Optional. Assign to a workflow status.",
				})
				@ui.Select(ui.SelectProps{
					ID:       "milestone_id",
					Name:     "milestone_id",
					Label:    "Milestone",
					Value:    props.MilestoneID,
					Options:  milestoneSelectOptions(props.Milestones),
					HelpText: "Optional. Link to a milestone.",
				})
				if props.Product.WorkflowMode == model.WorkflowModeScrum {
					@ui.Select(ui.SelectProps{
						ID:       "sprint_id",
						Name:     "sprint_id",
						Label:    "Sprint",
						Value:    props.SprintID,
						Options:  sprintSelectOptions(props.Sprints),
						HelpText: "Optional. Assign to a sprint.",
					})
				}
				@EstimationInput(EstimationInputProps{
					EstimationMode: props.Product.EstimationMode,
					Value:          props.Estimation,
				})
				@ui.TextInput(ui.InputProps{
					ID:          "priority",
					Name:        "priority",
					Label:       "Priority",
					Value:       props.Priority,
					Type:        "number",
					Placeholder: "0",
					HelpText:    "Lower numbers indicate higher priority.",
				})
				@ui.Checkbox("is_coarse", "is_coarse", "Needs refinement (coarse requirement)", props.IsCoarse, false)
				if props.LinkTo != "" {
					@requirementModalActions(requirementSubmitLabel(props.IsEdit))
				} else {
					@patterns.FormActions(requirementSubmitLabel(props.IsEdit), "/products/"+props.Product.ID+"/requirements")
				}
			</form>
		}
	}
}

templ requirementModalActions(submitLabel string) {
	<div class="flex items-center justify-end gap-3 pt-4">
		@ui.ModalCancelButton("modal")
		@ui.Button(ui.ButtonProps{
			Label:   submitLabel,
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
	</div>
}

func requirementFormBreadcrumbs(props RequirementFormProps) []templates.BreadcrumbItem {
	crumbs := []templates.BreadcrumbItem{
		{Label: "Dashboard", Href: "/"},
		{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
		{Label: "Requirements", Href: "/products/" + props.Product.ID + "/requirements"},
	}
	if props.IsEdit {
		crumbs = append(crumbs,
			templates.BreadcrumbItem{Label: model.EntityIdentifier(formCategoryPrefix(props.Categories, props.Requirement.CategoryID), props.Requirement.SequenceNumber), Href: "/products/" + props.Product.ID + "/requirements/" + props.Requirement.ID},
			templates.BreadcrumbItem{Label: "Edit"},
		)
	} else {
		crumbs = append(crumbs, templates.BreadcrumbItem{Label: "New"})
	}
	return crumbs
}

func requirementFormAction(props RequirementFormProps) string {
	if props.IsEdit {
		return "/products/" + props.Product.ID + "/requirements/" + props.Requirement.ID
	}
	if tcID, ok := strings.CutPrefix(props.LinkTo, "test_case:"); ok {
		return "/products/" + props.Product.ID + "/test-cases/" + tcID + "/requirements"
	}
	if capID, ok := strings.CutPrefix(props.LinkTo, "capability:"); ok {
		return "/products/" + props.Product.ID + "/capabilities/" + capID + "/requirements"
	}
	return "/products/" + props.Product.ID + "/requirements"
}

func requirementSubmitLabel(isEdit bool) string {
	if isEdit {
		return "Save Changes"
	}
	return "Create Requirement"
}

func requirementModalTitle(props RequirementFormProps) string {
	if props.IsEdit {
		return "Edit Requirement"
	}
	return "New Requirement"
}

func requirementSelfID(props RequirementFormProps) string {
	if props.IsEdit && props.Requirement != nil {
		return props.Requirement.ID
	}
	return ""
}

func parentSelectOptions(requirements []*model.Requirement, prefixes map[string]string, selfID string) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(requirements)+1)
	opts = append(opts, templates.SelectOption{Value: "", Label: "None"})
	for _, r := range requirements {
		if r.ID == selfID {
			continue
		}
		prefix := "??"
		if prefixes != nil {
			if p, ok := prefixes[r.CategoryID]; ok {
				prefix = p
			}
		}
		label := model.EntityIdentifier(prefix, r.SequenceNumber) + " \u2014 " + r.Title
		opts = append(opts, templates.SelectOption{Value: r.ID, Label: label})
	}
	return opts
}

func dynamicCategorySelectOptions(categories []*model.Category, currentID string) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(categories))
	for _, cat := range categories {
		opts = append(opts, templates.SelectOption{
			Value:    cat.ID,
			Label:    cat.Name,
			Selected: cat.ID == currentID,
		})
	}
	return opts
}

func formCategoryPrefix(categories []*model.Category, categoryID string) string {
	for _, cat := range categories {
		if cat.ID == categoryID {
			return cat.Prefix
		}
	}
	return "??"
}

// statusSelectOptions builds select options from statuses with an empty "None" option.
// Shared with defect_form.templ (same package).
func statusSelectOptions(statuses []*model.Status) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(statuses)+1)
	opts = append(opts, templates.SelectOption{Value: "", Label: "None"})
	for _, s := range statuses {
		opts = append(opts, templates.SelectOption{Value: s.ID, Label: s.Name})
	}
	return opts
}

// sprintSelectOptions builds select options from sprints with an empty "None" option.
// Shared with defect_form.templ (same package).
func sprintSelectOptions(sprints []*model.Sprint) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(sprints)+1)
	opts = append(opts, templates.SelectOption{Value: "", Label: "None"})
	for _, s := range sprints {
		opts = append(opts, templates.SelectOption{Value: s.ID, Label: s.Name})
	}
	return opts
}
