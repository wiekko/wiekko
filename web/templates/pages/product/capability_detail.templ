package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// CapabilityDetailProps holds data for the capability detail page.
type CapabilityDetailProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Capability     *model.Capability
	ComponentName  string
	MilestoneName  string
	IsOwnerOrAdmin bool
}

templ CapabilityDetailPage(props CapabilityDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "capabilities",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Capabilities", Href: "/products/" + props.Product.ID + "/capabilities"},
					{Label: props.Capability.Name},
				},
				props.Capability.Name,
				capabilitySubtitle(props.ComponentName),
				capabilityEditHref(props),
				capabilityDeleteURL(props),
				props.Meta.CSRFToken,
			)
			<!-- Tabs -->
			@ui.TabGroup(capabilityDetailTabs(props.Product.ID, props.Capability.ID))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@CapabilityOverviewTabContent(props.Product.ID, props.Capability, props.ComponentName, props.MilestoneName)
			}
			@ui.TabPanelHidden("requirements") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("defects") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ CapabilityOverviewTabContent(productID string, f *model.Capability, componentName, milestoneName string) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Component", capabilityComponentDisplay(componentName))
				@patterns.DetailField("Milestone", componentMilestoneDisplay(milestoneName))
				@patterns.DetailField("Created", formatDate(f.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(f.UpdatedAt))
			}
			@patterns.DetailDescription(f.Description)
		}
	}
}

// CapabilityRequirementsTabProps holds data for the capability requirements tab.
type CapabilityRequirementsTabProps struct {
	ProductID        string
	CapabilityID     string
	CSRFToken        string
	CanWrite         bool
	Requirements     []*model.Requirement
	CategoryPrefixes map[string]string
}

templ CapabilityRequirementsTabContent(props CapabilityRequirementsTabProps) {
	<div class="space-y-4">
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/capabilities/%s/requirements/link-modal", props.ProductID, props.CapabilityID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/capabilities/%s/requirements/create-modal", props.ProductID, props.CapabilityID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Requirements) == 0 {
			@ui.Card() {
				@ui.EmptyState("clipboard-list", "No linked requirements", "Requirements linked to this capability will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, req := range props.Requirements {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									{ model.EntityIdentifier(capabilityCategoryPrefix(props.CategoryPrefixes, req.CategoryID), req.SequenceNumber) }
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/requirements/%s", props.ProductID, req.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ req.Title }
									</a>
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink requirement"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/capabilities/%s/requirements/%s", props.ProductID, props.CapabilityID, req.ID) }
											hx-target="#tab-panel-requirements"
											hx-swap="innerHTML"
											hx-confirm="Unlink this requirement from the capability?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ CapabilityRequirementLinkModal(productID, capabilityID string) {
	@ui.Modal("requirement-link-modal", "Link existing requirement", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search requirements..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/capabilities/%s/requirements/link-search", productID, capabilityID) }
					hx-target="#requirement-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="requirement-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

templ CapabilityRequirementLinkResults(productID, capabilityID string, candidates []*model.Requirement, prefixes map[string]string) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching requirements.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, req := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">
							{ model.EntityIdentifier(capabilityCategoryPrefix(prefixes, req.CategoryID), req.SequenceNumber) } &mdash; { req.Title }
						</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/capabilities/%s/requirements/link", productID, capabilityID) }
						hx-vals={ fmt.Sprintf(`{"requirement_id":"%s"}`, req.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// CapabilityTestCasesTabProps holds data for the capability test-cases tab (FK 1:N).
type CapabilityTestCasesTabProps struct {
	ProductID    string
	CapabilityID string
	CSRFToken    string
	CanWrite     bool
	TestCases    []*model.TestCase
}

templ CapabilityTestCasesTabContent(props CapabilityTestCasesTabProps) {
	<div class="space-y-4">
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/capabilities/%s/test-cases/link-modal", props.ProductID, props.CapabilityID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/capabilities/%s/test-cases/create-modal", props.ProductID, props.CapabilityID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.TestCases) == 0 {
			@ui.Card() {
				@ui.EmptyState("beaker", "No test cases", "Test cases under this capability will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Mode
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, tc := range props.TestCases {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/test-cases/%s", props.ProductID, tc.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ tc.Title }
									</a>
								}
								@ui.TableCellMuted() {
									{ tc.ExecutionMode }
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink test case"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/capabilities/%s/test-cases/%s", props.ProductID, props.CapabilityID, tc.ID) }
											hx-target="#tab-panel-test-cases"
											hx-swap="innerHTML"
											hx-confirm="Unlink this test case from the capability?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

