						hx-post={ fmt.Sprintf("/products/%s/capabilities/%s/test-cases/link", productID, capabilityID) }
						hx-vals={ fmt.Sprintf(`{"test_case_id":"%s"}`, tc.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// CapabilityDefectsTabProps holds data for the capability defects tab.
type CapabilityDefectsTabProps struct {
	ProductID    string
	CapabilityID string
	CSRFToken    string
	CanLink      bool
	CanUnlink    bool
	Defects      []*model.Defect
	LinkIDs      map[string]string
}

templ CapabilityDefectsTabContent(props CapabilityDefectsTabProps) {
	<div class="space-y-4">
		if props.CanLink {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/capabilities/%s/defects/link-modal", props.ProductID, props.CapabilityID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/capabilities/%s/defects/create-modal", props.ProductID, props.CapabilityID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Defects) == 0 {
			@ui.Card() {
				@ui.EmptyState("bug", "No defects", "Defects linked to this capability will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Criticality
						}
						if props.CanUnlink {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, d := range props.Defects {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", props.ProductID, d.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ d.Title }
									</a>
								}
								@ui.TableCellMuted() {
									{ d.Criticality }
								}
								if props.CanUnlink {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink defect"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/capabilities/%s/defects/%s", props.ProductID, props.CapabilityID, props.LinkIDs[d.ID]) }
											hx-target="#tab-panel-defects"
											hx-swap="innerHTML"
											hx-confirm="Unlink this defect from the capability?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

