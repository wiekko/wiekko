}

templ CapabilityConstraintLinkResults(productID, capabilityID string, candidates []*model.Constraint, prefixes map[string]string) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching constraints.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, c := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ c.Title }</p>
						<p class="text-xs text-gray-500 dark:text-gray-400">{ model.EntityIdentifier(constraintPrefix(prefixes, c.CategoryID), c.SequenceNumber) }</p>
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/capabilities/%s/constraints/link", productID, capabilityID) }
						hx-vals={ fmt.Sprintf(`{"constraint_id":"%s"}`, c.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

func capabilityCategoryPrefix(prefixes map[string]string, categoryID string) string {
	if prefixes != nil {
		if p, ok := prefixes[categoryID]; ok {
			return p
		}
	}
	return "??"
}

templ CapabilityHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this capability will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// CapabilityDeleteConfirmation renders the delete confirmation for a capability.
templ CapabilityDeleteConfirmation(name, productID, capabilityID, csrfToken string) {
	@patterns.DeleteConfirmation("capability", name, fmt.Sprintf("/products/%s/capabilities/%s", productID, capabilityID), csrfToken)
}

func capabilityDetailTabs(productID, capabilityID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/capabilities/%s/tabs", productID, capabilityID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "requirements", Label: "Requirements", HxGet: base + "/requirements"},
		{ID: "test-cases", Label: "Test Cases", HxGet: base + "/test-cases"},
		{ID: "defects", Label: "Defects", HxGet: base + "/defects"},
		{ID: "constraints", Label: "Constraints", HxGet: base + "/constraints"},
		{ID: "documents", Label: "Documents", HxGet: base + "/documents"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func capabilitySubtitle(componentName string) string {
	if componentName != "" {
		return "Part of " + componentName
	}
	return "Top-level capability"
}

func capabilityEditHref(props CapabilityDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/capabilities/" + props.Capability.ID + "/edit"
	}
	return ""
}

func capabilityDeleteURL(props CapabilityDetailProps) string {
	if props.IsOwnerOrAdmin {
		return "/products/" + props.Product.ID + "/capabilities/" + props.Capability.ID
	}
	return ""
}

