package product

import (
	"strconv"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// OverviewProps holds data for the product overview page.
type OverviewProps struct {
	Meta             templates.PageMeta
	DisplayName      string
	IsAdmin          bool
	Product          *model.Product
	Role             string
	OpenRequirements int
	ActiveDefects    int
	CurrentSprint    string
	IsOwnerOrAdmin   bool
}

templ OverviewPage(props OverviewProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "overview",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name},
			})
			<!-- Page header -->
			<div class="flex items-start justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{ props.Product.Name }</h1>
					if props.Product.Description != "" {
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ props.Product.Description }</p>
					}
				</div>
				<div class="flex items-center gap-3">
					@roleBadge(props.Role)
					if props.IsOwnerOrAdmin {
						@ui.LinkButton("/products/"+props.Product.ID+"/settings", "Settings", "secondary", "md") {
							@ui.Icon("settings", "sm")
						}
						@ui.LinkButton("/products/"+props.Product.ID+"/team", "Team", "secondary", "md") {
							@ui.Icon("users", "sm")
						}
					}
				</div>
			</div>
			<!-- Metrics -->
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
				@metricCard("clipboard-list", "Open Requirements", strconv.Itoa(props.OpenRequirements))
				@metricCard("bug", "Active Defects", strconv.Itoa(props.ActiveDefects))
				if props.Product.WorkflowMode == "scrum" {
					if props.CurrentSprint != "" {
						@metricCard("clock", "Current Sprint", props.CurrentSprint)
					} else {
						@metricCard("clock", "Current Sprint", "None")
					}
				} else {
					@metricCard("kanban", "Workflow", "Kanban")
				}
			</div>
			<!-- Product details -->
			@ui.Card() {
				@ui.CardHeader("Details") {
				}
				@ui.CardBody() {
					@patterns.DetailGrid() {
						@patterns.DetailField("Workflow Mode", workflowModeLabel(props.Product.WorkflowMode))
						@patterns.DetailField("Estimation Mode", estimationModeLabel(props.Product.EstimationMode))
						@patterns.DetailField("Created", props.Product.CreatedAt)
					}
				}
			}
		</div>
	}
}

templ metricCard(icon, label, value string) {
	@ui.Card() {
		<div class="px-6 py-4">
			<div class="flex items-center gap-3">
				<div class="rounded-lg bg-indigo-50 p-2 dark:bg-indigo-900/30">
					<span class="text-indigo-600 dark:text-indigo-400">
						@ui.Icon(icon, "md")
					</span>
				</div>
				<div>
					<p class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</p>
					<p class="text-2xl font-bold text-gray-900 dark:text-gray-100">{ value }</p>
				</div>
			</div>
		</div>
	}
}

templ roleBadge(role string) {
	switch role {
		case "owner":
			@ui.Badge("Owner", "indigo")
		case "developer":
			@ui.Badge("Developer", "blue")
		case "tester":
			@ui.Badge("Tester", "green")
		case "viewer":
			@ui.Badge("Viewer", "gray")
		case "admin":
			@ui.Badge("Admin", "amber")
	}
}

func estimationModeLabel(mode string) string {
	switch mode {
	case "story_points":
		return "Story Points"
	case "tshirt_sizes":
		return "T-Shirt Sizes"
	case "hours":
		return "Hours"
	default:
		return "Disabled"
	}
}

func workflowModeLabel(mode string) string {
	switch mode {
	case "scrum":
		return "Scrum"
	default:
		return "Kanban"
	}
}
