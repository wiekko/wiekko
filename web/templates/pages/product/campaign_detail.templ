package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// CampaignDetailProps holds data for the campaign detail page.
type CampaignDetailProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Product     *model.Product
	Campaign    *model.TestingCampaign
	Progress    CampaignView
	Matrix      CampaignMatrixProps
	CanEdit     bool // owner or admin
}

templ CampaignDetailPage(props CampaignDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "campaigns",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Campaigns", Href: "/products/" + props.Product.ID + "/campaigns"},
					{Label: props.Campaign.Name},
				},
				props.Campaign.Name,
				campaignScheduleDisplay(props.Campaign),
				campaignEditHref(props),
				campaignDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@campaignStatusBadge(props.Campaign.Status)
				@campaignVerdictBadge(props.Progress.Verdict, props.Campaign.Status)
				if props.CanEdit {
					@campaignLifecycleActions(props)
				}
			}
			@ui.TabGroup(campaignDetailTabs(props.Product.ID, props.Campaign.ID))
			@ui.TabPanel("matrix") {
				@CampaignMatrixTabContent(props.Matrix)
			}
			@ui.TabPanelHidden("progress") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

// campaignLifecycleActions renders the draft > active > closed controls (FR-93).
templ campaignLifecycleActions(props CampaignDetailProps) {
	switch props.Campaign.Status {
		case model.CampaignStatusDraft:
			@ui.Button(ui.ButtonProps{
				Label:    "Activate",
				Variant:  "primary",
				Size:     "md",
				HxPost:   fmt.Sprintf("/products/%s/campaigns/%s/activate", props.Product.ID, props.Campaign.ID),
				HxTarget: "body",
				HxSwap:   "none",
			}) {
				@ui.Icon("play", "sm")
			}
		case model.CampaignStatusActive:
			@ui.Button(ui.ButtonProps{
				Label:    "Close",
				Variant:  "primary",
				Size:     "md",
				HxGet:    fmt.Sprintf("/products/%s/campaigns/%s/close/confirm", props.Product.ID, props.Campaign.ID),
				HxTarget: "#modal",
				HxSwap:   "innerHTML",
			}) {
				@ui.Icon("lock", "sm")
			}
	}
}

func campaignDetailTabs(productID, campaignID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/campaigns/%s/tabs", productID, campaignID)
	return []templates.TabDef{
		{ID: "matrix", Label: "Matrix", HxGet: base + "/matrix", Active: true},
		{ID: "progress", Label: "Progress", HxGet: base + "/progress"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

// A closed campaign is frozen (FR-106), so it offers no edit affordance.
func campaignEditHref(props CampaignDetailProps) string {
	if !props.CanEdit || props.Campaign.Status == model.CampaignStatusClosed {
		return ""
	}
	return fmt.Sprintf("/products/%s/campaigns/%s/edit", props.Product.ID, props.Campaign.ID)
}

func campaignDeleteURL(props CampaignDetailProps) string {
	if !props.CanEdit {
		return ""
	}
	return fmt.Sprintf("/products/%s/campaigns/%s", props.Product.ID, props.Campaign.ID)
}

// --- Matrix tab ---

// CampaignMatrixColumn is one runtime environment column. An empty ID is the
// column for test cases that define no environment matrix; a deleted
// environment's column is keyed by the name its results recorded.
type CampaignMatrixColumn struct {
	ID    string
	Label string
}

// CampaignMatrixRow is one test case, with cells aligned to the column list.
// A nil cell means the test case does not run in that environment. TestCase
// carries the campaign's copy of the title; its ID is empty once the test case
// has been deleted.
type CampaignMatrixRow struct {
	TestCase *model.TestCase
	Cells    []*model.CampaignResult
}

// CampaignMatrixGroup collects rows under a component or pyramid level (UC-81).
type CampaignMatrixGroup struct {
	Label string
	Rows  []CampaignMatrixRow
}

// CampaignMatrixProps holds the execution matrix (UC-79).
type CampaignMatrixProps struct {
	ProductID  string
	CampaignID string
	CSRFToken  string
	GroupBy    string // "component" or "pyramid"
	Columns    []CampaignMatrixColumn
	Groups     []CampaignMatrixGroup
	// CanExecute is false for viewers and for any campaign that is not active.
	CanExecute bool
	// Churn counts recorded changes per result id. Above one means the verdict
	// was revisited after it was first set.
	Churn map[string]int
}

templ CampaignMatrixTabContent(props CampaignMatrixProps) {
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			@campaignGroupToggle(props)
			@campaignMatrixLegend()
		</div>
		if len(props.Groups) == 0 {
			@ui.Card() {
				@ui.EmptyState("beaker", "No test cases", "This campaign has no test cases in scope.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Test Case
						}
						for _, col := range props.Columns {
							@ui.TableHeader() {
								if col.Label != "" {
									{ col.Label }
								} else {
									<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
								}
							}
						}
					}
					@ui.TableBody("") {
						for _, group := range props.Groups {
							<tr class="bg-gray-50 dark:bg-gray-800/60">
								<td
									colspan={ fmt.Sprintf("%d", len(props.Columns)+1) }
									class="px-6 py-2 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400"
								>
									{ group.Label }
								</td>
							</tr>
							for _, row := range group.Rows {
								@ui.TableRow("") {
									@ui.TableCell() {
										if row.TestCase.ID != "" {
											<a
												href={ templ.SafeURL(fmt.Sprintf("/products/%s/test-cases/%s", props.ProductID, row.TestCase.ID)) }
												class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
											>
												{ row.TestCase.Title }
											</a>
										} else {
											<span class="font-medium text-gray-500 dark:text-gray-400">{ row.TestCase.Title }</span>
										}
									}
									for _, cell := range row.Cells {
										@ui.TableCell() {
											@campaignMatrixCell(props, cell)
										}
									}
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// campaignMatrixCell renders one result. Every recorded result opens a panel:
// testers get the status picker plus the change log, everyone else gets the log
// on its own, so a closed campaign can still be read back (FR-124, FR-48).
templ campaignMatrixCell(props CampaignMatrixProps, result *model.CampaignResult) {
	if result == nil {
		@campaignResultIcon("")
	} else {
		<button
			type="button"
			class="relative rounded-md p-1 hover:bg-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none dark:hover:bg-gray-700"
			aria-label={ campaignCellLabel(props, result) }
			hx-get={ fmt.Sprintf("/products/%s/campaigns/%s/results/%s/status-menu?group=%s", props.ProductID, props.CampaignID, result.ID, props.GroupBy) }
			hx-target="#modal"
			hx-swap="innerHTML"
		>
			@campaignResultIcon(result.Status)
			if props.Churn[result.ID] > 1 {
				@campaignChurnDot()
			}
		</button>
	}
}

// campaignChurnDot marks a result whose verdict was changed after it was first
// recorded, so the matrix shows where results are being revisited.
templ campaignChurnDot() {
	<span
		class="absolute top-0 right-0 block size-1.5 rounded-full bg-amber-500 ring-1 ring-white dark:bg-amber-400 dark:ring-gray-800"
		aria-hidden="true"
	></span>
}

func campaignCellLabel(props CampaignMatrixProps, result *model.CampaignResult) string {
	action := "View result history"
	if props.CanExecute {
		action = "Set status"
	}
	label := action + ", currently " + campaignResultLabel(result.Status)
	if props.Churn[result.ID] > 1 {
		label += ", changed since first recorded"
	}
	return label
}

templ campaignGroupToggle(props CampaignMatrixProps) {
	<div class="inline-flex rounded-md shadow-sm" role="group">
		@campaignGroupToggleButton(props, "component", "Component")
		@campaignGroupToggleButton(props, "pyramid", "Pyramid Level")
	</div>
}

templ campaignGroupToggleButton(props CampaignMatrixProps, value, label string) {
	<button
		type="button"
		class={ "px-3 py-2 text-sm font-medium ring-1 ring-gray-300 ring-inset first:rounded-l-md last:rounded-r-md dark:ring-gray-600",
			campaignGroupToggleClass(props.GroupBy == value) }
		hx-get={ fmt.Sprintf("/products/%s/campaigns/%s/tabs/matrix?group=%s", props.ProductID, props.CampaignID, value) }
		hx-target="#tab-panel-matrix"
		hx-swap="innerHTML"
	>
		{ label }
	</button>
}

func campaignGroupToggleClass(active bool) string {
	if active {
		return "bg-indigo-600 text-white ring-indigo-600 dark:ring-indigo-500"
	}
	return "bg-white text-gray-700 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
}

templ campaignMatrixLegend() {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
		for _, status := range campaignResultStatuses() {
			<span class="inline-flex items-center gap-1">
				@campaignResultIcon(status)
				{ campaignResultLabel(status) }
			</span>
		}
		<span class="inline-flex items-center gap-1">
			<span class="relative inline-block size-4">
				@campaignChurnDot()
			</span>
			Changed since first recorded
		</span>
	</div>
}

// --- Result detail modal ---

// ResultEventView is one recorded change to a campaign result, ready to render.
type ResultEventView struct {
	UserName    string
	FromStatus  string // empty for the first recorded change
	ToStatus    string
	DefectID    string
	DefectTitle string
	At          string // pre-formatted
	// IsOverride marks a change that revised another person's verdict. It is
	// context, not a complaint: a re-test by a second tester is normal.
	IsOverride bool
}

// CampaignResultMenuProps holds one matrix cell's detail panel: the status
// picker for testers, and the change log for everyone (UC-79, FR-48).
type CampaignResultMenuProps struct {
	ProductID   string
	CampaignID  string
	Result      *model.CampaignResult
	TestCase    *model.TestCase
	Environment string
	// Description is the test's description as the campaign copied it.
	Description string
	// GroupBy is carried through so the matrix repaint keeps the grouping the
	// tester was looking at.
	GroupBy   string
	CSRFToken string
	// CanExecute gates the status picker. False leaves a read-only panel.
	CanExecute bool
	Events     []ResultEventView
}

templ CampaignResultStatusMenu(props CampaignResultMenuProps) {
	@ui.Modal("result-status-modal", props.TestCase.Title, "md") {
		if props.Environment != "" {
			<p class="text-sm text-gray-500 dark:text-gray-400">{ props.Environment }</p>
		}
		if props.Description != "" {
			<details class="mt-3 text-sm">
				<summary class="cursor-pointer font-medium text-gray-700 dark:text-gray-300">Test description</summary>
				<div class="prose prose-sm mt-2 max-w-none dark:prose-invert">
					@templ.Raw(templates.RenderMarkdown(props.Description))
				</div>
			</details>
		}
		if props.CanExecute {
			<div class="mt-4 space-y-1">
				for _, status := range campaignResultStatuses() {
					@campaignResultStatusOption(props, status)
				}
			</div>
			<p class="mt-4 text-xs text-gray-500 dark:text-gray-400">
				Failing a test case requires a defect. You can link an existing one or create it in the next step.
			</p>
		}
		@campaignResultHistory(props)
	}
}

// campaignResultHistory shows who set this result and when. Placed under the
// picker on purpose: a tester about to change a verdict sees whose it was first.
templ campaignResultHistory(props CampaignResultMenuProps) {
	<div class="mt-6 border-t border-gray-200 pt-4 dark:border-gray-700">
		<h4 class="text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
			History
		</h4>
		if len(props.Events) == 0 {
			<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
				This result has not been set yet.
			</p>
		} else {
			<ol class="mt-3 space-y-3">
				for _, ev := range props.Events {
					<li class="flex items-start gap-3 text-sm">
						<span class="w-28 shrink-0 pt-0.5 text-xs text-gray-500 dark:text-gray-400">
							{ ev.At }
						</span>
						<span class="min-w-0 flex-1">
							<span class="flex flex-wrap items-center gap-1.5">
								if ev.FromStatus != "" {
									@campaignResultIcon(ev.FromStatus)
									<span class="text-gray-500 dark:text-gray-400">{ campaignResultLabel(ev.FromStatus) }</span>
									@ui.Icon("arrow-right", "sm")
								}
								@campaignResultIcon(ev.ToStatus)
								<span class="font-medium text-gray-900 dark:text-gray-100">{ campaignResultLabel(ev.ToStatus) }</span>
							</span>
							<span class="mt-0.5 block text-xs text-gray-500 dark:text-gray-400">
								{ campaignEventActor(ev) }
								if ev.DefectTitle != "" {
									&nbsp;·&nbsp;
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", props.ProductID, ev.DefectID)) }
										class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ ev.DefectTitle }
									</a>
								}
							</span>
						</span>
					</li>
				}
			</ol>
		}
	</div>
}

// campaignEventActor phrases an event neutrally. An override is described as a
// change to a previous verdict, never as a conflict: the log exists for
// traceability, and blame-shaped wording would just discourage corrections.
func campaignEventActor(ev ResultEventView) string {
	if ev.IsOverride {
		return "Changed by " + ev.UserName
	}
	return "Set by " + ev.UserName
}

templ campaignResultStatusOption(props CampaignResultMenuProps, status string) {
	<button
		type="button"
		class={ "flex w-full items-center gap-3 rounded-md px-3 py-2 text-left text-sm hover:bg-gray-100 dark:hover:bg-gray-700",
			campaignResultOptionClass(props.Result.Status == status) }
		if status == model.CampaignResultStatusFailed {
			hx-get={ fmt.Sprintf("/products/%s/campaigns/%s/results/%s/defect-modal?group=%s", props.ProductID, props.CampaignID, props.Result.ID, props.GroupBy) }
		} else {
			hx-post={ fmt.Sprintf("/products/%s/campaigns/%s/results/%s/status", props.ProductID, props.CampaignID, props.Result.ID) }
			hx-vals={ fmt.Sprintf(`{"status": %q, "group": %q}`, status, props.GroupBy) }
		}
		hx-headers={ `{"X-CSRF-Token":"` + props.CSRFToken + `"}` }
		hx-target="#modal"
		hx-swap="innerHTML"
	>
		@campaignResultIcon(status)
		{ campaignResultLabel(status) }
	</button>
}

func campaignResultOptionClass(current bool) string {
	if current {
		return "bg-gray-100 font-medium dark:bg-gray-700"
	}
	return ""
}

// --- Progress tab ---

// CampaignProgressProps holds the progress breakdown (UC-82, UC-85).
type CampaignProgressProps struct {
	View CampaignView
	// Timeline is the cumulative settled count after each recorded event,
	// oldest first.
	Timeline []CampaignProgressPoint
}

// CampaignProgressPoint is one step of the progress-over-time series.
type CampaignProgressPoint struct {
	At      string
	Settled int
	Percent int
}

templ CampaignProgressTabContent(props CampaignProgressProps) {
	<div class="space-y-4">
		@ui.Card() {
			@ui.CardBody() {
				@ui.ProgressBar(props.View.Percent, campaignProgressColor(props.View.Verdict),
					fmt.Sprintf("%d of %d results tested", props.View.Settled, props.View.Total))
				<dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
					for _, status := range campaignResultStatuses() {
						<div class="rounded-md border border-gray-200 px-3 py-2 dark:border-gray-700">
							<dt class="flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
								@campaignResultIcon(status)
								{ campaignResultLabel(status) }
							</dt>
							<dd class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">
								{ fmt.Sprintf("%d", props.View.Counts[status]) }
							</dd>
						</div>
					}
				</dl>
			}
		}
		@ui.Card() {
			@ui.CardHeader("Progress over time")
			@ui.CardBody() {
				if len(props.Timeline) == 0 {
					<p class="text-sm text-gray-500 dark:text-gray-400">
						No results have been recorded yet.
					</p>
				} else {
					<ol class="space-y-3">
						for _, point := range props.Timeline {
							<li class="flex items-center gap-3">
								<span class="w-36 shrink-0 text-xs text-gray-500 dark:text-gray-400">
									{ formatDateTime(point.At) }
								</span>
								<span class="flex-1">
									@ui.ProgressBar(point.Percent, "indigo", "")
								</span>
								<span class="w-20 shrink-0 text-right text-xs text-gray-500 dark:text-gray-400">
									{ fmt.Sprintf("%d/%d", point.Settled, props.View.Total) }
								</span>
							</li>
						}
					</ol>
				}
			}
		}
	</div>
}

// --- History tab ---

// Campaign history filters. "all" is the default.
const (
	CampaignHistoryFilterAll       = "all"
	CampaignHistoryFilterOverrides = "overrides"
	CampaignHistoryFilterRetests   = "retests"
	CampaignHistoryFilterFailures  = "failures"
)

// CampaignHistoryEntry is one row of the campaign history: either a lifecycle
// audit entry or a result status change. Both answer "what happened here", so
// they share one feed rather than two tabs.
type CampaignHistoryEntry struct {
	Kind     string // "audit" or "result"
	At       string // pre-formatted
	RawAt    string // RFC 3339, for sorting before render
	UserName string

	// Audit is set when Kind is "audit".
	Audit *templates.AuditEntryView

	// Result fields, set when Kind is "result".
	TestCase    string
	Environment string
	FromStatus  string
	ToStatus    string
	DefectID    string
	DefectTitle string
	IsOverride  bool
	IsRetest    bool
}

// CampaignHistoryProps holds the merged campaign history feed (FR-48, UC-85).
type CampaignHistoryProps struct {
	ProductID  string
	CampaignID string
	Filter     string
	Entries    []CampaignHistoryEntry
}

templ CampaignHistoryTabContent(props CampaignHistoryProps) {
	<div class="space-y-4">
		@campaignHistoryFilter(props)
		if len(props.Entries) == 0 {
			@ui.Card() {
				@ui.EmptyState("history", "No history", campaignHistoryEmptyMessage(props.Filter), "", "")
			}
		} else {
			@ui.Card() {
				@ui.CardBody() {
					@campaignHistoryTimeline(props)
				}
			}
		}
	</div>
}

templ campaignHistoryFilter(props CampaignHistoryProps) {
	<div class="inline-flex rounded-md shadow-sm" role="group">
		@campaignHistoryFilterButton(props, CampaignHistoryFilterAll, "All")
		@campaignHistoryFilterButton(props, CampaignHistoryFilterOverrides, "Changed verdicts")
		@campaignHistoryFilterButton(props, CampaignHistoryFilterRetests, "Re-tests")
		@campaignHistoryFilterButton(props, CampaignHistoryFilterFailures, "Failures")
	</div>
}

templ campaignHistoryFilterButton(props CampaignHistoryProps, value, label string) {
	<button
		type="button"
		class={ "px-3 py-2 text-sm font-medium ring-1 ring-gray-300 ring-inset first:rounded-l-md last:rounded-r-md dark:ring-gray-600",
			campaignGroupToggleClass(props.Filter == value) }
		hx-get={ fmt.Sprintf("/products/%s/campaigns/%s/tabs/history?filter=%s", props.ProductID, props.CampaignID, value) }
		hx-target="#tab-panel-history"
		hx-swap="innerHTML"
	>
		{ label }
	</button>
}

// campaignHistoryTimeline mirrors patterns.AuditTimeline, but result events
// carry a from/to status pair and a defect link that AuditEntryView has no room
// for, and their icons come from this package.
templ campaignHistoryTimeline(props CampaignHistoryProps) {
	<div class="flow-root">
		<ul class="-mb-8">
			for i, entry := range props.Entries {
				<li>
					<div class="relative pb-8">
						if i < len(props.Entries)-1 {
							<span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200 dark:bg-gray-700"></span>
						}
						<div class="relative flex items-start space-x-3">
							<div class={ "flex h-8 w-8 items-center justify-center rounded-full ring-8 ring-white dark:ring-gray-950",
								campaignHistoryIconBg(entry) }>
								@ui.Icon(campaignHistoryIcon(entry), "sm")
							</div>
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ entry.UserName }</span>
									<span class="text-xs text-gray-500 dark:text-gray-400">{ entry.At }</span>
								</div>
								if entry.Kind == "result" {
									@campaignHistoryResultBody(props, entry)
								} else {
									<p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">
										{ patterns.AuditDescription(entry.Audit) }
									</p>
								}
							</div>
						</div>
					</div>
				</li>
			}
		</ul>
	</div>
}

templ campaignHistoryResultBody(props CampaignHistoryProps, entry CampaignHistoryEntry) {
	<p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">
		{ campaignHistoryVerb(entry) }
		<span class="font-medium text-gray-700 dark:text-gray-300">{ entry.TestCase }</span>
		if entry.Environment != "" {
			<span class="text-gray-400 dark:text-gray-500">&nbsp;·&nbsp;{ entry.Environment }</span>
		}
	</p>
	<span class="mt-1 flex flex-wrap items-center gap-1.5 text-sm">
		if entry.FromStatus != "" {
			@campaignResultIcon(entry.FromStatus)
			<span class="text-gray-500 dark:text-gray-400">{ campaignResultLabel(entry.FromStatus) }</span>
			@ui.Icon("arrow-right", "sm")
		}
		@campaignResultIcon(entry.ToStatus)
		<span class="font-medium text-gray-900 dark:text-gray-100">{ campaignResultLabel(entry.ToStatus) }</span>
		if entry.DefectTitle != "" {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/products/%s/defects/%s", props.ProductID, entry.DefectID)) }
				class="text-sm text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
			>
				{ entry.DefectTitle }
			</a>
		}
	</span>
}

// campaignHistoryVerb keeps the wording neutral. A changed verdict is reported
// as a change, not as a conflict.
func campaignHistoryVerb(entry CampaignHistoryEntry) string {
	if entry.IsOverride {
		return "Changed the result of "
	}
	return "Recorded a result for "
}

func campaignHistoryIcon(entry CampaignHistoryEntry) string {
	if entry.Kind != "result" {
		return patterns.AuditIcon(entry.Audit)
	}
	if entry.IsRetest {
		return "refresh-cw"
	}
	return campaignResultIconName(entry.ToStatus)
}

func campaignHistoryIconBg(entry CampaignHistoryEntry) string {
	if entry.Kind != "result" {
		return "bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400"
	}
	switch entry.ToStatus {
	case model.CampaignResultStatusPassed:
		return "bg-green-50 text-green-600 dark:bg-green-900/30 dark:text-green-400"
	case model.CampaignResultStatusFailed:
		return "bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-400"
	case model.CampaignResultStatusRetest:
		return "bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400"
	default:
		return "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400"
	}
}

func campaignHistoryEmptyMessage(filter string) string {
	switch filter {
	case CampaignHistoryFilterOverrides:
		return "No result has been changed after it was first recorded."
	case CampaignHistoryFilterRetests:
		return "No result has been sent back for re-testing."
	case CampaignHistoryFilterFailures:
		return "No result has been marked as failed."
	default:
		return "Changes to this campaign will be recorded here."
	}
}

// --- Close confirmation ---

// CampaignCloseProps holds the close confirmation dialog (FR-106, FR-107).
type CampaignCloseProps struct {
	ProductID  string
	CampaignID string
	Incomplete int
	CSRFToken  string
}

templ CampaignCloseConfirmation(props CampaignCloseProps) {
	@ui.ConfirmDialog(
		"campaign-close-confirm",
		"Close campaign",
		campaignCloseMessage(props.Incomplete),
		"Close campaign",
		string(ui.ConfirmDanger),
		"post",
		fmt.Sprintf("/products/%s/campaigns/%s/close", props.ProductID, props.CampaignID),
		props.CSRFToken,
	)
}

func campaignCloseMessage(incomplete int) string {
	if incomplete == 0 {
		return "Closing freezes all results. They can no longer be changed. This cannot be undone."
	}
	return fmt.Sprintf(
		"%d result(s) are still pending, blocked or awaiting re-test. Closing freezes them at their current status. This cannot be undone.",
		incomplete)
}

func formatDateTime(rfc3339 string) string {
	if len(rfc3339) >= 16 {
		return rfc3339[:10] + " " + rfc3339[11:16]
	}
	return formatDate(rfc3339)
}
