package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// ComponentsTableID is the element the components table controls swap.
const ComponentsTableID = "components-table"

// ComponentsProps holds data for the components list page.
type ComponentsProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Components     []*model.Component
	Milestones     map[string]string // milestone ID → name
	IsOwnerOrAdmin bool
	patterns.TableView
	MilestoneOptions []*model.Milestone
}

templ ComponentsPage(props ComponentsProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "components",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class={ patterns.TableViewPageClass }>
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Components"},
			})
			if props.ProductTotal == 0 {
				@patterns.ListPageHeader("Components", "", "", -1)
				@ui.Card() {
					@componentsEmpty(props)
				}
			} else {
				@patterns.TableHeader("Components", "components-count", props.CountLabel()) {
					if props.IsOwnerOrAdmin {
						@ui.LinkButton("/products/"+props.Product.ID+"/components/new", "New Component", "primary", "md") {
							@ui.Icon("plus", "sm")
						}
					}
				}
				<div id={ ComponentsTableID } class={ patterns.TableViewRegionClass }>
					@ComponentsTableContent(props)
				</div>
			}
		</div>
	}
}

// ComponentsTableContent renders the components table with its controls
// (UR-145).
templ ComponentsTableContent(props ComponentsProps) {
	{{ target := "#" + ComponentsTableID }}
	@patterns.TableFrame(props.Frame(componentsControls(props), "components-count", len(props.Components), componentsEmpty(props))) {
		@ui.Table() {
			@ui.TableHead() {
				@ui.SortHeader("Name", "name", props.State, target)
				@ui.SortHeader("Milestone", "milestone", props.State, target)
				@ui.SortHeader("Created", "created", props.State, target)
				if props.IsOwnerOrAdmin {
					@ui.TableHeader() {
						<span class="sr-only">Actions</span>
					}
				}
			}
			@ui.TableBody("") {
				for _, comp := range props.Components {
					@ui.TableRow("") {
						@ui.TableCell() {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", props.Product.ID, comp.ID)) }
								class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
							>
								{ comp.Name }
							</a>
						}
						@ui.TableCellMuted() {
							if comp.MilestoneID != "" {
								if name, ok := props.Milestones[comp.MilestoneID]; ok {
									{ name }
								} else {
									{ comp.MilestoneID }
								}
							} else {
								<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
							}
						}
						@ui.TableCellMuted() {
							{ formatDate(comp.CreatedAt) }
						}
						if props.IsOwnerOrAdmin {
							@ui.TableCell() {
								@patterns.RowActions(
									fmt.Sprintf("/products/%s/components/%s/edit?return=list", props.Product.ID, comp.ID),
									fmt.Sprintf("/products/%s/components/%s", props.Product.ID, comp.ID),
									props.Meta.CSRFToken,
								)
							}
						}
					}
				}
			}
		}
	}
}

templ componentsEmpty(props ComponentsProps) {
	if props.IsOwnerOrAdmin {
		@ui.EmptyState("component", "No components yet", "Create your first component to organise your product structure.", "New Component", "/products/"+props.Product.ID+"/components/new")
	} else {
		@ui.EmptyState("component", "No components yet", "No components have been created for this product.", "", "")
	}
}

func componentsControls(props ComponentsProps) patterns.TableControlsProps {
	var facets []patterns.TableFacet
	if len(props.MilestoneOptions) > 0 {
		facets = append(facets, milestoneFacet(props.MilestoneOptions))
	}
	return patterns.TableControlsProps{
		Key:    "component",
		Target: "#" + ComponentsTableID,
		Noun:   "components",
		Facets: facets,
	}
}

// milestoneFacet is the milestone facet of the tables that link milestones,
// with a choice for rows without one.
func milestoneFacet(milestones []*model.Milestone) patterns.TableFacet {
	values := make([]templates.SelectOption, 0, len(milestones))
	for _, m := range milestones {
		values = append(values, templates.SelectOption{Value: m.ID, Label: m.Name})
	}
	return patterns.TableFacet{Name: "milestone_id", Label: "Milestone",
		Options: patterns.FacetOptions("All milestones", "No milestone", values...)}
}
