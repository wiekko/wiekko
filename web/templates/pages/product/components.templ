package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// ComponentsProps holds data for the components list page.
type ComponentsProps struct {
	Meta           templates.PageMeta
	DisplayName    string
	IsAdmin        bool
	Product        *model.Product
	Components     []*model.Component
	Milestones     map[string]string // milestone ID → name
	IsOwnerOrAdmin bool
}

templ ComponentsPage(props ComponentsProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "components",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
	}) {
		<div class="space-y-6">
			@ui.Breadcrumb([]templates.BreadcrumbItem{
				{Label: "Dashboard", Href: "/"},
				{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
				{Label: "Components"},
			})
			if len(props.Components) == 0 {
				@patterns.ListPageHeader("Components", "", "", -1)
				@ui.Card() {
					if props.IsOwnerOrAdmin {
						@ui.EmptyState("component", "No components yet", "Create your first component to organise your product structure.", "New Component", "/products/"+props.Product.ID+"/components/new")
					} else {
						@ui.EmptyState("component", "No components yet", "No components have been created for this product.", "", "")
					}
				}
			} else {
				<div class="flex items-center justify-between">
					<div>
						<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Components</h1>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ fmt.Sprintf("%d items", len(props.Components)) }</p>
					</div>
					if props.IsOwnerOrAdmin {
						@ui.LinkButton("/products/"+props.Product.ID+"/components/new", "New Component", "primary", "md") {
							@ui.Icon("plus", "sm")
						}
					}
				</div>
				@ui.Card() {
					@ui.Table() {
						@ui.TableHead() {
							@ui.TableHeader() {
								Name
							}
							@ui.TableHeader() {
								Milestone
							}
							@ui.TableHeader() {
								Created
							}
						}
						@ui.TableBody("") {
							for _, comp := range props.Components {
								@ui.TableRow("") {
									@ui.TableCell() {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/products/%s/components/%s", props.Product.ID, comp.ID)) }
											class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
										>
											{ comp.Name }
										</a>
									}
									@ui.TableCellMuted() {
										if comp.MilestoneID != "" {
											if name, ok := props.Milestones[comp.MilestoneID]; ok {
												{ name }
											} else {
												{ comp.MilestoneID }
											}
										} else {
											<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
										}
									}
									@ui.TableCellMuted() {
										{ formatDate(comp.CreatedAt) }
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
