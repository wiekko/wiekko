package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// RequirementDetailProps holds data for the requirement detail page.
type RequirementDetailProps struct {
	Meta             templates.PageMeta
	DisplayName      string
	IsAdmin          bool
	Product          *model.Product
	Requirement      *model.Requirement
	CategoryPrefixes map[string]string // category ID → prefix
	CategoryNames    map[string]string // category ID → name
	Status           *model.Status
	MilestoneName    string
	SprintName       string
	ParentName       string // display name of parent requirement
	ParentIdentifier string // e.g. "FR-1"
	Children         []*model.Requirement
	Documents        []*model.Document // linked documents (FR-141)
	Components       []DerivedComponent // via its capabilities (UR-160)
	CanEdit          bool
}

templ RequirementDetailPage(props RequirementDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "requirements",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Requirements", Href: "/products/" + props.Product.ID + "/requirements"},
					{Label: model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), props.Requirement.SequenceNumber)},
				},
				props.Requirement.Title,
				model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), props.Requirement.SequenceNumber),
				requirementEditHref(props),
				requirementDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@ui.Badge(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), "blue")
			}
			<!-- Tabs -->
			@ui.TabGroup(requirementDetailTabs(props.Product.ID, props.Requirement.ID))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@RequirementOverviewTabContent(props)
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("defects") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ RequirementOverviewTabContent(props RequirementDetailProps) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Identifier", model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), props.Requirement.SequenceNumber))
				@patterns.DetailField("Category", requirementCategoryName(props.CategoryNames, props.Requirement.CategoryID))
				if props.Requirement.ParentID != "" && props.ParentName != "" {
					@requirementLinkedField("Parent", props.ParentIdentifier+" \u2014 "+props.ParentName, fmt.Sprintf("/products/%s/requirements/%s", props.Product.ID, props.Requirement.ParentID))
				} else {
					@patterns.DetailField("Parent", "")
				}
				@workflowStatusField(props.Status)
				if props.Requirement.MilestoneID != "" && props.MilestoneName != "" {
					@requirementLinkedField("Milestone", props.MilestoneName, fmt.Sprintf("/products/%s/milestones/%s", props.Product.ID, props.Requirement.MilestoneID))
				} else {
					@patterns.DetailField("Milestone", "")
				}
				if props.Product.WorkflowMode == model.WorkflowModeScrum {
					@patterns.DetailField("Sprint", props.SprintName)
				}
				if props.Product.EstimationMode != model.EstimationModeDisabled {
					@patterns.DetailField("Estimation", formatEstimation(props.Product.EstimationMode, props.Requirement.Estimation))
				}
				@patterns.DetailField("Priority", fmt.Sprintf("%d", props.Requirement.Priority))
				@patterns.DetailField("Coarse", boolDisplay(props.Requirement.IsCoarse))
				@patterns.DetailField("Active", boolDisplay(props.Requirement.IsActive))
				@patterns.DetailField("Created", formatDate(props.Requirement.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(props.Requirement.UpdatedAt))
			}
			@patterns.DetailDescription(props.Requirement.Description)
			@patterns.DetailMarkdownSection("Definition of Done", props.Requirement.DefinitionOfDone)
			@LinkedDocuments(props.Product.ID, props.Documents)
			@DerivedComponents(props.Product.ID, props.Components)
		}
	}
	if len(props.Children) > 0 {
		@ui.Card() {
			@ui.CardBody() {
				<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Children</h3>
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Category
						}
					}
					@ui.TableBody("") {
						for _, child := range props.Children {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									{ model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, child.CategoryID), child.SequenceNumber) }
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(backlogChildHref(props.Product.ID, child)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ child.Title }
									</a>
								}
								@ui.TableCellMuted() {
									@ui.Badge(requirementPrefix(props.CategoryPrefixes, child.CategoryID), backlogKindBadgeColor(child.Kind))
								}
							}
						}
					}
				}
			}
		}
	}
}

templ requirementLinkedField(label, name, href string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if name != "" {
				<a
					href={ templ.SafeURL(href) }
					class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
				>
					{ name }
				</a>
			} else {
				<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
			}
		</dd>
	</div>
}

// RequirementCapabilitiesTabProps holds data for the requirement capabilities tab.
type RequirementCapabilitiesTabProps struct {
	ProductID     string
	RequirementID string
	CSRFToken     string
	CanWrite      bool
	Capabilities  []*model.Capability
	ComponentName map[string]string // capabilityID → component name
}

templ RequirementCapabilitiesTabContent(props RequirementCapabilitiesTabProps) {
	<div class="space-y-4">
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/requirements/%s/capabilities/link-modal", props.ProductID, props.RequirementID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/requirements/%s/capabilities/create-modal", props.ProductID, props.RequirementID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.Capabilities) == 0 {
			@ui.Card() {
				@ui.EmptyState("layers", "No linked capabilities", "Capabilities linked to this requirement will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Name
						}
						@ui.TableHeader() {
							Component
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, cap := range props.Capabilities {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/capabilities/%s", props.ProductID, cap.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ cap.Name }
									</a>
								}
								@ui.TableCellMuted() {
									@componentLink(props.ProductID, cap.ComponentID, props.ComponentName[cap.ID])
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink capability"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/requirements/%s/capabilities/%s", props.ProductID, props.RequirementID, cap.ID) }
											hx-target="#tab-panel-capabilities"
											hx-swap="innerHTML"
											hx-confirm="Unlink this capability from the requirement?"
										>
											@ui.Icon("unlink", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// RequirementCapabilityLinkModal renders the "link existing capability" modal.
templ RequirementCapabilityLinkModal(productID, requirementID string) {
	@ui.Modal("capability-link-modal", "Link existing capability", "md") {
		<div class="space-y-4">
			<div class="relative">
				<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500">
					@ui.Icon("search", "sm")
				</div>
				<input
					type="search"
					name="q"
					placeholder="Search capabilities..."
					autofocus
					class="block w-full rounded-md border-0 py-2 pl-10 pr-3 text-gray-900 shadow-sm ring-1 ring-gray-300 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
					hx-get={ fmt.Sprintf("/products/%s/requirements/%s/capabilities/link-search", productID, requirementID) }
					hx-target="#capability-link-results"
					hx-swap="innerHTML"
					hx-trigger="keyup changed delay:300ms, search, load"
				/>
			</div>
			<div id="capability-link-results" class="min-h-[6rem]">
				@ui.LoadingSpinner("sm")
			</div>
		</div>
	}
}

// RequirementCapabilityLinkResults renders the search results inside the picker modal.
templ RequirementCapabilityLinkResults(productID, requirementID string, candidates []*model.Capability) {
	if len(candidates) == 0 {
		<p class="py-6 text-center text-sm text-gray-500 dark:text-gray-400">No matching capabilities.</p>
	} else {
		<ul class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, cap := range candidates {
				<li class="flex items-center justify-between gap-4 py-3">
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100">{ cap.Name }</p>
						if cap.Description != "" {
							<p class="truncate text-xs text-gray-500 dark:text-gray-400">{ cap.Description }</p>
						}
					</div>
					<button
						type="button"
						class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
						hx-post={ fmt.Sprintf("/products/%s/requirements/%s/capabilities/link", productID, requirementID) }
						hx-vals={ fmt.Sprintf(`{"capability_id":"%s"}`, cap.ID) }
						hx-target="#modal"
						hx-swap="innerHTML"
					>
						Link
					</button>
				</li>
			}
		</ul>
	}
}

// RequirementTestCasesTabProps holds data for the requirement test-cases tab.
type RequirementTestCasesTabProps struct {
	ProductID     string
	RequirementID string
	CSRFToken     string
	CanWrite      bool
	TestCases     []*model.TestCase
}

templ RequirementTestCasesTabContent(props RequirementTestCasesTabProps) {
	<div class="space-y-4">
		if props.CanWrite {
			<div class="flex items-center justify-end gap-2">
				@ui.Button(ui.ButtonProps{
					Label:    "Link existing",
					Variant:  "secondary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/requirements/%s/test-cases/link-modal", props.ProductID, props.RequirementID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("link", "sm")
				}
				@ui.Button(ui.ButtonProps{
					Label:    "Create new",
					Variant:  "primary",
					Size:     "sm",
					HxGet:    fmt.Sprintf("/products/%s/requirements/%s/test-cases/create-modal", props.ProductID, props.RequirementID),
					HxTarget: "#modal",
					HxSwap:   "innerHTML",
				}) {
					@ui.Icon("plus", "sm")
				}
			</div>
		}
		if len(props.TestCases) == 0 {
			@ui.Card() {
				@ui.EmptyState("beaker", "No linked test cases", "Test cases linked to this requirement will appear here.", "", "")
			}
		} else {
			@ui.Card() {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Mode
						}
						if props.CanWrite {
							@ui.TableHeader() {
							}
						}
					}
					@ui.TableBody("") {
						for _, tc := range props.TestCases {
							@ui.TableRow("") {
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/test-cases/%s", props.ProductID, tc.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ tc.Title }
									</a>
								}
								@ui.TableCellMuted() {
									{ tc.ExecutionMode }
								}
								if props.CanWrite {
									<td class="whitespace-nowrap px-6 py-4 text-right text-sm">
										<button
											type="button"
											aria-label="Unlink test case"
											class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-red-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-red-400"
											hx-delete={ fmt.Sprintf("/products/%s/requirements/%s/test-cases/%s", props.ProductID, props.RequirementID, tc.ID) }
											hx-target="#tab-panel-test-cases"
											hx-swap="innerHTML"
											hx-confirm="Unlink this test case from the requirement?"
										>
											@ui.Icon("trash", "sm")
										</button>
									</td>
								}
							}
						}
					}
				}
			}
		}
	</div>
}

