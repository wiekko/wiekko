package product

import (
	"fmt"

	"nexmap.net/internal/model"
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

// RequirementDetailProps holds data for the requirement detail page.
type RequirementDetailProps struct {
	Meta             templates.PageMeta
	DisplayName      string
	IsAdmin          bool
	Product          *model.Product
	Requirement      *model.Requirement
	CategoryPrefixes map[string]string // category ID → prefix
	CategoryNames    map[string]string // category ID → name
	StatusName       string
	MilestoneName    string
	SprintName       string
	ParentName       string // display name of parent requirement
	ParentIdentifier string // e.g. "FR-1"
	Children         []*model.Requirement
	CanEdit          bool
}

templ RequirementDetailPage(props RequirementDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "requirements",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="space-y-6">
			@patterns.DetailPageHeader(
				[]templates.BreadcrumbItem{
					{Label: "Dashboard", Href: "/"},
					{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
					{Label: "Requirements", Href: "/products/" + props.Product.ID + "/requirements"},
					{Label: model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), props.Requirement.SequenceNumber)},
				},
				props.Requirement.Title,
				model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), props.Requirement.SequenceNumber),
				requirementEditHref(props),
				requirementDeleteURL(props),
				props.Meta.CSRFToken,
			) {
				@ui.Badge(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), "blue")
			}
			<!-- Tabs -->
			@ui.TabGroup(requirementDetailTabs(props.Product.ID, props.Requirement.ID))
			<!-- Tab panels -->
			@ui.TabPanel("overview") {
				@RequirementOverviewTabContent(props)
			}
			@ui.TabPanelHidden("capabilities") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("test-cases") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("defects") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("comments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("attachments") {
				@ui.LoadingSpinner("md")
			}
			@ui.TabPanelHidden("history") {
				@ui.LoadingSpinner("md")
			}
		</div>
	}
}

templ RequirementOverviewTabContent(props RequirementDetailProps) {
	@ui.Card() {
		@ui.CardBody() {
			@patterns.DetailGrid() {
				@patterns.DetailField("Identifier", model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, props.Requirement.CategoryID), props.Requirement.SequenceNumber))
				@patterns.DetailField("Category", requirementCategoryName(props.CategoryNames, props.Requirement.CategoryID))
				if props.Requirement.ParentID != "" && props.ParentName != "" {
					@requirementLinkedField("Parent", props.ParentIdentifier+" \u2014 "+props.ParentName, fmt.Sprintf("/products/%s/requirements/%s", props.Product.ID, props.Requirement.ParentID))
				} else {
					@patterns.DetailField("Parent", "")
				}
				@patterns.DetailField("Status", props.StatusName)
				if props.Requirement.MilestoneID != "" && props.MilestoneName != "" {
					@requirementLinkedField("Milestone", props.MilestoneName, fmt.Sprintf("/products/%s/milestones/%s", props.Product.ID, props.Requirement.MilestoneID))
				} else {
					@patterns.DetailField("Milestone", "")
				}
				if props.Product.WorkflowMode == model.WorkflowModeScrum {
					@patterns.DetailField("Sprint", props.SprintName)
				}
				if props.Product.EstimationMode != model.EstimationModeDisabled {
					@patterns.DetailField("Estimation", formatEstimation(props.Product.EstimationMode, props.Requirement.Estimation))
				}
				@patterns.DetailField("Priority", fmt.Sprintf("%d", props.Requirement.Priority))
				@patterns.DetailField("Coarse", boolDisplay(props.Requirement.IsCoarse))
				@patterns.DetailField("Active", boolDisplay(props.Requirement.IsActive))
				@patterns.DetailField("Created", formatDate(props.Requirement.CreatedAt))
				@patterns.DetailField("Last Updated", formatDate(props.Requirement.UpdatedAt))
			}
			@patterns.DetailDescription(props.Requirement.Description)
			@patterns.DetailMarkdownSection("Definition of Done", props.Requirement.DefinitionOfDone)
		}
	}
	if len(props.Children) > 0 {
		@ui.Card() {
			@ui.CardBody() {
				<h3 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Child Requirements</h3>
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							ID
						}
						@ui.TableHeader() {
							Title
						}
						@ui.TableHeader() {
							Category
						}
					}
					@ui.TableBody("") {
						for _, child := range props.Children {
							@ui.TableRow("") {
								@ui.TableCellMuted() {
									{ model.EntityIdentifier(requirementPrefix(props.CategoryPrefixes, child.CategoryID), child.SequenceNumber) }
								}
								@ui.TableCell() {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/products/%s/requirements/%s", props.Product.ID, child.ID)) }
										class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
									>
										{ child.Title }
									</a>
								}
								@ui.TableCellMuted() {
									@ui.Badge(requirementPrefix(props.CategoryPrefixes, child.CategoryID), "blue")
								}
							}
						}
					}
				}
			}
		}
	}
}

templ requirementLinkedField(label, name, href string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if name != "" {
				<a
					href={ templ.SafeURL(href) }
					class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300"
				>
					{ name }
				</a>
			} else {
				<span class="text-gray-400 dark:text-gray-500">&mdash;</span>
			}
		</dd>
	</div>
}

templ RequirementCapabilitiesTabContent() {
	@ui.Card() {
		@ui.EmptyState("layers", "No linked capabilities", "Capabilities linked to this requirement will appear here.", "", "")
	}
}

templ RequirementTestCasesTabContent() {
	@ui.Card() {
		@ui.EmptyState("beaker", "No linked test cases", "Test cases linked to this requirement will appear here.", "", "")
	}
}

templ RequirementDefectsTabContent() {
	@ui.Card() {
		@ui.EmptyState("bug", "No linked defects", "Defects linked to this requirement will appear here.", "", "")
	}
}

templ RequirementCommentsTabContent() {
	@ui.Card() {
		@ui.EmptyState("message-circle", "No comments", "Comments on this requirement will appear here.", "", "")
	}
}

templ RequirementAttachmentsTabContent() {
	@ui.Card() {
		@ui.EmptyState("paperclip", "No attachments", "Attachments for this requirement will appear here.", "", "")
	}
}

templ RequirementHistoryTabContent(entries []templates.AuditEntryView) {
	if len(entries) == 0 {
		@ui.Card() {
			@ui.EmptyState("history", "No history", "Changes to this requirement will be recorded here.", "", "")
		}
	} else {
		@patterns.AuditTimeline(entries)
	}
}

// RequirementDeleteConfirmation renders the delete confirmation for a requirement.
templ RequirementDeleteConfirmation(name, productID, requirementID string) {
	@patterns.DeleteConfirmation("requirement", fmt.Sprintf("/products/%s/requirements/%s", productID, requirementID))
}

func requirementDetailTabs(productID, requirementID string) []templates.TabDef {
	base := fmt.Sprintf("/products/%s/requirements/%s/tabs", productID, requirementID)
	return []templates.TabDef{
		{ID: "overview", Label: "Overview", HxGet: base + "/overview", Active: true},
		{ID: "capabilities", Label: "Capabilities", HxGet: base + "/capabilities"},
		{ID: "test-cases", Label: "Test Cases", HxGet: base + "/test-cases"},
		{ID: "defects", Label: "Defects", HxGet: base + "/defects"},
		{ID: "comments", Label: "Comments", HxGet: base + "/comments"},
		{ID: "attachments", Label: "Attachments", HxGet: base + "/attachments"},
		{ID: "history", Label: "History", HxGet: base + "/history"},
	}
}

func requirementEditHref(props RequirementDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/requirements/" + props.Requirement.ID + "/edit"
	}
	return ""
}

func requirementDeleteURL(props RequirementDetailProps) string {
	if props.CanEdit {
		return "/products/" + props.Product.ID + "/requirements/" + props.Requirement.ID
	}
	return ""
}

func requirementCategoryName(names map[string]string, categoryID string) string {
	if names != nil {
		if n, ok := names[categoryID]; ok {
			return n
		}
	}
	return "Unknown"
}

func boolDisplay(v bool) string {
	if v {
		return "Yes"
	}
	return "No"
}
