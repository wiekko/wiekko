package product

import (
	"slices"
	"strings"

	"wiekko.net/internal/model"
	"wiekko.net/web/templates"
	layout "wiekko.net/web/templates/layout"
	"wiekko.net/web/templates/patterns"
	"wiekko.net/web/templates/ui"
)

// TestCaseFormProps holds data for the test case create/edit form.
type TestCaseFormProps struct {
	Meta          templates.PageMeta
	DisplayName   string
	IsAdmin       bool
	Product       *model.Product
	TestCase      *model.TestCase // nil for create
	Components    []*model.Component
	Capabilities  []*model.Capability
	PyramidLevels []*model.PyramidLevel
	// Environments is the product's runtime environment list. Empty hides the
	// picker entirely, which is also how the create-and-link modals render.
	Environments []*model.RuntimeEnvironment
	IsEdit       bool
	Error        string
	ReturnTo      string // "list" to return to list after save; empty = detail
	// LinkTo, when non-empty, switches the form into modal/htmx mode.
	// Format: "<entity>:<id>", e.g. "requirement:abc-123".
	LinkTo string
	// Form values (preserved on validation error).
	Title          string
	Description    string
	ExecutionMode  string
	TestIdentifier string
	ComponentID    string
	CapabilityID   string
	PyramidLevelID string
	EnvironmentIDs []string
}

templ TestCaseFormPage(props TestCaseFormProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "test-cases",
		ProductID:     props.Product.ID,
		ProductName:   props.Product.Name,
		WorkflowMode:  props.Product.WorkflowMode,
	}) {
		<div class="mx-auto max-w-2xl space-y-6">
			@ui.Breadcrumb(testCaseFormBreadcrumbs(props))
			<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
				if props.IsEdit {
					Edit Test Case
				} else {
					New Test Case
				}
			</h1>
			@patterns.FormError(props.Error)
			@TestCaseFormBody(props)
		</div>
	}
}

// TestCaseFormModal wraps the form body in a modal dialog.
templ TestCaseFormModal(props TestCaseFormProps) {
	@ui.Modal("test-case-form-modal", testCaseModalTitle(props), "lg") {
		@patterns.FormError(props.Error)
		@TestCaseFormBody(props)
	}
}

// TestCaseFormBody renders the inner form (Card + form fields) without page chrome.
templ TestCaseFormBody(props TestCaseFormProps) {
	@ui.Card() {
		@ui.CardBody() {
			<form
				method="post"
				action={ templ.SafeURL(testCaseFormAction(props)) }
				if props.LinkTo != "" {
					hx-post={ testCaseFormAction(props) }
					hx-target="#modal"
					hx-swap="innerHTML"
				}
				class="space-y-6"
			>
				<input type="hidden" name="_csrf" value={ props.Meta.CSRFToken }/>
				if props.TestCase != nil {
					// The version being edited: a change saved meanwhile is reported
					// as a conflict instead of being overwritten.
					<input type="hidden" name="updated_at" value={ props.TestCase.UpdatedAt }/>
				}
				if props.ReturnTo != "" {
					<input type="hidden" name="return" value={ props.ReturnTo }/>
				}
				if props.LinkTo != "" {
					<input type="hidden" name="link_to" value={ props.LinkTo }/>
				}
				@ui.TextInput(ui.InputProps{
					ID:          "title",
					Name:        "title",
					Label:       "Title",
					Value:       props.Title,
					Placeholder: "e.g. Login with valid credentials",
					Required:    true,
				})
				@ui.TextArea(ui.TextAreaProps{
					ID:          "description",
					Name:        "description",
					Label:       "Description",
					Value:       props.Description,
					Placeholder: "Describe this test case...",
					Rows:        4,
				})
				@ui.Select(ui.SelectProps{
					ID:       "execution_mode",
					Name:     "execution_mode",
					Label:    "Execution Mode",
					Value:    props.ExecutionMode,
					Options:  executionModeOptions(props.ExecutionMode),
					HelpText: "Manual tests are executed by testers. Automatic tests are linked to code.",
				})
				@ui.TextInput(ui.InputProps{
					ID:          "test_identifier",
					Name:        "test_identifier",
					Label:       "Test Identifier",
					Value:       props.TestIdentifier,
					Placeholder: "e.g. TestLoginWithValidCredentials",
					HelpText:    "Code test function name. Required for automatic tests.",
				})
				@ui.Select(ui.SelectProps{
					ID:       "component_id",
					Name:     "component_id",
					Label:    "Component",
					Value:    props.ComponentID,
					Options:  componentSelectOptions(props.Components),
					HelpText: "Optional. Assign to a component.",
				})
				@ui.Select(ui.SelectProps{
					ID:       "capability_id",
					Name:     "capability_id",
					Label:    "Capability",
					Value:    props.CapabilityID,
					Options:  capabilitySelectOptions(props.Capabilities),
					HelpText: "Optional. Assign to a capability.",
				})
				@ui.Select(ui.SelectProps{
					ID:       "pyramid_level_id",
					Name:     "pyramid_level_id",
					Label:    "Pyramid Level",
					Value:    props.PyramidLevelID,
					Options:  pyramidLevelSelectOptions(props.PyramidLevels),
					HelpText: "Optional. Categorize by test pyramid level.",
				})
				if len(props.Environments) > 0 {
					@testCaseEnvironmentPicker(props)
				}
				if props.LinkTo != "" {
					@testCaseModalActions(testCaseSubmitLabel(props.IsEdit))
				} else {
					@patterns.FormActions(testCaseSubmitLabel(props.IsEdit), "/products/"+props.Product.ID+"/test-cases")
				}
			</form>
		}
	}
}

// testCaseEnvironmentPicker selects the runtime environments a test case runs
// in. Each one becomes a column of the campaign matrix (FR-25).
templ testCaseEnvironmentPicker(props TestCaseFormProps) {
	<div>
		<span class="block text-sm font-medium text-gray-700 dark:text-gray-300">Runtime Environments</span>
		<div class="mt-1 flex flex-wrap gap-x-6 gap-y-2 rounded-md px-3 py-2 ring-1 ring-gray-300 ring-inset dark:ring-gray-600">
			for _, env := range props.Environments {
				<label class="flex cursor-pointer items-center gap-2">
					<input
						type="checkbox"
						name="environment_ids"
						value={ env.ID }
						checked?={ testCaseEnvSelected(props, env.ID) }
						class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600 dark:border-gray-600 dark:bg-gray-800"
					/>
					<span class="text-sm text-gray-700 dark:text-gray-300">{ env.Name }</span>
				</label>
			}
		</div>
		<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
			Optional. The test case is executed once per selected environment, each of which becomes a column in the campaign matrix.
		</p>
	</div>
}

templ testCaseModalActions(submitLabel string) {
	<div class="flex items-center justify-end gap-3 pt-4">
		@ui.ModalCancelButton("modal")
		@ui.Button(ui.ButtonProps{
			Label:   submitLabel,
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
	</div>
}

func testCaseFormBreadcrumbs(props TestCaseFormProps) []templates.BreadcrumbItem {
	crumbs := []templates.BreadcrumbItem{
		{Label: "Dashboard", Href: "/"},
		{Label: props.Product.Name, Href: "/products/" + props.Product.ID},
		{Label: "Test Cases", Href: "/products/" + props.Product.ID + "/test-cases"},
	}
	if props.IsEdit {
		crumbs = append(crumbs,
			templates.BreadcrumbItem{Label: props.TestCase.Title, Href: "/products/" + props.Product.ID + "/test-cases/" + props.TestCase.ID},
			templates.BreadcrumbItem{Label: "Edit"},
		)
	} else {
		crumbs = append(crumbs, templates.BreadcrumbItem{Label: "New"})
	}
	return crumbs
}

func testCaseFormAction(props TestCaseFormProps) string {
	if props.IsEdit {
		return "/products/" + props.Product.ID + "/test-cases/" + props.TestCase.ID
	}
	if reqID, ok := strings.CutPrefix(props.LinkTo, "requirement:"); ok {
		return "/products/" + props.Product.ID + "/requirements/" + reqID + "/test-cases"
	}
	if conID, ok := strings.CutPrefix(props.LinkTo, "constraint:"); ok {
		return "/products/" + props.Product.ID + "/constraints/" + conID + "/test-cases"
	}
	if capID, ok := strings.CutPrefix(props.LinkTo, "capability:"); ok {
		return "/products/" + props.Product.ID + "/capabilities/" + capID + "/test-cases"
	}
	if compID, ok := strings.CutPrefix(props.LinkTo, "component:"); ok {
		return "/products/" + props.Product.ID + "/components/" + compID + "/test-cases"
	}
	if defectID, ok := strings.CutPrefix(props.LinkTo, "defect:"); ok {
		return "/products/" + props.Product.ID + "/defects/" + defectID + "/test-cases"
	}
	return "/products/" + props.Product.ID + "/test-cases"
}

func testCaseEnvSelected(props TestCaseFormProps, envID string) bool {
	return slices.Contains(props.EnvironmentIDs, envID)
}

func testCaseSubmitLabel(isEdit bool) string {
	if isEdit {
		return "Save Changes"
	}
	return "Create Test Case"
}

func testCaseModalTitle(props TestCaseFormProps) string {
	if props.IsEdit {
		return "Edit Test Case"
	}
	return "New Test Case"
}

func executionModeOptions(current string) []templates.SelectOption {
	if current == "" {
		current = "manual"
	}
	return []templates.SelectOption{
		{Value: "manual", Label: "Manual", Selected: current == "manual"},
		{Value: "automatic", Label: "Automatic", Selected: current == "automatic"},
	}
}

// capabilitySelectOptions builds select options from capabilities with an empty "None" option.
func capabilitySelectOptions(capabilities []*model.Capability) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(capabilities)+1)
	opts = append(opts, templates.SelectOption{Value: "", Label: "None"})
	for _, f := range capabilities {
		opts = append(opts, templates.SelectOption{Value: f.ID, Label: f.Name})
	}
	return opts
}

// pyramidLevelSelectOptions builds select options from pyramid levels with an empty "None" option.
func pyramidLevelSelectOptions(levels []*model.PyramidLevel) []templates.SelectOption {
	opts := make([]templates.SelectOption, 0, len(levels)+1)
	opts = append(opts, templates.SelectOption{Value: "", Label: "None"})
	for _, l := range levels {
		opts = append(opts, templates.SelectOption{Value: l.ID, Label: l.Name})
	}
	return opts
}
