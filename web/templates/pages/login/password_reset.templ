package login

import (
	"wiekko.net/web/templates"
	layout "wiekko.net/web/templates/layout"
	"wiekko.net/web/templates/patterns"
	"wiekko.net/web/templates/ui"
)

// ForgotPasswordProps drives the form that asks for a password reset link.
type ForgotPasswordProps struct {
	Identifier string
	Error      string
	// Sent replaces the form with the confirmation. It reads the same whether
	// or not an account matched, so the page tells nothing about accounts.
	Sent bool
}

// ForgotPasswordPage renders the "forgot password" form as a full page.
templ ForgotPasswordPage(props ForgotPasswordProps) {
	@layout.AuthLayout(templates.PageMeta{Title: "Reset your password"}) {
		@ForgotPasswordForm(props)
		<p class="mt-6 text-center text-sm">
			<a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Back to sign in</a>
		</p>
	}
}

// ForgotPasswordForm is the form, or the confirmation once it was sent. Used
// on full page load and as htmx fragment.
templ ForgotPasswordForm(props ForgotPasswordProps) {
	if props.Sent {
		<div id="forgot-password-form" class="space-y-4">
			<div class="flex items-start gap-3">
				<div class="mt-0.5 text-indigo-600 dark:text-indigo-400">
					@ui.Icon("mail", "md")
				</div>
				<p class="text-sm text-gray-600 dark:text-gray-400">
					If an account matches what you entered, a link to choose a new password is on its way to the email address of that account. The link expires in 60 minutes.
				</p>
			</div>
			<p class="text-sm text-gray-500 dark:text-gray-400">
				Nothing arrived? Check your spam folder, or ask an administrator to set a new password for you.
			</p>
		</div>
	} else {
		<form id="forgot-password-form" class="space-y-6" method="post" action="/forgot-password" hx-post="/forgot-password" hx-target="this" hx-swap="outerHTML">
			<p class="text-sm text-gray-600 dark:text-gray-400">
				Enter your username or email address. We will send a link to choose a new password to the email address of your account.
			</p>
			@patterns.FormError(props.Error)
			@ui.TextInput(ui.InputProps{
				ID:        "identifier",
				Name:      "identifier",
				Label:     "Username or email",
				Value:     props.Identifier,
				Required:  true,
				Autofocus: true,
			})
			@ui.Button(ui.ButtonProps{
				Label:   "Send reset link",
				Variant: "primary",
				Size:    "md",
				Type:    "submit",
			})
		</form>
	}
}

// ResetPasswordPage renders the form to choose a new password through a reset
// link.
templ ResetPasswordPage(action, errorMessage string) {
	@layout.AuthLayout(templates.PageMeta{Title: "Choose a new password"}) {
		@ResetPasswordForm(action, errorMessage)
	}
}

// ResetPasswordForm is the new-password form. Used on full page load and as
// htmx fragment after a failed submit.
templ ResetPasswordForm(action, errorMessage string) {
	<form id="reset-password-form" class="space-y-6" method="post" action={ templ.SafeURL(action) } hx-post={ action } hx-target="this" hx-swap="outerHTML">
		@patterns.FormError(errorMessage)
		@ui.TextInput(ui.InputProps{
			ID:        "password",
			Name:      "password",
			Label:     "New password",
			Type:      "password",
			Required:  true,
			Autofocus: true,
		})
		@ui.TextInput(ui.InputProps{
			ID:       "password_confirm",
			Name:     "password_confirm",
			Label:    "Confirm new password",
			Type:     "password",
			Required: true,
		})
		<p class="text-sm text-gray-500 dark:text-gray-400">
			Setting a new password signs you out everywhere. Two-factor authentication, if you use it, stays on.
		</p>
		@ui.Button(ui.ButtonProps{
			Label:   "Set new password",
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
	</form>
}
