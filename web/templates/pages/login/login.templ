package login

import (
	"wiekko.net/web/templates"
	layout "wiekko.net/web/templates/layout"
	"wiekko.net/web/templates/patterns"
	"wiekko.net/web/templates/ui"
)

// LoginPage renders the sign-in page. showForgot offers the password reset,
// which exists only when the installation sends email.
templ LoginPage(showRegister, showForgot bool, errorMessage string) {
	@layout.AuthLayout(templates.PageMeta{Title: "Sign in to your account"}) {
		@LoginForm(showRegister, errorMessage)
		<div class="mt-6 space-y-2 text-center text-sm">
			if showRegister {
				<p class="text-gray-500 dark:text-gray-400">
					Don't have an account?
					<a href="/register" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Register</a>
				</p>
			}
			if showForgot {
				<p class="text-gray-500 dark:text-gray-400">
					<a href="/forgot-password" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Forgot your password?</a>
				</p>
			} else {
				<p class="text-gray-500 dark:text-gray-400">
					Forgot your password? Ask an administrator to set a new one.
				</p>
			}
		</div>
	}
}

// LoginForm renders the login form. Used both on full page load and as htmx fragment on error.
templ LoginForm(showRegister bool, errorMessage string) {
	<form id="login-form" class="space-y-6" hx-post="/login" hx-target="this" hx-swap="outerHTML">
		@patterns.FormError(errorMessage)
		@ui.TextInput(ui.InputProps{
			ID:          "username",
			Name:        "username",
			Label:       "Username",
			Placeholder: "Enter your username",
			Required:    true,
		})
		@ui.TextInput(ui.InputProps{
			ID:          "password",
			Name:        "password",
			Label:       "Password",
			Type:        "password",
			Placeholder: "Enter your password",
			Required:    true,
		})
		@ui.Button(ui.ButtonProps{
			Label:   "Sign in",
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
	</form>
}

// TOTPPage renders the second login step as a full page (non-htmx fallback).
templ TOTPPage(errorMessage string) {
	@layout.AuthLayout(templates.PageMeta{Title: "Two-factor authentication"}) {
		@TOTPForm(errorMessage)
	}
}

// TOTPForm asks for the TOTP or recovery code after the password was accepted.
// It replaces the login form in place (same id), so htmx can swap either way.
templ TOTPForm(errorMessage string) {
	<form id="login-form" class="space-y-6" hx-post="/login/totp" hx-target="this" hx-swap="outerHTML" method="post" action="/login/totp">
		<div class="flex items-start gap-3">
			<div class="mt-0.5 text-indigo-600 dark:text-indigo-400">
				@ui.Icon("shield-check", "md")
			</div>
			<p class="text-sm text-gray-600 dark:text-gray-400">
				Enter the 6-digit code from your authenticator app. If you have lost access to it, enter one of your recovery codes instead.
			</p>
		</div>
		@patterns.FormError(errorMessage)
		@ui.CodeInput(ui.CodeInputProps{
			ID:            "totp-code",
			Name:          "code",
			Label:         "Authentication code",
			Autofocus:     true,
			AllowRecovery: true,
		})
		@ui.Button(ui.ButtonProps{
			Label:   "Verify",
			Variant: "primary",
			Size:    "md",
			Type:    "submit",
		})
		<p class="text-center text-sm">
			<a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Back to sign in</a>
		</p>
	</form>
}
