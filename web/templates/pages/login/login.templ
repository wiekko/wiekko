package login

import (
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
)

templ LoginPage(showRegister bool) {
	@layout.AuthLayout(templates.PageMeta{Title: "Sign in to your account"}) {
		<form id="login-form" class="space-y-6" onsubmit="return handleLogin(event)">
			@patterns.FormError("")
			<div id="login-error"></div>
			@ui.TextInput(ui.InputProps{
				ID:          "username",
				Name:        "username",
				Label:       "Username",
				Placeholder: "Enter your username",
				Required:    true,
			})
			@ui.TextInput(ui.InputProps{
				ID:          "password",
				Name:        "password",
				Label:       "Password",
				Type:        "password",
				Placeholder: "Enter your password",
				Required:    true,
			})
			@ui.Button(ui.ButtonProps{
				Label:   "Sign in",
				Variant: "primary",
				Size:    "md",
				Type:    "submit",
			})
		</form>
		<div class="mt-6 space-y-2 text-center text-sm">
			if showRegister {
				<p class="text-gray-500 dark:text-gray-400">
					Don't have an account?
					<a href="/register" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Register</a>
				</p>
			}
			<p class="text-gray-500 dark:text-gray-400">
				<a href="/forgot-password" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Forgot your password?</a>
			</p>
		</div>
		@loginScript()
	}
}

templ loginScript() {
	<script>
		function handleLogin(e) {
			e.preventDefault();
			var form = e.target;
			var errorDiv = document.getElementById('login-error');
			var btn = form.querySelector('button[type="submit"]');
			errorDiv.innerHTML = '';
			btn.disabled = true;

			fetch('/api/v1/auth/login', {
				method: 'POST',
				headers: {'Content-Type': 'application/json'},
				body: JSON.stringify({
					username: form.username.value,
					password: form.password.value
				})
			})
			.then(function(resp) {
				return resp.json().then(function(data) {
					if (resp.ok) {
						window.location.href = '/';
					} else {
						errorDiv.innerHTML =
							'<div class="rounded-md bg-red-50 p-4 dark:bg-red-900/30">' +
							'<p class="text-sm text-red-700 dark:text-red-400">' +
							(data.error ? data.error.message : 'Login failed') +
							'</p></div>';
						btn.disabled = false;
					}
				});
			})
			.catch(function() {
				errorDiv.innerHTML =
					'<div class="rounded-md bg-red-50 p-4 dark:bg-red-900/30">' +
					'<p class="text-sm text-red-700 dark:text-red-400">Network error. Please try again.</p></div>';
				btn.disabled = false;
			});

			return false;
		}
	</script>
}
