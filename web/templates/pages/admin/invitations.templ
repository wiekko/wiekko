package admin

import (
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/ui"
	"nexmap.net/internal/model"
)

// InvitationsProps holds the data for the invitations page.
type InvitationsProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Invitations []*model.Invitation
}

templ InvitationsPage(props InvitationsProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "admin-invitations",
	}) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Invitations</h1>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Invite users to join the instance.</p>
			</div>
			<!-- Create invitation -->
			@ui.Card() {
				@ui.CardHeader("New Invitation") {
				}
				@ui.CardBody() {
					<div class="flex flex-wrap items-end gap-4">
						<div class="flex-1 min-w-[200px]">
							<label for="invite-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
							<input
								type="email"
								id="invite-email"
								placeholder="user@example.com"
								class="mt-1 block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600 dark:placeholder:text-gray-500"
							/>
						</div>
						<button
							type="button"
							class="inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
							onclick={ createInvitation(props.Meta.CSRFToken) }
						>
							@ui.Icon("send", "sm")
							Send Invitation
						</button>
					</div>
					<div id="invite-result" class="mt-3"></div>
				}
			}
			<!-- Invitations table -->
			if len(props.Invitations) == 0 {
				@ui.EmptyState("mail", "No invitations", "Send an invitation to get started.", "", "")
			} else {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Email
						}
						@ui.TableHeader() {
							Status
						}
						@ui.TableHeader() {
							Expires
						}
						@ui.TableHeader() {
							Created
						}
						@ui.TableHeader() {
						}
					}
					@ui.TableBody("") {
						for _, inv := range props.Invitations {
							@invitationRow(inv, props.Meta.CSRFToken)
						}
					}
				}
			}
		</div>
	}
}

templ invitationRow(inv *model.Invitation, csrfToken string) {
	<tr>
		@ui.TableCell() {
			{ inv.Email }
		}
		@ui.TableCell() {
			@invitationStatusBadge(inv.AcceptedAt)
		}
		@ui.TableCellMuted() {
			{ formatDate(inv.ExpiresAt) }
		}
		@ui.TableCellMuted() {
			{ formatDate(inv.CreatedAt) }
		}
		@ui.TableCell() {
			if inv.AcceptedAt == "" {
				<button
					type="button"
					class="text-sm text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300"
					onclick={ deleteInvitation(inv.ID, csrfToken) }
				>
					Revoke
				</button>
			}
		}
	</tr>
}

templ invitationStatusBadge(acceptedAt string) {
	if acceptedAt != "" {
		@ui.Badge("Accepted", "green")
	} else {
		@ui.Badge("Pending", "yellow")
	}
}

script createInvitation(csrfToken string) {
	var email = document.getElementById('invite-email').value;
	if (!email) return;
	var resultEl = document.getElementById('invite-result');
	fetch('/api/v1/admin/invitations', {
		method: 'POST',
		headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken},
		body: JSON.stringify({email: email})
	}).then(function(resp) {
		return resp.json().then(function(data) {
			if (resp.ok) {
				var token = data.data.raw_token;
				resultEl.innerHTML =
					'<div class="rounded-md bg-green-50 p-3 dark:bg-green-900/30">' +
					'<p class="text-sm font-medium text-green-800 dark:text-green-300">Invitation sent! Token:</p>' +
					'<code class="mt-1 block break-all rounded bg-green-100 px-2 py-1 text-xs text-green-900 dark:bg-green-900/50 dark:text-green-200">' + token + '</code>' +
					'</div>';
				document.getElementById('invite-email').value = '';
				setTimeout(function() { window.location.reload(); }, 3000);
			} else {
				resultEl.innerHTML =
					'<p class="text-sm text-red-600 dark:text-red-400">' + (data.error ? data.error.message : 'Failed to create invitation.') + '</p>';
			}
		});
	});
}

script deleteInvitation(id, csrfToken string) {
	if (!confirm('Revoke this invitation?')) return;
	fetch('/api/v1/admin/invitations/' + id, {
		method: 'DELETE',
		headers: {'X-CSRF-Token': csrfToken}
	}).then(function(resp) {
		if (resp.ok) {
			window.location.reload();
		}
	});
}
