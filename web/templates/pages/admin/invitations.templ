package admin

import (
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
	"nexmap.net/internal/model"
)

// InvitationsProps holds the data for the invitations page.
type InvitationsProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Invitations []*model.Invitation
	// MailEnabled offers sending invitations by email.
	MailEnabled bool
}

templ InvitationsPage(props InvitationsProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "admin-invitations",
	}) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Invitations</h1>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Invite users to join the instance.</p>
			</div>
			<!-- Create invitation -->
			@ui.Card() {
				@ui.CardHeader("New Invitation") {
				}
				@ui.CardBody() {
					<form class="space-y-4" hx-post="/admin/invitations" hx-target="#invite-result" hx-swap="innerHTML">
						<div class="max-w-md">
							@ui.TextInput(ui.InputProps{
								ID:          "invite-email",
								Name:        "email",
								Label:       "Email",
								Type:        "email",
								Placeholder: "user@example.com",
								Required:    true,
							})
						</div>
						@patterns.InviteDelivery(props.MailEnabled)
						@ui.Button(ui.ButtonProps{
							Label:   "Send Invitation",
							Variant: "primary",
							Size:    "md",
							Type:    "submit",
						}) {
							@ui.Icon("send", "sm")
						}
					</form>
					<div id="invite-result" class="mt-3"></div>
				}
			}
			<!-- Invitations table -->
			if len(props.Invitations) == 0 {
				@ui.EmptyState("mail", "No invitations", "Send an invitation to get started.", "", "")
			} else {
				@ui.Table() {
					@ui.TableHead() {
						@ui.TableHeader() {
							Email
						}
						@ui.TableHeader() {
							Status
						}
						@ui.TableHeader() {
							Expires
						}
						@ui.TableHeader() {
							Created
						}
						@ui.TableHeader() {
						}
					}
					@ui.TableBody("") {
						for _, inv := range props.Invitations {
							@invitationRow(inv)
						}
					}
				}
			}
		</div>
	}
}

templ invitationRow(inv *model.Invitation) {
	<tr id={ "invitation-" + inv.ID }>
		@ui.TableCell() {
			{ inv.Email }
		}
		@ui.TableCell() {
			@invitationStatusBadge(inv.AcceptedAt)
		}
		@ui.TableCellMuted() {
			{ formatDate(inv.ExpiresAt) }
		}
		@ui.TableCellMuted() {
			{ formatDate(inv.CreatedAt) }
		}
		@ui.TableCell() {
			if inv.AcceptedAt == "" {
				<button
					type="button"
					class="text-sm text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300"
					hx-delete={ "/admin/invitations/" + inv.ID }
					hx-target={ "#invitation-" + inv.ID }
					hx-swap="delete"
					hx-confirm="Revoke this invitation?"
				>
					Revoke
				</button>
			}
		}
	</tr>
}

templ invitationStatusBadge(acceptedAt string) {
	if acceptedAt != "" {
		@ui.Badge("Accepted", "green")
	} else {
		@ui.Badge("Pending", "yellow")
	}
}

// InviteSentResult confirms an invitation sent by email.
templ InviteSentResult(email string) {
	<div class="rounded-md bg-green-50 p-3 dark:bg-green-900/30">
		<p class="text-sm font-medium text-green-800 dark:text-green-300">Invitation sent to { email }.</p>
		<p class="mt-2 text-xs text-green-700 dark:text-green-400">
			The link in the email works once and expires in 7 days.
			<a href="/admin/invitations" class="underline">Reload page</a> to see the updated list.
		</p>
	</div>
}

// InviteResult renders the result of creating an invitation.
templ InviteResult(errorMessage, inviteURL string, success bool) {
	if success {
		<div class="rounded-md bg-green-50 p-3 dark:bg-green-900/30">
			<p class="text-sm font-medium text-green-800 dark:text-green-300">Invitation created! Share this link with the user:</p>
			<code class="mt-1 block break-all rounded bg-green-100 px-2 py-1 text-xs text-green-900 dark:bg-green-900/50 dark:text-green-200">{ inviteURL }</code>
			<p class="mt-2 text-xs text-green-700 dark:text-green-400">
				<a href="/admin/invitations" class="underline">Reload page</a> to see the updated list.
			</p>
		</div>
	} else {
		<p class="text-sm text-red-600 dark:text-red-400">{ errorMessage }</p>
	}
}
