package admin

import (
	"strconv"

	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/ui"
)

// SettingsProps holds the data for the instance settings page.
type SettingsProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Settings    map[string]string
}

templ SettingsPage(props SettingsProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "admin-settings",
	}) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Instance Settings</h1>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Changes are saved automatically.</p>
			</div>
			<!-- Registration & Access -->
			@ui.Card() {
				@ui.CardHeader("Registration & Access") {
				}
				@ui.CardBody() {
					<div class="space-y-4">
						@SettingToggle("self_registration_enabled", "Self-Registration", "Allow users to register without an invitation link.", props.Settings["self_registration_enabled"] == "true")
						@SettingToggle("moderation_enabled", "Moderation", "Require admin approval for self-registered accounts.", props.Settings["moderation_enabled"] == "true")
						@SettingToggle("product_creation_enabled", "Product Creation", "Allow non-admin users to create new products.", props.Settings["product_creation_enabled"] == "true")
					</div>
				}
			}
			<!-- Two-Factor Authentication (SC-34) -->
			@ui.Card() {
				@ui.CardHeader("Two-Factor Authentication") {
				}
				@ui.CardBody() {
					<div class="space-y-4">
						<p class="text-sm text-gray-500 dark:text-gray-400">
							Users covered here must set up two-factor authentication before they can use Nexmap. A role applies to users who hold it in at least one product. Product owners can also require two-factor authentication for the members of their product.
						</p>
						for _, key := range TwoFactorSettingKeys {
							@SettingToggle(key, TwoFactorSettingLabel(key), TwoFactorSettingDescription(key), props.Settings[key] == "true")
						}
					</div>
				}
			}
			<!-- API Tokens -->
			@ui.Card() {
				@ui.CardHeader("API Tokens") {
				}
				@ui.CardBody() {
					<div class="space-y-4">
						@SettingNumber(NumberSetting("pat_max_lifetime_days", "Maximum Token Lifetime (days)", "Personal access tokens must expire within this many days. 0 allows tokens without expiry.", props.Settings["pat_max_lifetime_days"]))
					</div>
				}
			}
			<!-- Password Policy -->
			@ui.Card() {
				@ui.CardHeader("Password Policy") {
				}
				@ui.CardBody() {
					<div class="space-y-4">
						@SettingNumber(NumberSetting("password_min_length", "Minimum Length", "", props.Settings["password_min_length"]))
						@SettingToggle("password_require_uppercase", "Require Uppercase", "At least one uppercase letter.", props.Settings["password_require_uppercase"] == "true")
						@SettingToggle("password_require_lowercase", "Require Lowercase", "At least one lowercase letter.", props.Settings["password_require_lowercase"] == "true")
						@SettingToggle("password_require_digit", "Require Digit", "At least one numeric digit.", props.Settings["password_require_digit"] == "true")
						@SettingToggle("password_require_special", "Require Special Character", "At least one special character.", props.Settings["password_require_special"] == "true")
					</div>
				}
			}
		</div>
	}
}

// TwoFactorSettingKeys lists the 2FA enforcement settings in display order.
var TwoFactorSettingKeys = []string{
	"2fa_enforced",
	"2fa_enforced_admins",
	"2fa_enforced_owner",
	"2fa_enforced_developer",
	"2fa_enforced_tester",
	"2fa_enforced_viewer",
}

// TwoFactorSettingLabel is the label of a 2FA enforcement setting.
func TwoFactorSettingLabel(key string) string {
	switch key {
	case "2fa_enforced":
		return "All users"
	case "2fa_enforced_admins":
		return "Administrators"
	case "2fa_enforced_owner":
		return "Product owners"
	case "2fa_enforced_developer":
		return "Developers"
	case "2fa_enforced_tester":
		return "Testers"
	case "2fa_enforced_viewer":
		return "Viewers"
	}
	return key
}

// TwoFactorSettingDescription is the description of a 2FA enforcement setting.
func TwoFactorSettingDescription(key string) string {
	switch key {
	case "2fa_enforced":
		return "Require two-factor authentication for everyone."
	case "2fa_enforced_admins":
		return "Require it for instance administrators."
	case "2fa_enforced_owner":
		return "Require it for users who own a product."
	case "2fa_enforced_developer":
		return "Require it for users who are a developer in a product."
	case "2fa_enforced_tester":
		return "Require it for users who are a tester in a product."
	case "2fa_enforced_viewer":
		return "Require it for users who are a viewer in a product."
	}
	return ""
}

// SettingToggle renders a single toggle setting. Returned as fragment after update.
templ SettingToggle(key, label, description string, checked bool) {
	<div
		id={ "setting-" + key }
		class="flex items-center justify-between"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div>
			<p class="text-sm font-medium text-gray-900 dark:text-gray-100">{ label }</p>
			<p class="text-sm text-gray-500 dark:text-gray-400">{ description }</p>
		</div>
		<button
			type="button"
			role="switch"
			aria-checked={ boolStr(checked) }
			class={ "relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900", toggleBg(checked) }
			hx-patch="/admin/settings"
			hx-vals={ `{"key":"` + key + `","value":"` + toggleNextValue(checked) + `"}` }
		>
			<span class={ "pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition-transform dark:bg-gray-200", toggleKnob(checked) }></span>
		</button>
	</div>
}

// SettingNumber renders a numeric setting input. Returned as fragment after update.
// NumberSettingProps describes a numeric setting input.
type NumberSettingProps struct {
	Key         string
	Label       string
	Description string
	Value       string
	Min, Max    int
	Fallback    string
}

// NumberSetting returns the input props of a numeric setting, with the range
// that setting accepts.
func NumberSetting(key, label, description, value string) NumberSettingProps {
	p := NumberSettingProps{Key: key, Label: label, Description: description, Value: value,
		Min: 1, Max: 128, Fallback: "8"}
	if key == "pat_max_lifetime_days" {
		p.Min, p.Max, p.Fallback = 0, 3650, "0"
	}
	return p
}

// SettingNumber renders a numeric setting. Returned as fragment after update.
templ SettingNumber(props NumberSettingProps) {
	<div
		id={ "setting-" + props.Key }
		class="flex items-center justify-between gap-4"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div>
			<label for={ "setting-input-" + props.Key } class="text-sm font-medium text-gray-900 dark:text-gray-100">{ props.Label }</label>
			if props.Description != "" {
				<p class="text-sm text-gray-500 dark:text-gray-400">{ props.Description }</p>
			}
		</div>
		<input
			type="number"
			id={ "setting-input-" + props.Key }
			min={ strconv.Itoa(props.Min) }
			max={ strconv.Itoa(props.Max) }
			name="value"
			value={ settingValue(props.Value, props.Fallback) }
			class="w-24 shrink-0 rounded-md border-0 px-3 py-1.5 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100 dark:ring-gray-600"
			hx-patch="/admin/settings"
			hx-include="this"
			hx-vals={ `{"key":"` + props.Key + `"}` }
			hx-trigger="change"
		/>
	</div>
}

func toggleBg(on bool) string {
	if on {
		return "bg-indigo-600"
	}
	return "bg-gray-200 dark:bg-gray-700"
}

func toggleKnob(on bool) string {
	if on {
		return "translate-x-5"
	}
	return "translate-x-0"
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func toggleNextValue(current bool) string {
	if current {
		return "false"
	}
	return "true"
}

func settingValue(val, fallback string) string {
	if val != "" {
		return val
	}
	return fallback
}
