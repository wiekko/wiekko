package admin

import (
	"wiekko.net/web/templates"
	layout "wiekko.net/web/templates/layout"
	"wiekko.net/web/templates/ui"
	"wiekko.net/internal/model"
)

// UserDetailProps holds the data for the user detail page.
type UserDetailProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	IsSelf      bool
	Target      *model.User
}

templ UserDetailPage(props UserDetailProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "admin-users",
	}) {
		<div class="space-y-6">
			<!-- Breadcrumb -->
			<div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
				<a href="/admin/users" class="hover:text-gray-700 dark:hover:text-gray-300">Users</a>
				<span>/</span>
				<span class="text-gray-900 dark:text-gray-100">{ props.Target.Username }</span>
			</div>
			<!-- Header -->
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-4">
					@ui.UserAvatar(props.Target.DisplayName, "lg")
					<div>
						<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{ props.Target.Username }</h1>
						<div class="mt-1 flex items-center gap-2">
							@userStatusBadge(props.Target.Status)
							if props.Target.IsAdmin {
								@ui.Badge("Admin", "amber")
							}
						</div>
					</div>
				</div>
			</div>
			<!-- Info card -->
			@ui.Card() {
				@ui.CardHeader("Account Details") {
				}
				@ui.CardBody() {
					<dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
						@detailField("Username", props.Target.Username)
						@detailField("Email", props.Target.Email)
						@detailField("Display Name", props.Target.DisplayName)
						@detailField("Two-Factor Authentication", twoFactorLabel(props.Target.TOTPEnabled))
						@detailField("Created", formatDate(props.Target.CreatedAt))
						@detailField("Updated", formatDate(props.Target.UpdatedAt))
					</dl>
				}
			}
			<!-- Actions -->
			@ActionsCard(props.Target, props.IsSelf, "")
		</div>
		<!-- Password reset modal -->
		<div id="password-modal" class="hidden relative z-50">
			<div class="fixed inset-0 bg-gray-500/75 dark:bg-gray-900/80" onclick="document.getElementById('password-modal').classList.add('hidden')"></div>
			<div class="fixed inset-0 z-10 overflow-y-auto">
				<div class="flex min-h-full items-center justify-center p-4">
					<div id="password-modal-content" class="relative w-full max-w-md rounded-lg bg-white p-6 shadow-xl dark:bg-gray-900">
						@PasswordResetForm(props.Target.ID, "")
					</div>
				</div>
			</div>
		</div>
	}
}

// ActionsCard renders the admin action buttons. Returned as fragment after state changes.
templ ActionsCard(target *model.User, isSelf bool, feedback string) {
	<div id="actions-card">
		@ui.Card() {
			@ui.CardHeader("Actions") {
			}
			@ui.CardBody() {
				if feedback != "" {
					<p class="mb-3 text-sm text-emerald-700 dark:text-emerald-400">{ feedback }</p>
				}
				<div class="flex flex-wrap gap-3">
					if target.Status == "pending_approval" {
						@ui.Button(ui.ButtonProps{
							Label:   "Approve",
							Variant: "primary",
							Size:    "md",
							HxPost:  "/admin/users/" + target.ID + "/approve",
							HxTarget: "#actions-card",
							HxSwap: "outerHTML",
						})
					}
					if target.Status == "active" && !isSelf {
						@ui.Button(ui.ButtonProps{
							Label:   "Lock",
							Variant: "secondary",
							Size:    "md",
							HxPost:  "/admin/users/" + target.ID + "/lock",
							HxTarget: "#actions-card",
							HxSwap: "outerHTML",
						})
					}
					if target.Status == "locked" {
						@ui.Button(ui.ButtonProps{
							Label:   "Unlock",
							Variant: "secondary",
							Size:    "md",
							HxPost:  "/admin/users/" + target.ID + "/unlock",
							HxTarget: "#actions-card",
							HxSwap: "outerHTML",
						})
					}
					<button
						type="button"
						class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700 dark:focus:ring-offset-gray-900"
						onclick="document.getElementById('password-modal').classList.remove('hidden')"
					>
						@ui.Icon("lock", "sm")
						Reset Password
					</button>
					if target.TOTPEnabled {
						<button
							type="button"
							class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700 dark:focus:ring-offset-gray-900"
							hx-post={ "/admin/users/" + target.ID + "/2fa/reset" }
							hx-target="#actions-card"
							hx-swap="outerHTML"
							{ ui.Confirm(ui.ConfirmDanger, "Reset two-factor authentication", "Reset 2FA", "Reset two-factor authentication for "+target.Username+"? Their current authenticator stops working and cannot be restored. They can sign in with their password alone until they set it up again.")... }
						>
							@ui.Icon("shield", "sm")
							Reset 2FA
						</button>
					}
					if !isSelf {
						<button
							type="button"
							class="inline-flex items-center gap-2 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
							hx-delete={ "/admin/users/" + target.ID }
							hx-target="#actions-card"
							hx-swap="outerHTML"
							{ ui.Confirm(ui.ConfirmDanger, "Delete user", "Delete", "Delete user "+target.Username+"? This cannot be undone.")... }
						>
							@ui.Icon("trash", "sm")
							Delete User
						</button>
					}
				</div>
			}
		}
	</div>
}

// PasswordResetForm renders the password reset form inside the modal.
templ PasswordResetForm(userID, feedback string) {
	<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Reset Password</h3>
	<form class="mt-4" hx-post={ "/admin/users/" + userID + "/password" } hx-target="#password-modal-content" hx-swap="innerHTML">
		@ui.TextInput(ui.InputProps{
			ID:       "new-password",
			Name:     "password",
			Label:    "New Password",
			Type:     "password",
			Required: true,
		})
		if feedback != "" {
			<p class="mt-2 text-sm text-red-600 dark:text-red-400">{ feedback }</p>
		}
		<div class="mt-4 flex justify-end gap-3">
			<button type="button" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700" onclick="document.getElementById('password-modal').classList.add('hidden')">
				Cancel
			</button>
			@ui.Button(ui.ButtonProps{
				Label:   "Set Password",
				Variant: "primary",
				Size:    "md",
				Type:    "submit",
			})
		</div>
	</form>
}

// PasswordResetSuccess renders the success state in the password modal.
templ PasswordResetSuccess() {
	<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Reset Password</h3>
	<p class="mt-2 text-sm text-emerald-700 dark:text-emerald-400">Password updated successfully. The user was signed out of all sessions.</p>
	<div class="mt-4 flex justify-end">
		<button type="button" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" onclick="document.getElementById('password-modal').classList.add('hidden')">
			Done
		</button>
	</div>
}

templ detailField(label, value string) {
	<div>
		<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">{ label }</dt>
		<dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
			if value != "" {
				{ value }
			} else {
				<span class="text-gray-400 dark:text-gray-500">—</span>
			}
		</dd>
	</div>
}

func actionButtonClass(variant string) string {
	switch variant {
	case "primary":
		return "bg-indigo-600 text-white hover:bg-indigo-500"
	default:
		return "bg-white text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-700"
	}
}

func twoFactorLabel(enabled bool) string {
	if enabled {
		return "Enabled"
	}
	return "Not configured"
}
