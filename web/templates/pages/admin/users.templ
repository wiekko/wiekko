package admin

import (
	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/patterns"
	"nexmap.net/web/templates/ui"
	"nexmap.net/internal/model"
)

// UsersProps holds the data for the users list page.
type UsersProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Users       []*model.User
	patterns.TableView
}

// UsersTableID is the element the users table controls swap.
const UsersTableID = "users-table"

templ UsersPage(props UsersProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "admin-users",
	}) {
		<div class={ patterns.TableViewPageClass }>
			@patterns.TableHeader("Users", "users-count", props.CountLabel())
			<div id={ UsersTableID } class={ patterns.TableViewRegionClass }>
				@UsersTableContent(props)
			</div>
		</div>
	}
}

// UsersTableContent renders the users table with its controls (UR-145). The
// status facet keeps the status parameter of the tabs it replaces, so their
// links still work.
templ UsersTableContent(props UsersProps) {
	{{ target := "#" + UsersTableID }}
	@patterns.TableFrame(props.Frame(usersControls(), "users-count", len(props.Users), ui.EmptyState("users", "No users", "No user accounts exist yet.", "", ""))) {
		@ui.Table() {
			@ui.TableHead() {
				@ui.SortHeader("Username", "username", props.State, target)
				@ui.SortHeader("Email", "email", props.State, target)
				@ui.SortHeader("Display Name", "display_name", props.State, target)
				@ui.SortHeader("Status", "status", props.State, target)
				@ui.SortHeader("Created", "created", props.State, target)
			}
			@ui.TableBody("") {
				for _, u := range props.Users {
					@userRow(u)
				}
			}
		}
	}
}

func usersControls() patterns.TableControlsProps {
	return patterns.TableControlsProps{
		Key:    "user",
		Target: "#" + UsersTableID,
		Noun:   "users",
		Facets: []patterns.TableFacet{
			{Name: "status", Label: "Status", Options: patterns.FacetOptions("All statuses", "",
				templates.SelectOption{Value: model.UserStatusActive, Label: "Active"},
				templates.SelectOption{Value: model.UserStatusPendingApproval, Label: "Pending"},
				templates.SelectOption{Value: model.UserStatusLocked, Label: "Locked"},
				templates.SelectOption{Value: model.UserStatusDeletionRequested, Label: "Deletion requested"},
			)},
			{Name: "role", Label: "Role", Options: patterns.FacetOptions("All users", "",
				templates.SelectOption{Value: "admin", Label: "Administrators"},
				templates.SelectOption{Value: "user", Label: "Other users"},
			)},
		},
	}
}

templ userRow(u *model.User) {
	<tr class="cursor-pointer transition-colors hover:bg-gray-50 dark:hover:bg-gray-800" onclick={ navigateTo("/admin/users/" + u.ID) }>
		@ui.TableCell() {
			<span class="font-medium">{ u.Username }</span>
			if u.IsAdmin {
				<span class="ml-2">
					@ui.Badge("Admin", "amber")
				</span>
			}
		}
		@ui.TableCell() {
			{ u.Email }
		}
		@ui.TableCell() {
			{ u.DisplayName }
		}
		@ui.TableCell() {
			@userStatusBadge(u.Status)
		}
		@ui.TableCellMuted() {
			{ formatDate(u.CreatedAt) }
		}
	</tr>
}

templ userStatusBadge(status string) {
	switch status {
		case "active":
			@ui.Badge("Active", "green")
		case "pending_approval":
			@ui.Badge("Pending", "yellow")
		case "locked":
			@ui.Badge("Locked", "red")
		case "deletion_requested":
			@ui.Badge("Deletion Requested", "red")
		default:
			@ui.Badge(status, "gray")
	}
}

script navigateTo(url string) {
	window.location.href = url;
}

func formatDate(rfc3339 string) string {
	if len(rfc3339) >= 10 {
		return rfc3339[:10]
	}
	return rfc3339
}
