package dashboard

import (
	"strconv"

	"nexmap.net/web/templates"
	layout "nexmap.net/web/templates/layout"
	"nexmap.net/web/templates/ui"
	"nexmap.net/internal/service"
)

// DashboardProps holds the data needed by the dashboard page.
type DashboardProps struct {
	Meta        templates.PageMeta
	DisplayName string
	IsAdmin     bool
	Products    []service.ProductSummary
	CanCreate   bool
}

templ DashboardPage(props DashboardProps) {
	@layout.AppLayout(layout.AppLayoutProps{
		Meta:          props.Meta,
		DisplayName:   props.DisplayName,
		IsAdmin:       props.IsAdmin,
		ActiveSection: "dashboard",
	}) {
		<div class="space-y-6">
			<!-- Page header -->
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Dashboard</h1>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Your products at a glance.</p>
				</div>
				if props.CanCreate && len(props.Products) > 0 {
					@ui.LinkButton("/products/new", "Create Product", "primary", "md") {
						@ui.Icon("plus", "sm")
					}
				}
			</div>
			<!-- Product cards -->
			if len(props.Products) == 0 {
				if props.CanCreate {
					@ui.EmptyState("folder", "No products yet", "Get started by creating your first product.", "Create Product", "/products/new")
				} else {
					@ui.EmptyState("folder", "No products yet", "You don't have access to any products.", "", "")
				}
			} else {
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
					for _, p := range props.Products {
						@productCard(p)
					}
				</div>
			}
		</div>
	}
}

templ productCard(p service.ProductSummary) {
	<a href={ templ.SafeURL("/products/" + p.Product.ID) } class="block transition-shadow hover:shadow-lg rounded-lg">
		@ui.Card() {
			<div class="px-6 py-4">
				<div class="flex items-center justify-between">
					<h3 class="truncate text-base font-semibold text-gray-900 dark:text-gray-100">{ p.Product.Name }</h3>
					@ui.RoleBadge(p.Role)
				</div>
				if p.TwoFactorLocked {
					<div class="mt-4 flex items-center gap-1.5 text-sm text-amber-700 dark:text-amber-400">
						@ui.Icon("lock", "sm")
						<span>Requires two-factor authentication — set it up to open this product.</span>
					</div>
				} else {
				if p.Product.Description != "" {
					<div class="prose prose-sm dark:prose-invert mt-2 line-clamp-2 max-w-none text-gray-500 dark:text-gray-400">
						@templ.Raw(templates.RenderMarkdown(p.Product.Description))
					</div>
				}
				<div class="mt-4 flex items-center gap-6 text-sm">
					<div class="flex items-center gap-1.5 text-gray-600 dark:text-gray-400">
						@ui.Icon("clipboard-list", "sm")
						<span>{ strconv.Itoa(p.OpenRequirements) } open</span>
					</div>
					<div class="flex items-center gap-1.5 text-gray-600 dark:text-gray-400">
						@ui.Icon("bug", "sm")
						<span>{ strconv.Itoa(p.ActiveDefects) } active</span>
					</div>
				</div>
				if p.CurrentSprint != "" {
					<div class="mt-3 flex items-center gap-1.5 text-sm text-gray-600 dark:text-gray-400">
						@ui.Icon("clock", "sm")
						<span>{ p.CurrentSprint }</span>
					</div>
				}
				}
			</div>
		}
	</a>
}
